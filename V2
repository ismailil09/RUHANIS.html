function calcTotal(){
  // ✅ FIX (Multi-product order, Sept 2026): AI Smart Paste-এর মতো পুরনো কোড
  // এখনো #order-qty/#unit-price হিডেন ফিল্ডে সরাসরি ভ্যালু বসায় — সেটা প্রথম
  // প্রোডাক্ট-লাইনে সিঙ্ক করে রি-রেন্ডার করো, যাতে Subtotal ঠিক থাকে।
  const qty = parseFloat(document.getElementById('order-qty')?.value) || 1;
  const price = parseFloat(document.getElementById('unit-price')?.value) || 0;
  if (Array.isArray(window._orderItems) && window._orderItems.length) {
    window._orderItems[0].qty = qty;
    window._orderItems[0].price = price;
    _renderOrderItems();
  } else {
    calcDue();
  }
}
function calcDue(){
  const total=parseFloat(document.getElementById('total-price').value)||0;
  const paid=parseFloat(document.getElementById('order-paid').value)||0;
  const delivery=parseFloat(document.querySelector('#modal-add-order #order-delivery')?.value)||0;
  const codPctEl=document.getElementById('order-cod-pct');
  const codPct=codPctEl?parseFloat(codPctEl.value)||0:0;
  // ✅ BUG #2 FIX: Customer Payable = Product Total + Delivery Charge
  // COD % applies to the full customer payable — NOT just product total.
  // COD fee is OUR expense and must NOT reduce what the customer pays.
  const customerPayable=total+delivery;
  const codCharge=codPct>0?parseFloat(((customerPayable*codPct)/100).toFixed(2)):0;
  // netAfterCod = what we actually receive after courier deducts COD fee
  const netAfterCod=Math.max(0,customerPayable-codCharge);
  if(document.getElementById('cod-charge-display')) document.getElementById('cod-charge-display').textContent='৳ '+codCharge.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
  if(document.getElementById('cod-net-display')) document.getElementById('cod-net-display').textContent='৳ '+netAfterCod.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
  // Due = Customer Payable - already paid (customer owes the full product+delivery amount)
  document.getElementById('due-amount').value=Math.max(0,customerPayable-paid);
}
// ✅ v40 FIX (সমস্যা ১): Steadfast/Pathao-এর প্রকৃত COD সার্ভিস চার্জ রেট —
// courier সিলেক্ট করলেই COD% ফিল্ড অটো-বসে যায় (তবু ম্যানুয়ালি বদলানো যায়)।
const COURIER_COD_RATE = { 'Steadfast': 1, 'Pathao': 1 };
function toggleCodField(){
  const pm=document.getElementById('order-payment');
  const courierEl=document.getElementById('order-courier');
  const grp=document.getElementById('cod-charge-group');
  const isCod=(pm&&pm.value==='COD');
  if(grp) grp.style.display=isCod?'block':'none';
  if(isCod && courierEl){
    const rate=COURIER_COD_RATE[courierEl.value];
    const pctEl=document.getElementById('order-cod-pct');
    // ইউজার ইতিমধ্যে ম্যানুয়ালি ভিন্ন % সিলেক্ট না করে থাকলেই অটো-বসাও
    if(rate!=null && pctEl && (!pctEl.value || pctEl.value==='0' || pctEl.dataset.auto==='1')){
      pctEl.value=String(rate);
      pctEl.dataset.auto='1'; // মনে রাখো এটা অটো-সেট হয়েছে, ইউজার ম্যানুয়ালি না বদলালে পরে আবার বদলানো যাবে
    }
  }
  calcDue();
}

