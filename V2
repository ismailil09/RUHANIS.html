  Sundarban:   { cls:'sundarban', icon:'🌿', color:'#f59e0b', baseDelivery: 75,  trackUrl: '' },
  Janani:      { cls:'janani',    icon:'💜', color:'#8b5cf6', baseDelivery: 70,  trackUrl: '' },
