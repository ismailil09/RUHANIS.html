// ── helper
function fmt(n) {
  if (!n && n!==0) return '০';
  return Math.round(n).toLocaleString('en-BD');
}

/**
 * _fixPhone — Google Sheets থেকে আসা phone number সবসময় String হিসেবে রাখো।
 * Sheets কখনো phone-কে Number হিসেবে store করলে leading '0' মুছে যায়।
 * এই ফাংশন সেটা ঠিক করে:
 *   17XXXXXXXX (10 digit)  → "017XXXXXXXX"
 *   8801XXXXXXXX (12 digit) → "01XXXXXXXX"  [তারপর 0-prefix]
 *   +8801XXXXXXXX           → "01XXXXXXXX"
 *   01XXXXXXXXX (11 digit)  → অপরিবর্তিত
 */
function _fixPhone(raw) {
  let s = String(raw == null ? '' : raw).trim();
  // leading/trailing whitespace ও non-printable সরাও
  s = s.replace(/\s+/g, '');
  if (!s || s === '0' || s === 'null' || s === 'undefined') return '';
  // +88 prefix সরাও
  if (s.startsWith('+88')) s = s.slice(3);
  // 88 prefix (12 digit) সরাও
  if (s.startsWith('88') && s.length === 12) s = s.slice(2);
  // leading 0 ছাড়া 10-digit BD number → 0 যোগ করো
  if (/^[1-9]\d{9}$/.test(s)) s = '0' + s;
  return s;
}

