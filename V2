          h += `<tr class="igp-d"><td colspan="11"><table class="igp-t sub"><thead><tr><th>তারিখ</th><th>Order</th><th>Customer</th><th class="r">Qty</th><th class="r">বিক্রয়মূল্য/ইউনিট</th><th class="r">List-এর সাথে</th><th class="r">Cost/ইউনিট</th><th class="r">Revenue</th><th class="r">Profit</th></tr></thead><tbody>
            ${ls.map(L => { const d = L.list > 0 ? L.unit - L.list : null; return `<tr><td style="white-space:nowrap">${fmtD(L.iso)}</td><td>#${esc(L.id)}</td><td>${esc(L.customer)}</td><td class="r">${L.qty}</td><td class="r">${tk2(L.unit)}</td><td class="r" style="color:${d == null ? 'inherit' : d > 0.5 ? '#34d174' : d < -0.5 ? '#f85149' : 'inherit'}">${d == null ? '—' : Math.abs(d) < 0.5 ? '= List' : (d > 0 ? '+' : '−') + tk2(Math.abs(d))}</td><td class="r">${L.cost == null ? '—' : tk2(L.cost)}</td><td class="r">${tk(L.rev)}</td><td class="r" style="font-weight:700;color:${L.missing ? '#a78bfa' : L.gp >= 0 ? '#34d174' : '#f85149'}">${L.missing ? '❓' : tk(L.gp)}</td></tr>`; }).join('')}
            </tbody></table>${p.lines.length > 200 ? `<div class="sm" style="padding:6px">সর্বশেষ ২০০টি লাইন দেখানো হলো</div>` : ''}</td></tr>`;
        }
      });
      h += `</tbody><tfoot><tr><td></td><td>মোট</td><td class="r">${T.qty.toLocaleString('en-BD')}</td><td></td><td></td><td></td><td class="r">${tk(T.rev)}</td><td class="r">${tk(T.cogs)}</td><td class="r" style="color:${T.gp >= 0 ? '#34d174' : '#f85149'}">${tk(T.gp)}</td><td class="r">${mg.toFixed(1)}%</td><td></td></tr></tfoot></table></div>`;
    }
    h += `<div class="igp-foot">ℹ️ Gross Profit = Revenue − COGS (ডেলিভারি চার্জ, COD চার্জ ও অন্যান্য খরচ বাদ — সেগুলো Net Profit-এ যায়)। COGS = বিক্রির পরিমাণ × অর্ডারের সময় সেভ করা Cost (না থাকলে Inventory-র বর্তমান Cost)। প্রতিটি লাইনে <b>আসল বিক্রয়মূল্য</b> ধরা হয়েছে, তাই বেশি/কম দামে বিক্রি হলেও হিসাব ঠিক থাকে। ${rf || rt ? `সময়: ${fmtD(rf) || '…'} → ${fmtD(rt) || '…'}` : ''}</div>`;
    const keepQ = document.activeElement && document.activeElement.id === 'igp-q';
    body.innerHTML = h; if (keepQ) { const q = $('igp-q'); if (q) { q.focus(); const l = q.value.length; try { q.setSelectionRange(l, l); } catch (e) {} } }
  }

  window.igpOpen = function () { if (!salesRows().length && typeof loadLiveSales === 'function') { try { loadLiveSales(); } catch (e) {} } openModal('gp'); render(); };
  window.igpSet = function (k, v) { ST[k] = v; if (k === 'period' && v !== 'custom') { ST.from = ''; ST.to = ''; } if (k === 'product' || k === 'period' || k === 'basis') ST.open = ''; render(); };
  let qt = null; window.igpSearch = function (v) { ST.q = v; clearTimeout(qt); qt = setTimeout(render, 250); };
  window.igpLock = async function () {
    if (!confirm('যেসব পুরনো অর্ডারে Cost সেভ নেই, সেগুলোতে এখনকার Inventory Cost সেভ হবে। আগে সেভ থাকা কোনো Cost বদলাবে না। এগিয়ে যাবেন?')) return;
    try {
      showToast('⏳ Cost সেভ হচ্ছে…', 'info');
      const r = await postToAPI({ action: 'backfillUnitCost' });
      if (r && r.status === 'success') { showToast('🔒 ' + (r.filled || 0) + 'টি অর্ডার-লাইনে Cost সেভ হয়েছে' + (r.missing ? ' · ' + r.missing + 'টিতে Inventory Cost নেই' : ''), 'success'); if (typeof loadLiveSales === 'function') await loadLiveSales(); render(); }
      else showToast('❌ ' + ((r && r.message) || 'সেভ হয়নি — Apps Script v65 ডিপ্লয় করেছেন?'), 'error');
    } catch (e) { showToast('❌ সংযোগ সমস্যা: ' + e.message, 'error'); }
  };
  window.igpToggle = function (enc) { const k = decodeURIComponent(enc); ST.open = ST.open === k ? '' : k; render(); };
  window.igpExport = function () {
    const D = viewData(); if (!D.shown.length) return showToast('এক্সপোর্ট করার মতো ডেটা নেই', 'info');
    const rows = [['Product', 'Qty Sold', 'Cost/Unit', 'List Price', 'Avg Sold Price', 'Min Price', 'Max Price', 'Revenue', 'COGS', 'Gross Profit', 'Margin %', 'Status']];
    D.shown.forEach(p => rows.push([p.name, p.qty, p.cost == null ? '' : p.cost, p.list || '', Math.round(p.avg * 100) / 100, p.min === Infinity ? '' : Math.round(p.min * 100) / 100, Math.round(p.max * 100) / 100, Math.round(p.rev * 100) / 100, Math.round(p.cogs * 100) / 100, Math.round(p.gp * 100) / 100, Math.round(p.margin * 10) / 10, STATE[p.state][0].replace(/^\S+\s/, '')]));
    rows.push(['TOTAL', D.totals.qty, '', '', '', '', '', Math.round(D.totals.rev * 100) / 100, Math.round(D.totals.cogs * 100) / 100, Math.round(D.totals.gp * 100) / 100, D.totals.rev > 0 ? Math.round(D.totals.gp * 1000 / D.totals.rev) / 10 : 0, '']);
    window.__igxCsv.downloadCSV(rows, 'gross-profit_' + todayISO() + '.csv'); showToast('📥 Gross Profit রিপোর্ট এক্সপোর্ট হয়েছে', 'success');
  };
  window.igpPrint = function () {
    const D = viewData(); if (!D.shown.length) return showToast('প্রিন্ট করার মতো ডেটা নেই', 'info');
    const w = window.open('', '_blank'); if (!w) return showToast('পপ-আপ ব্লক করা আছে — অনুমতি দিন', 'warning');
    const li = document.getElementById('inv-brand-logo'), logo = (li && li.src) || (typeof INNOGIX_LOGO_DATAURI !== 'undefined' ? INNOGIX_LOGO_DATAURI : '');
    const [rf, rt] = range(), T = D.totals, mg = T.rev > 0 ? T.gp * 100 / T.rev : 0;
    const rows = D.shown.map(p => `<tr><td><b>${esc(p.name)}</b></td><td class="r">${p.qty}</td><td class="r">${p.cost == null ? '—' : tk2(p.cost)}</td><td class="r">${tk2(p.avg)}</td><td class="r">${tk(p.rev)}</td><td class="r">${tk(p.cogs)}</td><td class="r" style="color:${p.gp >= 0 ? '#1b7a3d' : '#b3261e'};font-weight:700">${tk(p.gp)}</td><td class="r">${p.margin.toFixed(1)}%</td><td>${STATE[p.state][0]}</td></tr>`).join('');
    w.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Gross Profit Report</title><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;600;700&display=swap" rel="stylesheet"><style>
      @page{size:A4 landscape;margin:12mm}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}body{font-family:'Noto Sans Bengali',Arial,sans-serif;color:#111;font-size:11.5px;margin:0}
      .hd{display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #0f2a5c;padding-bottom:10px;margin-bottom:12px}.hd img{width:160px}.hd .t{text-align:right}.hd .t b{display:block;font-size:19px;letter-spacing:2px;color:#0f2a5c}.hd .t span{font-size:10.5px;color:#555}
      .ks{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:12px}.k{border:1px solid #dfe5f0;border-radius:6px;padding:7px 10px;background:#f7f9fd}.k span{display:block;font-size:9.5px;color:#666;text-transform:uppercase}.k b{font-size:15px}
      table{width:100%;border-collapse:collapse}th{background:#0f2a5c;color:#fff;text-align:left;padding:6px 7px;font-size:10px}td{padding:5px 7px;border-bottom:1px solid #e1e6f0}.r{text-align:right;white-space:nowrap}tr{page-break-inside:avoid}tfoot td{font-weight:800;border-top:2px solid #0f2a5c}
      .ft{margin-top:10px;font-size:9.5px;color:#777;border-top:1px dashed #bbb;padding-top:6px}</style></head><body>
      <div class="hd">${logo ? `<img src="${logo}" alt="RUHANIS">` : '<b>RUHANIS</b>'}<div class="t"><b>GROSS PROFIT REPORT</b><span>${rf || rt ? fmtD(rf) + ' → ' + fmtD(rt) : 'সব সময়'} · ${ST.basis === 'delivered' ? 'Delivered অর্ডার' : 'সব সক্রিয় অর্ডার'}${ST.product ? ' · ' + esc(ST.product) : ''} · প্রিন্ট: ${fmtD(todayISO())}</span></div></div>
      <div class="ks"><div class="k"><span>Revenue</span><b>${tk(T.rev)}</b></div><div class="k"><span>COGS</span><b>${tk(T.cogs)}</b></div><div class="k"><span>Gross Profit</span><b style="color:${T.gp >= 0 ? '#1b7a3d' : '#b3261e'}">${tk(T.gp)}</b></div><div class="k"><span>Gross Margin</span><b>${mg.toFixed(1)}%</b></div><div class="k"><span>ইউনিট বিক্রি</span><b>${T.qty}</b></div></div>
      <table><thead><tr><th>প্রোডাক্ট</th><th class="r">Qty</th><th class="r">Cost/ইউনিট</th><th class="r">গড় বিক্রয়মূল্য</th><th class="r">Revenue</th><th class="r">COGS</th><th class="r">Gross Profit</th><th class="r">Margin</th><th>অবস্থা</th></tr></thead><tbody>${rows}</tbody>
      <tfoot><tr><td>মোট</td><td class="r">${T.qty}</td><td></td><td></td><td class="r">${tk(T.rev)}</td><td class="r">${tk(T.cogs)}</td><td class="r">${tk(T.gp)}</td><td class="r">${mg.toFixed(1)}%</td><td></td></tr></tfoot></table>
      <div class="ft">Gross Profit = Revenue − COGS (ডেলিভারি/COD চার্জ ও অন্যান্য খরচ বাদ)। COGS = Qty × Inventory-র বর্তমান Cost; প্রতিটি লাইনে আসল বিক্রয়মূল্য ধরা হয়েছে। RUHANIS Business OS থেকে স্বয়ংক্রিয়ভাবে তৈরি।</div>
      <script>window.onload=function(){setTimeout(function(){window.print();},500);};<\/script></body></html>`);
    w.document.close();
  };
})();

