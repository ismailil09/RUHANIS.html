let sortDir={};
function sortTable(tid,col){
  const table=document.getElementById(tid); if(!table) return;
  sortDir[tid+col]=!sortDir[tid+col];
  const rows=Array.from(table.querySelectorAll('tbody tr'));
  rows.sort((a,b)=>{
    const ta=a.cells[col]?.innerText?.replace(/[৳,]/g,'').trim()||'';
    const tb=b.cells[col]?.innerText?.replace(/[৳,]/g,'').trim()||'';
    const na=parseFloat(ta),nb=parseFloat(tb);
    if(!isNaN(na)&&!isNaN(nb)) return sortDir[tid+col]?na-nb:nb-na;
    return sortDir[tid+col]?ta.localeCompare(tb):tb.localeCompare(ta);
  });
  rows.forEach(r=>table.querySelector('tbody').appendChild(r));
  table.querySelectorAll('thead th').forEach((th,i)=>th.classList.toggle('sorted',i===col));
}

