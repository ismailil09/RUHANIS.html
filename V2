function renderPartnerSummary(txns){
  const partners = [
    {name:'MD ISMAIL HOSEN',cls:'ismail',color:'var(--ismail)',initial:'I'},
    {name:'GOLAM RABBI',cls:'ashik',color:'var(--ashik)',initial:'A'},
  ];
  // REF error ছাড়া সরাসরি JS এ calculate
  document.getElementById('partner-cards').innerHTML = partners.map(p=>{
    const inv = txns.filter(t=>t.partner===p.name&&t.type==='Investment').reduce((s,t)=>s+Number(t.amount||0),0);
    const drw = txns.filter(t=>t.partner===p.name&&t.type==='Drawings').reduce((s,t)=>s+Number(t.amount||0),0);
    const prf = txns.filter(t=>t.partner===p.name&&t.type==='Profit Share').reduce((s,t)=>s+Number(t.amount||0),0);
    const bal = inv - drw;   // Profit Share মূলধনে যোগ হয় না — আলাদা দেখানো হয় (Dashboard-এর Capital-এর সাথে মিল)
    return `<div class="partner-bal-card ${p.cls}">
      <div class="p-initial">${p.initial}</div>
      <div class="p-name" style="color:${p.color};">${p.name}</div>
      <div class="p-role">Partner</div>
      <div class="p-stats">
        <div class="p-stat"><label>Invested</label><span style="color:var(--blue);">৳${inv.toLocaleString()}</span></div>
        <div class="p-stat"><label>Drawings</label><span style="color:var(--red);">৳${drw.toLocaleString()}</span></div>
        ${prf > 0 ? `<div class="p-stat" title="লাভের অংশ — মূলধনে যোগ হয়নি; চাইলে তুলে নিতে বা Investment হিসেবে যোগ করতে পারবেন"><label>Profit Share (আলাদা)</label><span style="color:var(--orange);">৳${prf.toLocaleString()}</span></div>` : ''}
        <div class="p-stat" title="Net Balance = Invested − Drawings (Profit Share ছাড়া)"><label>Net Balance (মূলধন)</label><span style="color:${bal>=0?'var(--green)':'var(--red)'};">৳${Math.abs(bal).toLocaleString()}${bal<0?' ↓':''}</span></div>
      </div>
    </div>`;
  }).join('');
  // Also update sidebar partner chips balance if needed
}

