// ─── CUSTOMER CARD PNG DOWNLOAD ──────────────────────────────
function downloadCustomerCard(){
  showToast('PNG তৈরি হচ্ছে...','info');
  const doCapture = () => {
    // Capture the entire modal body (not just inner card) to include order history
    const modalBody = document.getElementById('customer-detail-body');
    if(!modalBody){ showToast('Card পাওয়া যায়নি','error'); return; }

    // Temporarily expand any hidden overflow so full content renders
    const savedStyles = [];
    const overflowEls = modalBody.querySelectorAll('*');
    overflowEls.forEach(el => {
      const s = window.getComputedStyle(el);
      if(s.overflow==='hidden'||s.overflowY==='hidden'||s.overflowY==='auto'||s.overflowY==='scroll'){
        savedStyles.push({el, overflow:el.style.overflow, overflowY:el.style.overflowY,
                          maxHeight:el.style.maxHeight, height:el.style.height});
        el.style.overflow='visible';
        el.style.overflowY='visible';
        el.style.maxHeight='none';
      }
    });

    // Also expand modal body itself
    const savedBodyOverflow = modalBody.style.overflowY;
    const savedBodyMax = modalBody.style.maxHeight;
    modalBody.style.overflowY='visible';
    modalBody.style.maxHeight='none';

    // Small delay to allow DOM reflow
    setTimeout(()=>{
      const bgColor = document.body.classList.contains('light') ? '#ffffff' : '#161B22';
      html2canvas(modalBody, {
        backgroundColor: bgColor,
        scale: 2,
        useCORS: true,
        logging: false,
        // Ensure full scroll height is captured
        height: modalBody.scrollHeight,
        windowHeight: modalBody.scrollHeight + 200,
        onclone: (clonedDoc) => {
          // In the clone, ensure all overflow is visible and heights are full
          const clonedBody = clonedDoc.getElementById('customer-detail-body');
          if(clonedBody){
            clonedBody.style.overflow='visible';
            clonedBody.style.maxHeight='none';
            clonedBody.style.height='auto';
            clonedBody.querySelectorAll('*').forEach(el=>{
              const cs=window.getComputedStyle(el);
              if(cs.overflowY==='auto'||cs.overflowY==='scroll'||cs.overflowY==='hidden'){
                el.style.overflowY='visible';
                el.style.maxHeight='none';
              }
            });
          }
        }
      }).then(canvas=>{
        // Restore original styles
        savedStyles.forEach(({el, overflow, overflowY, maxHeight, height})=>{
          el.style.overflow=overflow;
          el.style.overflowY=overflowY;
          el.style.maxHeight=maxHeight;
          el.style.height=height;
        });
        modalBody.style.overflowY=savedBodyOverflow;
        modalBody.style.maxHeight=savedBodyMax;

        const link=document.createElement('a');
        link.download=`Customer_Card_${bdDate()}.png`;
        link.href=canvas.toDataURL('image/png');
        link.click();
        showToast('✅ PNG ডাউনলোড হয়েছে!','success');
      }).catch(e=>{
        // Restore on error too
        savedStyles.forEach(({el, overflow, overflowY, maxHeight, height})=>{
          el.style.overflow=overflow; el.style.overflowY=overflowY;
          el.style.maxHeight=maxHeight; el.style.height=height;
        });
        modalBody.style.overflowY=savedBodyOverflow;
        modalBody.style.maxHeight=savedBodyMax;
        showToast('PNG error: '+e.message,'error');
      });
    }, 150);
  };

  if(typeof html2canvas!=='undefined'){ doCapture(); return; }
  const script=document.createElement('script');
  script.src='https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
  script.onload=doCapture;
  script.onerror=()=>showToast('PNG library load হয়নি — Ctrl+Shift+I দিয়ে screenshot নিন','error');
  document.head.appendChild(script);
}

