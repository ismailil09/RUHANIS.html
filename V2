// ── বর্তমান অবস্থানের লিস্ট (ট্র্যাকিং সিমুলেশন)
const LOCATION_STEPS = ['Warehouse', 'Sorting Hub', 'In Transit', 'District Hub', 'Last Mile', 'Out for Delivery', 'Delivered'];

// ── Sales ডাটা থেকে কুরিয়ার ডাটা বিল্ড করো
function buildCourierData() {
  const rawOrders = (typeof liveSalesData !== 'undefined' && liveSalesData.length ? liveSalesData : (typeof salesData !== 'undefined' ? salesData : []));
  // ✅ FIX (Multi-product order, Sept 2026): একই Order ID-র একাধিক প্রোডাক্ট-লাইন
  // কুরিয়ার ম্যানেজারে ডুপ্লিকেট সারি হিসেবে না দেখিয়ে একটা অর্ডার হিসেবে গ্রুপ করা হয়
  // (ডেলিভারি বুকিং হয় পার্সেল/অর্ডার অনুযায়ী, প্রোডাক্ট-লাইন অনুযায়ী না)
  const orders = (typeof _groupSalesRows === 'function') ? _groupSalesRows(rawOrders) : rawOrders;
  const result = {};
  Object.keys(COURIER_CONFIG).forEach(name => {
    result[name] = { total:0, delivered:0, inTransit:0, returned:0, pending:0, totalDeliveryFee:0, totalCOD:0, totalNet:0, orders:[] };
  });
  orders.forEach((o, idx) => {
    const cName = o.courier || o.Courier || '';
    if (!cName || !result[cName]) return;
    const stat   = o.status || o.Status || 'Pending';
    const total  = parseFloat(o.total || o.Total || 0);
    const delivFee = parseFloat(o.delivery || o.Delivery || o['Delivery Charge'] || COURIER_CONFIG[cName]?.baseDelivery || 0);
    const codPct = parseFloat(o.codPct || o.CODPct || o['COD%'] || 0);
    // salesData-এ codAmount (col X) সরাসরি আছে, সেটা ব্যবহার করো
    const savedCodAmt = parseFloat(o.codAmount || o.codCharge || o.CODCharge || o['COD Charge'] || 0);
    // ✅ BUG #2 FIX: COD % applies to customerPayable (total + delivery), not just total
    const customerPayable = total + delivFee;
    const codAmt = savedCodAmt > 0 ? savedCodAmt : Math.round((customerPayable * codPct) / 100);
    // netPayable সরাসরি থাকলে সেটা ব্যবহার করো, না হলে হিসাব করো
    const savedNetPay = parseFloat(o.netPayable || 0);
    const netPay = savedNetPay > 0 ? savedNetPay : Math.max(0, customerPayable - codAmt);

    const r = result[cName];
    r.total++;
    r.totalDeliveryFee += delivFee;
    r.totalCOD         += codAmt;
    r.totalNet         += netPay;
    if (stat === 'Delivered')  r.delivered++;
    else if (stat === 'In Transit' || stat === 'Processing') r.inTransit++;
    else if (stat === 'Returned' || stat === 'Cancelled')    r.returned++;
    else r.pending++;

    // ট্র্যাকিং লোকেশন — স্ট্যাটাস দিয়ে অনুমান
    const locMap = { Pending:'Warehouse', Processing:'Sorting Hub', 'In Transit':'District Hub', Delivered:'Delivered', Returned:'Sorting Hub', Cancelled:'Warehouse' };
    // ✅ FIX 2.1 (v40): consignmentId — tracking field-এ Pathao consignment_id ও Steadfast tracking_code দুটোই হতে পারে।
    // salesData-এ o.tracking = col T (Tracking No) — এটাই CN#
    // Notes-এ [CID:XXXXXXX] tag থেকে Consignment ID বের করি
    const realId = o.id || o.orderId || o.OrderID || String(idx+1);
    const trackingVal = o.tracking || o.Tracking || o.trackingNo || '';
    const notesVal = String(o.notes || o.Notes || '');
    const cidMatch = notesVal.match(/\[CID:([^\]]+)\]/);
    const consignmentId = cidMatch ? cidMatch[1] : '';   // e.g. "265282795"
    // ✅ FIX (সমস্যা ১): ম্যানুয়ালি সেভ করা এক-ক্লিক tracking link — আলাদা কলাম থেকে
    // (NOTES-এ রাখা হয়নি, কারণ NOTES কুরিয়ার বুকিং-এর নোট হিসেবে পার্সেলে চলে যায়)
    const manualLink = o.trackingLink || '';
    // ✅ FIX (Multi-product order, Sept 2026): একাধিক প্রোডাক্ট-লাইন থাকলে সবগুলোর নাম একসাথে দেখাও
    const items = Array.isArray(o.items) && o.items.length ? o.items : [{product:o.product,qty:o.qty,price:o.price}];
    const productSummary = items.map(it => `${it.product}${items.length>1?` ×${it.qty}`:''}`).join(', ');
    r.orders.push({
      date:           o.date || o.Date || '—',
      customer:       o.customer || o.Customer || '—',
      orderId:        realId,
      tracking:       trackingVal,        // CN# e.g. SFR260629ST9B4579DBD
      consignmentId:  consignmentId || trackingVal,  // Numeric Consignment ID preferred
      cnCode:         trackingVal,        // always CN#
      manualLink:     manualLink,         // one-click link pasted from courier app/SMS
      phone:          o.phone || o.Phone || '',
      division:       o.division || o.Division || '',
      district:       o.district || o.District || '',
      thana:          o.thana || o.Thana || '',
      address:        o.address || o.Address || '',
      product:        productSummary,
      qty:            items.reduce((s,it)=>s+(Number(it.qty)||0),0),
      price:          items.length===1 ? (items[0].price||0) : '',
      notes:          notesVal,
      courier:        cName,
      status:         stat,
      location:       locMap[stat] || 'In Transit',
      delivFee,
      codAmt,
      netPay,
      codPct:         codPct,
    });
  });
  return result;
}

// ── ৬টি কুরিয়ার অ্যানালিটিক্স কার্ড রেন্ডার
