    sold:    parseInt(Number(p.sold)||0),
  }));
  // Cards
  document.getElementById('inv-cards').innerHTML = rows.map(p=>{
    const pct = Math.round((p.current/Math.max(p.opening+p.in,1))*100);
    const cls = p.current<=p.alert?'low':p.current<=p.alert*2?'warn':'ok';
    return `<div class="inv-card ${p.current<=p.alert?'low':''}">
      <div class="inv-product">${p.name}</div>
      <div class="inv-sku">${p.id} · ${p.cat}</div>
