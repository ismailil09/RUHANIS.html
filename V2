  const bars = (arr,fmt)=>{ const mx=Math.max(1,...arr.map(x=>x[1])); return arr.length ? `<table style="width:100%;border-collapse:collapse;font-size:13px;">${arr.map(([k,v])=>`<tr><td style="padding:6px 8px;border-bottom:1px solid var(--border);">${esc(fmt?fmt(k):k)}</td><td style="padding:6px 8px;border-bottom:1px solid var(--border);text-align:right;font-family:'IBM Plex Mono',monospace;white-space:nowrap;color:var(--red);font-weight:700;">${money(v)}</td><td style="padding:6px 8px;border-bottom:1px solid var(--border);width:30%;"><div style="height:6px;border-radius:4px;background:var(--border);overflow:hidden;"><i style="display:block;height:100%;width:${Math.round(v*100/mx)}%;background:var(--gold);"></i></div></td></tr>`).join('')}</table>` : '<div style="color:var(--text3);padding:8px;">কোনো ডেটা নেই</div>'; };
