    });
    var sortedYears=Object.keys(years).map(Number).sort(function(a,b){return b-a;});

    // FA modal year dropdown
    var faSel=document.getElementById('fa-year-sel');
    if(faSel){
      var curFaVal=faSel.value;
      faSel.innerHTML='<option value="0">সব বছর</option>';
      sortedYears.forEach(function(y){
        var opt=document.createElement('option');
        opt.value=y; opt.textContent=y+' সাল';
        if(Number(curFaVal)===y) opt.selected=true;
        faSel.appendChild(opt);
