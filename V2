function invRateHint(pfx){
  const amt = parseFloat(el(pfx+'-amount')?.value||0)||0, rate = parseFloat(el(pfx+'-profit-rate')?.value||0)||0, per = el(pfx+'-rate-period')?.value||'Monthly', hint = el(pfx+'-rate-hint');
