    if (!result) {
      pinBuffer = ''; updatePinDots();
      document.getElementById('pin-error').textContent = '⚠️ সার্ভারের সাথে যোগাযোগ করা যায়নি — আবার চেষ্টা করুন';
      setTimeout(() => { document.getElementById('pin-error').textContent = ''; }, 1800);
      return;
    }
    failedAttempts++;
    for (let i=0; i<4; i++) {
      document.getElementById('d'+i).classList.add('error');
      document.getElementById('d'+i).classList.remove('filled');
    }
    const rem = MAX_ATTEMPTS - failedAttempts;
    if (failedAttempts >= MAX_ATTEMPTS) { startLockout(); }
    else {
      document.getElementById('pin-error').textContent = `❌ ভুল PIN — আর ${rem} বার সুযোগ বাকি`;
      setTimeout(() => { pinBuffer=''; updatePinDots(); document.getElementById('pin-error').textContent=''; }, 1200);
    }
    return;
  }

  const isValid = (computedHash === pinHashCache.hashes[partnerAtSubmit]);
  document.getElementById('pin-error').textContent = '';

  if (isValid) {
    failedAttempts = 0;
    sessionStorage.removeItem('innogix_lockout_until');
    unlockApp(partnerAtSubmit);
    return;
  }

  // ভুল PIN
  failedAttempts++;
  for (let i=0; i<4; i++) {
    document.getElementById('d'+i).classList.add('error');
    document.getElementById('d'+i).classList.remove('filled');
  }

  const remaining = MAX_ATTEMPTS - failedAttempts;
  if (failedAttempts >= MAX_ATTEMPTS) {
    startLockout();
  } else {
    document.getElementById('pin-error').textContent = `❌ ভুল PIN — আর ${remaining} বার সুযোগ বাকি`;
    setTimeout(() => {
      pinBuffer = ''; updatePinDots();
      document.getElementById('pin-error').textContent = '';
    }, 1200);
  }
}

