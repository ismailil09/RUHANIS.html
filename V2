let currentEditOrderId = null;

async function submitOrder(){
  const m=document.getElementById('modal-add-order');
  // ── FIX 1: Validate required fields before saving ──
  const customerVal = (m.querySelector('#order-customer')?.value||'').trim();
  const phoneVal    = _fixPhone(m.querySelector('#order-phone')?.value||'');
  // ✅ FIX (Multi-product order, Sept 2026): প্রতিটা প্রোডাক্ট-লাইন ভ্যালিডেট করো
  const orderItems = (Array.isArray(window._orderItems) ? window._orderItems : []).filter(it => it.product);
  if(!customerVal){ showToast('⚠️ Customer Name লিখুন','error'); m.querySelector('#order-customer').focus(); return; }
  if(!phoneVal||phoneVal.length<11){ showToast('⚠️ সঠিক Phone Number দিন (১১ ডিজিট)','error'); m.querySelector('#order-phone').focus(); return; }
  if(!orderItems.length){ showToast('⚠️ কমপক্ষে একটা Product select করুন','error'); return; }
  for(const it of orderItems){
    if(!it.qty || it.qty<1){ showToast(`⚠️ "${it.product}"-এর Quantity কমপক্ষে ১ হতে হবে`,'error'); return; }
    if(!it.price || it.price<1){ showToast(`⚠️ "${it.product}"-এর Unit Price দিন`,'error'); return; }
  }
  const payload={
    action: currentEditOrderId ? 'updateOrder' : 'addOrder',
    orderId: currentEditOrderId||null,
    // BD local time সরাসরি string আকারে পাঠাও (UTC toISOString এড়িয়ে চলো)
    timestamp: (()=>{
      const d=new Date();
      const opts={timeZone:'Asia/Dhaka'};
      const day=new Intl.DateTimeFormat('en-GB',{...opts,day:'2-digit'}).format(d);
      const mon=new Intl.DateTimeFormat('en-GB',{...opts,month:'short'}).format(d);
      const yr=new Intl.DateTimeFormat('en-GB',{...opts,year:'numeric'}).format(d);
      const hr=new Intl.DateTimeFormat('en-GB',{...opts,hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(d);
      return day+'-'+mon+'-'+yr+' '+hr;
    })(),
    customer: m.querySelector('#order-customer').value,
    phone: _fixPhone(m.querySelector('#order-phone').value),
    division: m.querySelector('#order-division').value,
    district: document.getElementById('district-select').value,
    thana: document.getElementById('thana-select').value,
    address: m.querySelector('#order-address').value,
    // ✅ FIX (Multi-product order): items[] — সব প্রোডাক্ট-লাইন; product/qty/price legacy fallback (প্রথম আইটেম)
    items: orderItems.map(it => ({ product: it.product, qty: it.qty, price: it.price })),
    product: orderItems[0].product,
    qty: orderItems[0].qty,
    price: orderItems[0].price,
    paid: document.getElementById('order-paid').value,
    delivery: m.querySelector('#order-delivery').value,
    payment: m.querySelector('#order-payment').value,
    codPct: (()=>{ const el=document.getElementById('order-cod-pct'); return el?el.value:'0'; })(),
    codCharge: (()=>{ const el=document.getElementById('cod-charge-display'); if(!el) return '0'; return el.textContent.replace('৳','').replace(/,/g,'').trim()||'0'; })(),
    netPayable: (()=>{
      // ✅ BUG #2 FIX: Customer Payable = Total + Delivery (what courier collects)
      // COD fee is deducted from OUR net — NOT from customer's bill.
      // netPayable = what we actually receive after COD fee deduction.
      const tp  = parseFloat(document.getElementById('total-price')?.value||0);
      const del = parseFloat(m.querySelector('#order-delivery')?.value||0);
      const customerPayable = tp + del;
      const codPctEl = document.getElementById('order-cod-pct');
      const codPct   = codPctEl ? parseFloat(codPctEl.value)||0 : 0;
      const codAmt   = (customerPayable * codPct) / 100;
      return Math.max(0, customerPayable - codAmt).toFixed(2);
    })(),
    status: m.querySelector('#order-status').value,
    courier: m.querySelector('#order-courier').value,
    tracking: m.querySelector('#order-tracking').value,
    notes: m.querySelector('#order-notes').value,
    // ✅ v40 FIX (সমস্যা ৩): Description — শুধু আমাদের শীটে থাকে, কুরিয়ার বুকিং-এ কখনো পাঠানো হয় না
    description: (document.getElementById('order-description')?.value || ''),
    project: (document.getElementById('order-project')?.value || 'RUHANIS'),
    splitIsmail: parseFloat(document.getElementById('split-ismail')?.value||0),
    splitAshik:  parseFloat(document.getElementById('split-ashik')?.value||0),
    salesman: (document.getElementById('order-salesman')?.value||'').trim(),
  };
  closeModal('add-order');
  resetOrderModal();
  const ok=await postToAPI(payload);
  if(ok){
    // ✅ BUG 1 FIX: Capture the Google Sheet row number returned by addOrder.
    // GS returns { status:'success', row: <rowNumber> } for addOrder.
    // This row number IS the order's SL# (Col A) which is used for tracking lookup.
    // Store it globally so the courier dispatch hook can use the real ID.
    if (!currentEditOrderId && ok.row) {
      window._lastAddedOrderRow = ok.row; // actual sheet row (e.g. 5)
      window._lastAddedOrderId  = String(ok.row - 1); // SL# = row - 1 (row 2 = SL#1)
    }
    showToast(currentEditOrderId?'✅ Order updated!':'✅ Order saved!','success');
    // Return delivery charge auto-expense notification
    if(ok.returnExpenseAdded && ok.returnExpenseAmount>0){
      setTimeout(()=>{
        showToast(`🔄 Return Delivery Charge ৳${ok.returnExpenseAmount} — Expense-এ স্বয়ংক্রিয় যোগ হয়েছে`,'info');
      }, 1500);
    }
    logAction(currentEditOrderId ? `Order #${currentEditOrderId} আপডেট করেছেন` : `নতুন Order এন্ট্রি করেছেন — ${payload.customer} (${payload.product})`);
    // এই অর্ডারের প্রফিট কীভাবে ভাগ হলো তার তথ্যমূলক নোটিফিকেশন
    if (!currentEditOrderId) {
      const totalSale = parseFloat(payload.price||0) * parseFloat(payload.qty||1);
      const delivery  = parseFloat(payload.delivery||0);
      const codChargeSplit = parseFloat(payload.codCharge||0);
      // Net Profit = Customer Payable - Delivery (pass-through) - COD Charge
      const customerPayable = totalSale + delivery;
      const netProfit = Math.max(0, customerPayable - delivery - codChargeSplit);
      if (netProfit > 0) {
        // ── AUTO-LINK: Inventory থেকে product-specific split নাও ──
        const productName = payload.product || '';
        const prodSplit = _getProductSplit(productName);
        // যদি inventory-তে কোনো split সেট না থাকে, order modal-এর split ব্যবহার করো
        const autoIsmail = prodSplit.ismail > 0 || prodSplit.ashik > 0
          ? prodSplit.ismail : payload.splitIsmail;
        const autoAshik  = prodSplit.ismail > 0 || prodSplit.ashik > 0
          ? prodSplit.ashik  : payload.splitAshik;
        const compPct = Math.max(0, 100 - autoIsmail - autoAshik);
        const codNote = codChargeSplit > 0 ? ` (COD: ৳${Math.round(codChargeSplit).toLocaleString()} কাটা হয়েছে)` : '';
        showToast(`💰 প্রফিট বণ্টন: I:${autoIsmail}% | A:${autoAshik}% | C:${compPct.toFixed(0)}% — নেট প্রফিট ৳${Math.round(netProfit).toLocaleString()}${codNote}`, 'success');
      }
    }
    refreshAfterOrder(); // FIX v24: debounced — একসাথে সব API call না করে staggered
  } else {
    showToast('Google Sheets connect হয়নি — API URL চেক করুন', 'error');
  }
}


