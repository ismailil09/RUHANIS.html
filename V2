    <span class="kw">var</span> rows = s.getDataRange().getValues();
    <span class="kw">return</span> ContentService
      .createTextOutput(JSON.stringify({ status: <span class="st">'ok'</span>, data: rows }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

<span class="kw">function</span> <span class="fn">doPost</span>(e) {
  <span class="kw">var</span> payload = JSON.parse(e.postData.contents);
  <span class="kw">var</span> sheet = SpreadsheetApp.getActive();

  <span class="kw">if</span> (payload.action === <span class="st">'addOrder'</span>) {
    <span class="kw">var</span> s = sheet.getSheetByName(<span class="st">'Sales_Tracker'</span>);
    s.appendRow(payload.row);
