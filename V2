  const codPctEl = document.getElementById('order-cod-pct');
  if (codPctEl) {
    codPctEl.value = r.codPct || 0;
    codPctEl.dataset.auto = ''; // এটা সেভ করা আসল মান — অটো-ওভাররাইট বন্ধ রাখো
    // COD charge group দেখাও যদি COD% > 0
    const codGrp = document.getElementById('cod-charge-group');
    if (codGrp) codGrp.style.display = (r.codPct > 0) ? '' : 'none';
    // COD amount ও net payable display update করো
    const codDisp = document.getElementById('cod-charge-display');
    if (codDisp && r.codAmount) codDisp.textContent = '৳ ' + Math.round(r.codAmount).toLocaleString();
    const codNet = document.getElementById('cod-net-display');
    if (codNet && r.netPayable) codNet.textContent = '৳ ' + Math.round(r.netPayable).toLocaleString();
  }
  // Split % prefill
  const splitIEl = document.getElementById('split-ismail');
  const splitAEl = document.getElementById('split-ashik');
  if (splitIEl) splitIEl.value = r.splitIsmail || 0;
  if (splitAEl) splitAEl.value = r.splitAshik  || 0;
  openModal('add-order');
}

