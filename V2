function _globalSearchNow(q){
  const data = liveSalesData || [];
  // If query is empty or cleared — reset to full list without navigating away
  if(!q || !q.trim()){
    const activePage = document.querySelector('.page.active');
    if(activePage && activePage.id === 'page-sales'){
      renderSalesRows(data);
      document.getElementById('sales-count').textContent = data.length + ' records';
