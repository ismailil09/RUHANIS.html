async function changePin() {
  const currentEl  = document.getElementById('cp-current');
  const curPin     = currentEl.value.trim();
  const newPin     = document.getElementById('cp-new').value.trim();
  const confirmPin = document.getElementById('cp-confirm').value.trim();
  const errEl      = document.getElementById('cp-error');
  const partner    = currentPartner || selectedPartner;

  if (!partner) { errEl.textContent = '⚠️ পার্টনার শনাক্ত করা যায়নি — আগে লগইন/নির্বাচন করুন'; return; }
  if (!/^\d{4}$/.test(curPin)) { errEl.textContent = '❌ বর্তমান PIN দিন (4 সংখ্যা)'; return; }
  if (!/^\d{4}$/.test(newPin)) { errEl.textContent = '❌ নতুন PIN অবশ্যই 4টি সংখ্যা হতে হবে'; return; }
  if (newPin !== confirmPin) { errEl.textContent = '❌ PIN মিলছে না'; return; }

  errEl.textContent = '⏳ যাচাই করা হচ্ছে...';
  // বর্তমান ও নতুন PIN সার্ভারে পাঠিয়ে যাচাই ও আপডেট করা হয় —
  // ব্যাকএন্ড শুধু hash সেভ করে, PIN কোথাও প্লেইন টেক্সটে থাকে না।
  const result = await postToAPI({ action: 'changePin', partner, currentPin: curPin, newPin });
  errEl.textContent = '';

  if (!result) { errEl.textContent = '❌ PIN পরিবর্তন ব্যর্থ হয়েছে — বর্তমান PIN ঠিক আছে কিনা চেক করুন'; return; }

  // নতুন PIN সেট হয়ে গেছে — local hash cache পুরনো হয়ে গেছে, তাই রিফ্রেশ করো
  // (নাহলে instant client-side check পুরনো PIN দিয়েই যাচাই করবে)
  pinHashCache = null;
  ensurePinHashCache();

  if (currentPartner) logAction('PIN পরিবর্তন করেছেন');
  closeModal('change-pin');
  currentEl.value=''; document.getElementById('cp-new').value=''; document.getElementById('cp-confirm').value='';
  fromLock=false;
  showToast('✅ PIN সফলভাবে পরিবর্তন হয়েছে!','success');
  if (isLocked && selectedPartner) unlockApp(selectedPartner);
}
