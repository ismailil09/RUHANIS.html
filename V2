    <button class="btn" onclick="shCopyReader()">📋 Copy</button>
    <button class="btn" style="background:var(--red);color:#fff;border-color:var(--red);" onclick="shDeleteItem('${kind}','${shEsc(id)}')">🗑️ Delete</button>`;
  const list = _shVisible[kind]||[], idx = list.indexOf(String(id));
  const pos = document.getElementById('sh-rd-pos'); if(pos) pos.textContent = idx>=0 ? `${idx+1}/${list.length}` : '';
  const pv = document.getElementById('sh-rd-prev'), nx = document.getElementById('sh-rd-next');
  if(pv) pv.disabled = !(idx>0); if(nx) nx.disabled = !(idx>=0 && idx<list.length-1);
  const bd = document.querySelector('#modal-sh-reader .modal-body'); if(bd && _shReader._scrollTop) bd.scrollTop = 0;
}
function shReaderNav(delta){
  const list = _shVisible[_shReader.kind]||[]; const idx = list.indexOf(String(_shReader.id)); if(idx<0) return;
  const ni = idx+delta; if(ni<0 || ni>=list.length) return;
  _shReader.id = list[ni]; _shReader._scrollTop = true; shRenderReader(); _shReader._scrollTop = false;
}
document.addEventListener('keydown', e=>{
  const m = document.getElementById('modal-sh-reader');
  if(!m || !m.classList.contains('open')) return;
  if(e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
  if(e.key==='ArrowLeft') shReaderNav(-1); else if(e.key==='ArrowRight') shReaderNav(1);
});
function shCloseReader(){ const m=document.getElementById('modal-sh-reader'); if(m) m.classList.remove('open'); }
function shReaderFont(delta){
  _shReader.size = Math.max(13, Math.min(28, _shReader.size + delta));
  try{ localStorage.setItem('sh_reader_size', String(_shReader.size)); }catch(e){}
  shRenderReader();
}
function shCopyReader(){
  const it = shFindItem(_shReader.kind,_shReader.id); if(!it) return;
  let txt;
  if(_shReader.kind==='task') txt = `${it.description}\n\nAssigned: ${it.assignedTo}\nDate: ${it.date}\nPriority: ${it.priority} | Status: ${it.status}\n${it.remarks?'Remarks: '+it.remarks:''}`;
  else if(_shReader.kind==='plan') txt = `${it.title}\n[${it.type} | ${it.status}] Target: ${it.targetDate} | Budget: ${it.budget}\n\n${it.milestones}`;
  else txt = `${it.title}\n[${it.status}] ${it.date} — ${it.proposedBy}\n\n${it.description}\n\n${it.actionNotes?'Action Notes:\n'+it.actionNotes:''}`;
  const done = ()=>showToast('📋 কপি হয়েছে','success');
  if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(txt.trim()).then(done, ()=>showToast('কপি করা যায়নি','error')); }
  else { const ta=document.createElement('textarea'); ta.value=txt.trim(); document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');done();}catch(e){showToast('কপি করা যায়নি','error');} ta.remove(); }
}


