let _shVisible = { task:[], plan:[], idea:[] };
let _shFromIdea = null;
function shSearch(rows, inputId, keys){
  const q = (document.getElementById(inputId)?.value||'').trim().toLowerCase();
  if(!q) return rows;
  return rows.filter(r => keys.some(k => String(r[k]==null?'':r[k]).toLowerCase().includes(q)));
}
// ডেডলাইন বনাম আজ (ঢাকা)
function shDueInfo(v, done){
  const p = shParseDate(v); if(!p) return {has:false, overdue:false, days:null};
  const t = shParseDate(dNowBD_());
  const days = Math.round((Date.UTC(p.y,p.m-1,p.d) - Date.UTC(t.y,t.m-1,t.d))/86400000);
  return {has:true, days, overdue: !done && days<0};
}
function shDueCell(v, done){
  const i = shDueInfo(v, done);
  if(!i.has) return v ? shEsc(v) : '—';
  const d = shFmtDate(v); let tag='';
  if(!done){
    if(i.days<0) tag = `<div style="color:#f85149;font-weight:700;font-size:11px;">⚠️ ${shBnNum(-i.days)} দিন Overdue</div>`;
    else if(i.days===0) tag = `<div style="color:#f0b429;font-weight:700;font-size:11px;">🔥 আজই শেষ</div>`;
    else if(i.days<=2) tag = `<div style="color:#f0b429;font-size:11px;">⏰ ${shBnNum(i.days)} দিন বাকি</div>`;
  }
  return `<span class="mono">${d}</span>${tag}`;
}
