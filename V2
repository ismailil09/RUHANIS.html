    // Issue 1 FIX: backend এর margin ব্যবহার করো, না থাকলে JS এ হিসাব
    // v67 FIX: hardened with Number()||0 — a raw p.margin/p.sell/p.cost that's
    // undefined, "", or otherwise non-numeric used to be able to produce
    // `undefined.toFixed()` below and crash the whole table render. Now it's
    // always guaranteed to be a real number before it ever reaches .toFixed().
    const margin = Number(
      (p.margin != null && p.margin > 0)
        ? p.margin
        : (p.sell > 0 ? Math.round((p.sell - p.cost) / p.sell * 10000) / 100 : 0)
    ) || 0;
    // Issue 4 FIX: backend এর stockStatus ব্যবহার করো
    const hasStatus = p.stockStatus && p.stockStatus.trim();
    const statusClass = p.current <= 0 ? 'cancelled' : p.current <= p.alert ? 'pending' : 'delivered';
    const statusLabel = hasStatus
      ? p.stockStatus
      : (p.current <= 0 ? '🔴 Out of Stock' : p.current <= p.alert ? '🟡 Low Stock' : '🟢 In Stock');
    const shortLabel  = p.current <= 0 ? 'Out of Stock' : p.current <= p.alert ? 'Low Stock' : 'In Stock';
    // Profit split badge
    const split = _getProductSplit(p.name);
    const si = Number(p.splitIsmail != null ? parseFloat(p.splitIsmail) : split.ismail) || 0;
    const sa = Number(p.splitAshik  != null ? parseFloat(p.splitAshik)  : split.ashik)  || 0;
    const sc = Number(Math.max(0, 100 - si - sa)) || 0;
    const splitBadge = `<div class="profit-split-badge">
