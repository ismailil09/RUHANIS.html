      <span style="display:flex;gap:8px;align-items:center;"><button class="btn btn-sm" ${PT.page <= 1 ? 'disabled' : ''} onclick="ptPage(-1)">◀ আগের</button><span>পৃষ্ঠা ${PT.page} / ${pages}</span><button class="btn btn-sm" ${PT.page >= pages ? 'disabled' : ''} onclick="ptPage(1)">পরের ▶</button></span>`;
