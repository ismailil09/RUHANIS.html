      ${window._orderItems.length>1 ? `<button type="button" class="btn" onclick="_removeOrderItem(${idx})" style="padding:6px 10px;background:var(--red);color:#fff;border-color:var(--red);">✕</button>` : `<span></span>`}
    </div>`).join('');
  _recalcOrderSubtotal();
}
function _addOrderItem(){
  window._orderItems.push({ product:'', qty:1, price:0 });
  _renderOrderItems();
}
function _removeOrderItem(idx){
  if (window._orderItems.length <= 1) return;
  window._orderItems.splice(idx, 1);
  _renderOrderItems();
}
// প্রোডাক্ট সিলেক্ট বদলানো / সারি যোগ-বাদ — পুরো লিস্ট রি-রেন্ডার নিরাপদ (dropdown, ফোকাস হারায় না)
function _updateOrderItem(idx, field, value){
  if (!window._orderItems[idx]) return;
  window._orderItems[idx][field] = value;
  if (field === 'product') onOrderProductChange(value);
  _renderOrderItems();
}
// Qty/Price টাইপ করার সময় — পুরো রি-রেন্ডার না করে শুধু ওই লাইনের টোটাল + সাবটোটাল আপডেট করো
// (নাহলে টাইপ করতে করতে ইনপুট ফোকাস হারিয়ে ফেলবে)
function _updateOrderItemLive(idx, field, value){
  if (!window._orderItems[idx]) return;
  window._orderItems[idx][field] = parseFloat(value) || 0;
  const lineTotal = (Number(window._orderItems[idx].qty)||0) * (Number(window._orderItems[idx].price)||0);
  const totalEl = document.getElementById(`order-item-total-${idx}`);
  if (totalEl) totalEl.value = lineTotal;
  _recalcOrderSubtotal();
}
function _recalcOrderSubtotal(){
  const subtotal = window._orderItems.reduce((s,it) => s + (Number(it.qty)||0)*(Number(it.price)||0), 0);
  const totalEl = document.getElementById('total-price');
  if (totalEl) totalEl.value = subtotal;
  // পুরনো #order-product/#order-qty/#unit-price হিডেন ফিল্ড — legacy কোড/CSV/স্মার্ট-পেস্টের জন্য প্রথম আইটেম দিয়ে সিঙ্ক রাখা
  const first = window._orderItems[0] || {product:'',qty:1,price:0};
  const pEl = document.getElementById('order-product'); if (pEl) pEl.value = first.product||'';
  const qEl = document.getElementById('order-qty'); if (qEl) qEl.value = first.qty||1;
  const uEl = document.getElementById('unit-price'); if (uEl) uEl.value = first.price||0;
  calcDue();
}

