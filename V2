/* Clickable hint on the Top Region KPI card */
#kpi-card-top-region {
  cursor: pointer;
}
#kpi-card-top-region:hover {
  border-color: var(--blue) !important;
  box-shadow: 0 0 0 3px rgba(56,139,253,.12);
}
.kpi-expand-hint {
  position: absolute;
  top: 12px; right: 12px;
  font-size: 11px; color: var(--blue);
  background: rgba(56,139,253,.12);
  border: 1px solid rgba(56,139,253,.3);
  border-radius: 6px;
  padding: 2px 7px;
  font-weight: 600;
  letter-spacing: .3px;
  opacity: 0;
  transition: opacity .2s;
  pointer-events: none;
}
