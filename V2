let _shReader = { kind:null, id:null, size:17 };
function shReaderSection(label, text){
  if(text==null || String(text).trim()==='') return '';
  return `<div class="sh-rd-sec"><div class="sh-rd-label">${label}</div><div class="sh-rd-text" style="font-size:${_shReader.size}px;">${shEsc(text)}</div></div>`;
}
function shOpenReader(kind,id){
  const it = shFindItem(kind,id); if(!it) return;
  _shReader.kind = kind; _shReader.id = String(id);
  try{ const sz = parseInt(localStorage.getItem('sh_reader_size')); if(sz>=13 && sz<=28) _shReader.size = sz; }catch(e){}
  shRenderReader();
  document.getElementById('modal-sh-reader').classList.add('open');
}
function shRenderReader(){
  const {kind,id} = _shReader; const it = shFindItem(kind,id); if(!it) return;
  const meta = [], bodyParts = [];
  let title='', icon='', badges='';
  const person = n => n==='Ashik' ? 'Partner B (Golam Rabbi)' : (n||'—');
  if(kind==='task'){
    icon='✅';
    const lines = String(it.description||'').split('\n'); title = (lines[0]||'Task').trim();
    const rest = lines.slice(1).join('\n').replace(/^\s*\n/,'');
