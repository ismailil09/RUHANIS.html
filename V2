async function loadLiveCRM(){
  // ── Bug 1 Fix: Always build CRM from live sales data directly ──
  // CRM sheet formulas can lag or have column misalignment.
  // Safer: aggregate from liveSalesData which is always fresh and correctly parsed.

  // সর্বদা liveSalesData থেকে build করি — sheet formula-র উপর নির্ভর করব না
  const safeN = v => { const n = parseFloat(String(v||'').replace(/[^0-9.-]/g,'')); return isNaN(n)?0:n; };

  let salesSource = liveSalesData;
  // যদি liveSalesData খালি থাকে, সরাসরি API থেকে আনো
  if(!salesSource || salesSource.length === 0){
    try {
      const sd = await fetchFromAPI('sales');
      if(sd && sd.data){
        salesSource = sd.data.map((r,i)=>({
          id: r[0]||i+1,
          customer: String(r[3]||'').trim(),
          phone:    _fixPhone(r[4]),
          div:      String(r[5]||'').trim(),
          dist:     String(r[6]||'').trim(),
          product:  String(r[9]||'').trim(),
          qty:      safeN(r[10]),
          price:    safeN(r[11]),
          total:    safeN(r[12]),  // col M = total
          paid:     safeN(r[13]),  // col N = paid
          due:      safeN(r[14]),  // col O = due
          delivery: safeN(r[15]),
          status:   String(r[16]||'').trim(),
          payment:  String(r[17]||'').trim(),
          date:     String(r[1]||'').trim(),
        })).filter(r=>r.customer);
        liveSalesData = salesSource;
      }
    } catch(e){ salesSource = []; }
  }

  const rows = [];
  if(salesSource && salesSource.length > 0){
    const crmMap = {};
    salesSource.forEach(r => {
      const rawPhone = _fixPhone(r.phone);
      const rawName  = String(r.customer||'').trim().toUpperCase();
      // FIX v28: phone normalize করো (leading 0 / +88 দিয়ে same নম্বর একই key হবে)
      // 01711... এবং +8801711... এবং 8801711... একই key হবে
      let phoneKey = rawPhone.replace(/[^0-9+]/g,'');
      if(phoneKey.startsWith('+88')) phoneKey = phoneKey.slice(3);
      if(phoneKey.startsWith('88') && phoneKey.length === 13) phoneKey = phoneKey.slice(2);
      // key: phone থাকলে phone, না থাকলে name
      const key = phoneKey || rawName;
      if(!key) return;
      if(!crmMap[key]){
        crmMap[key] = {
          name: String(r.customer||'').trim(),
          phone: String(r.phone||'').trim(),
          div: String(r.div||'').trim(),
          dist: String(r.dist||'').trim(),
          orders: 0, spent: 0, due: 0, last: '',
          statusSummary: {}  // FIX v24: order status breakdown per customer
        };
      }
      crmMap[key].orders++;
      // FIX v24: count each order status
      const st  = String(r.status||'').trim();
      crmMap[key].statusSummary[st] = (crmMap[key].statusSummary[st]||0) + 1;
      const pmt = String(r.payment||'').trim().toLowerCase();
      // শুধু valid order-এর জন্য spent ও due যোগ করো
      if(st !== 'Cancelled' && st !== 'Returned'){
        // FIX v24: double-price bug fix
        // r.total = qty × unitPrice (stored by GS)
        // r.price = unit price, r.qty = quantity
        // Use r.total directly — এটাই সঠিক কারণ GS নিজে calculate করে লিখেছে
        // FIX v25: Total Spent = product total + delivery charge
        const orderTotal = safeN(r.total) + safeN(r.delivery);
        crmMap[key].spent += orderTotal;
        crmMap[key].totalDelivery = (crmMap[key].totalDelivery||0) + safeN(r.delivery);
        crmMap[key].totalQty = (crmMap[key].totalQty||0) + safeN(r.qty);
        // COD/Cash/bKash/Nagad Delivered হলে due = 0 (টাকা collect হয়েছে)
        const isCollectedOnDelivery = st === 'Delivered' &&
          (pmt === 'cod' || pmt === 'cash' || pmt === 'bkash' || pmt === 'nagad');
        crmMap[key].due += isCollectedOnDelivery ? 0 : safeN(r.due);
      }
      // সর্বশেষ order date
      const d = String(r.date||'').trim();
      if(d && (!crmMap[key].last || d > crmMap[key].last)) crmMap[key].last = d;
    });

    Object.values(crmMap).forEach((c,i)=>{
      rows.push({
        id: i+1,
        name:   c.name,
        phone:  c.phone,
        div:    c.div,
        dist:   c.dist,
        orders: c.orders,
        spent:  Math.round(c.spent),
        due:    Math.round(c.due),
        totalDelivery: Math.round(c.totalDelivery||0),
        avg:    c.orders > 0 ? Math.round(c.spent / c.orders) : 0,
        last:   c.last,
        type:   c.orders >= 3 ? '🔄 Repeat' : '👤 Regular',
        statusSummary: c.statusSummary || {},
        totalQty: c.totalQty || 0  // FIX v24: total pieces ordered
      });
    });
    rows.sort((a,b) => b.spent - a.spent);
    rows.forEach((r,i) => r.id = i+1);
  }

  if(!rows.length){
    document.getElementById('crm-body').innerHTML='<tr><td colspan="11" style="text-align:center;padding:40px;color:var(--text3);">কোনো Customer data নেই</td></tr>';
    return;
  }
  renderCRMRows(rows);
  const el1=document.getElementById('crm-total');  if(el1) el1.textContent=rows.length;
  const el2=document.getElementById('crm-repeat'); if(el2) el2.textContent=rows.filter(c=>String(c.type).includes('Repeat')).length;
  const el3=document.getElementById('crm-due');    if(el3) el3.textContent=rows.filter(c=>c.due>0).length;
  const el4=document.getElementById('crm-top');    if(el4){ const top=rows[0]||{name:'—'}; el4.textContent=top.name; }
  renderDeliveryAnalytics();
}

