.pin-key {
  height:56px;
  min-height:52px;
  border-radius:12px;
  border:1px solid var(--border);
  background:var(--bg3);
  color:var(--text);
  font-size:20px; font-weight:700;
  cursor:pointer;
  transition:all .15s;
  font-family:'IBM Plex Mono',monospace;
  user-select:none;
  /* FIX: ensure button text is always visible */
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
