      <div class="inv-stat"><label>Total Sold</label><span>${p.sold}</span></div>
      <div class="stock-bar"><div class="stock-fill ${cls}" style="width:${Math.min(pct,100)}%"></div></div>
      ${p.current<=p.alert?'<div class="low-badge">⚠ Low Stock</div>':''}
    </div>`;
  }).join('');
  // Update sidebar low-stock badge
  const lowCount = rows.filter(p=>p.current<=p.alert).length;
