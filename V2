<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RUHANIS Business OS</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&family=Playfair+Display:ital,wght@0,700;0,900;1,400&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* ═══════════════════════════════════════
   DESIGN SYSTEM
═══════════════════════════════════════ */
:root {
  --bg:         #0D1117;
  --bg2:        #161B22;
  --bg3:        #1C2330;
  --bg4:        #21262D;
  --border:     #30363D;
  --border2:    rgba(48,54,61,.6);
  --text:       #E6EDF3;
  --text2:      #8B949E;
  --text3:      #6E7681;
  --gold:       #D4A017;
  --gold2:      rgba(212,160,23,.15);
  --gold3:      rgba(212,160,23,.08);
  --blue:       #388BFD;
  --blue2:      rgba(56,139,253,.15);
  --green:      #3FB950;
  --green2:     rgba(63,185,80,.15);
  --red:        #F85149;
  --red2:       rgba(248,81,73,.15);
  --orange:     #E3B341;
  --orange2:    rgba(227,179,65,.15);
  --purple:     #BC8CFF;
  --purple2:    rgba(188,140,255,.15);
  --cyan:       #39D353;
  --ismail:     #388BFD;
  --ashik:      #3FB950;
  --sidebar-w:  260px;
  --header-h:   60px;
}
.light {
  --bg:         #F6F8FA;
  --bg2:        #FFFFFF;
  --bg3:        #F0F2F5;
  --bg4:        #EAEEF2;
  --border:     #D0D7DE;
  --border2:    rgba(208,215,222,.6);
  --text:       #1F2328;
  --text2:      #656D76;
  --text3:      #8C959F;
  --gold2:      rgba(212,160,23,.1);
  --gold3:      rgba(212,160,23,.05);
  --blue2:      rgba(56,139,253,.1);
  --green2:     rgba(63,185,80,.1);
  --red2:       rgba(248,81,73,.1);
  --orange2:    rgba(227,179,65,.1);
  --purple2:    rgba(188,140,255,.1);
}

*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
html,body{overflow-x:hidden;max-width:100%;}
body{
  font-family:'IBM Plex Sans',sans-serif;
  background:var(--bg);
  color:var(--text);
  display:block;
  min-height:100vh;
  font-size:14px;
  transition:background .3s,color .3s;
}

/* ═══════════════════════════════════════
   SIDEBAR
═══════════════════════════════════════ */
.sidebar{
  width:var(--sidebar-w);
  min-height:100vh;
  background:var(--bg2);
  border-right:1px solid var(--border);
  display:flex;
  flex-direction:column;
  position:fixed;
  top:0;left:0;
  z-index:200;
  transition:transform .3s;
}
.sidebar-logo{
  padding:20px 20px 16px;
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
}
.logo-icon{
  width:38px;height:38px;
  background:linear-gradient(135deg,var(--gold),#8B6914);
  border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  font-size:18px;flex-shrink:0;
  box-shadow:0 0 16px rgba(212,160,23,.3);
}
.sidebar-logo{justify-content:center;padding:18px 16px 14px;}
/* সাইডবার স্ক্রল: মেনু বেশি হলে পুরো সাইডবার স্ক্রল হয় (কুরিয়ার Settings / লক ওএস নাগালে থাকে) */
.sidebar{height:100vh;height:100dvh;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:var(--border) transparent;}
.sidebar > *{flex-shrink:0;}
.sidebar::-webkit-scrollbar{width:6px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--border);border-radius:6px;}
.sidebar::-webkit-scrollbar-thumb:hover{background:var(--text3);}
.sidebar .sidebar-logo{position:sticky;top:0;z-index:3;background:var(--bg2);}
.innogix-logo-img{display:block;width:118px;max-width:100%;height:auto;}
.light .innogix-logo-img{filter:brightness(.38) contrast(1.1);}
.logo-text h2{font-size:14px;font-weight:700;color:var(--text);letter-spacing:.5px;}
.logo-text p{font-size:10px;color:var(--text3);letter-spacing:1px;text-transform:uppercase;}

.sidebar-section{padding:12px 12px 4px;font-size:10px;font-weight:700;color:var(--text3);letter-spacing:2px;text-transform:uppercase;}

.nav-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 12px;border-radius:8px;
  margin:1px 8px;
  cursor:pointer;color:var(--text2);
  font-size:13px;font-weight:500;
  transition:all .15s;position:relative;
  border:1px solid transparent;
}
.nav-item:hover{background:var(--bg3);color:var(--text);}
.nav-item.active{background:var(--gold3);border-color:rgba(212,160,23,.3);color:var(--gold);}
.nav-item.active .nav-icon{color:var(--gold);}
.nav-icon{font-size:16px;width:20px;text-align:center;}
.nav-badge{margin-left:auto;background:var(--red);color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:10px;min-width:18px;text-align:center;}
.nav-badge.green{background:var(--green);}
.nav-badge.gold{background:var(--gold);}

.sidebar-footer{
  margin-top:auto;padding:16px;
  border-top:1px solid var(--border);
}
.partner-chips-sidebar{display:flex;flex-direction:column;gap:6px;}
.p-chip{
  display:flex;align-items:center;gap:8px;
  padding:7px 10px;border-radius:8px;
  font-size:11px;font-weight:600;
  border:1px solid var(--border);
  background:var(--bg3);
}
.p-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

/* ═══════════════════════════════════════
   MAIN AREA
═══════════════════════════════════════ */
.main{
  margin-left:var(--sidebar-w);
  flex:1;
  display:flex;
  flex-direction:column;
  min-height:100vh;
}

/* TOP BAR */
.topbar{
  height:var(--header-h);
  background:var(--bg2);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;
  padding:0 28px;gap:16px;
  position:sticky;top:0;z-index:100;
}
.topbar-title{font-size:16px;font-weight:700;color:var(--text);letter-spacing:.3px;}
.topbar-sub{font-size:12px;color:var(--text3);margin-left:4px;}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:12px;}
.search-box{
  display:flex;align-items:center;gap:8px;
  background:var(--bg3);border:1px solid var(--border);
  border-radius:8px;padding:6px 12px;
  color:var(--text2);font-size:12px;
  transition:border .2s;
}
.search-box input{background:none;border:none;outline:none;color:var(--text);font-size:12px;width:180px;font-family:'IBM Plex Sans',sans-serif;}
.search-box input::placeholder{color:var(--text3);}
.search-box:focus-within{border-color:var(--gold);}
.icon-btn{
  width:34px;height:34px;border-radius:8px;
  border:1px solid var(--border);
  background:var(--bg3);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:15px;
  transition:all .15s;color:var(--text2);
}
.icon-btn:hover{background:var(--bg4);color:var(--text);border-color:var(--gold);}
.live-badge{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--green);font-weight:600;}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(63,185,80,.5);}50%{opacity:.7;box-shadow:0 0 0 4px rgba(63,185,80,0);}}

/* CONTENT */
.content{padding:28px;flex:1;overflow-x:hidden;}

/* PAGE */
.page{display:none;}
.page.active{display:block;}

/* ═══════════════════════════════════════
   DASHBOARD CARDS
═══════════════════════════════════════ */
.kpi-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;margin-bottom:24px;
}
.kpi-card{
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:12px;
  padding:20px;
  position:relative;overflow:hidden;
  transition:border-color .2s,transform .2s;
}
.kpi-card:hover{border-color:var(--gold);transform:translateY(-2px);}
.kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.kpi-card.green::before{background:linear-gradient(90deg,transparent,var(--green),transparent);}
.kpi-card.blue::before{background:linear-gradient(90deg,transparent,var(--blue),transparent);}
.kpi-card.gold::before{background:linear-gradient(90deg,transparent,var(--gold),transparent);}
.kpi-card.red::before{background:linear-gradient(90deg,transparent,var(--red),transparent);}
.kpi-card.purple::before{background:linear-gradient(90deg,transparent,var(--purple),transparent);}
.kpi-card.orange::before{background:linear-gradient(90deg,transparent,var(--orange),transparent);}
.kpi-label{font-size:11px;color:var(--text3);font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.kpi-value{font-size:26px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:var(--text);line-height:1.1;margin-bottom:6px;}
.kpi-value .tk{font-size:14px;color:var(--text3);font-family:'IBM Plex Sans',sans-serif;}
.kpi-change{font-size:11px;display:flex;align-items:center;gap:4px;}
.kpi-change.up{color:var(--green);}
.kpi-change.down{color:var(--red);}
.kpi-icon{position:absolute;right:16px;top:16px;font-size:28px;opacity:.15;}

/* CHART ROWS */
.chart-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;}
.chart-row.three{grid-template-columns:2fr 1fr 1fr;}
.chart-card{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:12px;padding:22px;
}
.chart-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:4px;}
.chart-sub{font-size:11px;color:var(--text3);margin-bottom:16px;}
.chart-area{height:180px;position:relative;display:flex;align-items:flex-end;gap:6px;overflow:hidden;}
.bar{flex:1;border-radius:4px 4px 0 0;min-height:4px;position:relative;transition:height .5s ease;cursor:pointer;}
.bar:hover{opacity:.85;}
.bar-label{position:absolute;bottom:-20px;left:0;right:0;text-align:center;font-size:9px;color:var(--text3);}
.bar-val{position:absolute;top:-18px;left:0;right:0;text-align:center;font-size:9px;color:var(--text2);font-family:'IBM Plex Mono',monospace;}
.chart-legend{display:flex;gap:16px;margin-top:28px;}
.legend-item{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text2);}
.legend-dot{width:8px;height:8px;border-radius:2px;}

/* PARTNER BALANCE CARDS */
.partner-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;}
.partner-bal-card{
  border-radius:12px;padding:20px;position:relative;overflow:hidden;
  border:1px solid var(--border);
}
.partner-bal-card.ismail{background:linear-gradient(135deg,rgba(56,139,253,.12),rgba(56,139,253,.04));border-color:rgba(56,139,253,.3);}
.partner-bal-card.ashik{background:linear-gradient(135deg,rgba(63,185,80,.12),rgba(63,185,80,.04));border-color:rgba(63,185,80,.3);}

.p-name{font-size:13px;font-weight:700;margin-bottom:2px;}
.p-role{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;}
.p-stats{display:flex;gap:16px;}
.p-stat label{font-size:10px;color:var(--text3);display:block;margin-bottom:2px;}
.p-stat span{font-size:15px;font-weight:700;font-family:'IBM Plex Mono',monospace;}
.p-initial{position:absolute;right:-8px;bottom:-12px;font-family:'Playfair Display',serif;font-size:72px;font-weight:900;opacity:.06;line-height:1;}

/* ═══════════════════════════════════════
   TABLE SYSTEM
═══════════════════════════════════════ */
.table-wrapper{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:12px;overflow:hidden;margin-bottom:24px;
}
.table-header{
  padding:16px 20px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:12px;flex-wrap:wrap;
}
.table-title{font-size:14px;font-weight:700;color:var(--text);}
.table-count{font-size:11px;color:var(--text3);background:var(--bg3);padding:2px 8px;border-radius:10px;font-family:'IBM Plex Mono',monospace;}
.table-actions{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;}
.btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 14px;border-radius:8px;font-size:12px;font-weight:600;
  cursor:pointer;border:1px solid var(--border);
  background:var(--bg3);color:var(--text2);
  transition:all .15s;font-family:'IBM Plex Sans',sans-serif;
  white-space:nowrap;
}
.btn:hover{background:var(--bg4);color:var(--text);}
.btn.primary{background:var(--gold);border-color:var(--gold);color:#000;}
.btn.primary:hover{background:#c4920f;border-color:#c4920f;}
.btn.success{background:var(--green2);border-color:rgba(63,185,80,.4);color:var(--green);}
.btn.danger{background:var(--red2);border-color:rgba(248,81,73,.4);color:var(--red);}

.filter-bar{
  padding:12px 20px;border-bottom:1px solid var(--border);
  display:flex;gap:10px;flex-wrap:wrap;align-items:center;
  background:var(--bg3);
}
.filter-select{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:6px;padding:5px 10px;color:var(--text);
  font-size:12px;font-family:'IBM Plex Sans',sans-serif;
  cursor:pointer;min-width:120px;
}
.filter-input{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:6px;padding:5px 10px;color:var(--text);
  font-size:12px;font-family:'IBM Plex Sans',sans-serif;
  outline:none;width:180px;
}
.filter-input:focus{border-color:var(--gold);}
.filter-select:focus{outline:none;border-color:var(--gold);}

/* TABLE SCROLL */
.table-scroll{overflow-x:auto;max-height:520px;overflow-y:auto;}
.table-scroll::-webkit-scrollbar{width:6px;height:6px;}
.table-scroll::-webkit-scrollbar-track{background:var(--bg3);}
.table-scroll::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}
.table-scroll::-webkit-scrollbar-thumb:hover{background:var(--text3);}

table{width:100%;border-collapse:collapse;white-space:nowrap;}
thead th{
  background:var(--bg3);
  padding:10px 14px;
  font-size:11px;font-weight:700;
  color:var(--text3);
  text-align:left;
  letter-spacing:.8px;text-transform:uppercase;
  position:sticky;top:0;z-index:10;
  border-bottom:1px solid var(--border);
  cursor:pointer;user-select:none;
}
thead th:hover{color:var(--text);background:var(--bg4);}
thead th.sorted{color:var(--gold);}
tbody tr{border-bottom:1px solid var(--border2);transition:background .1s;}
tbody tr:hover{background:var(--bg3);}
tbody tr:last-child{border-bottom:none;}
tbody td{padding:11px 14px;font-size:13px;color:var(--text);}
tbody td.mono{font-family:'IBM Plex Mono',monospace;font-size:12px;}
tbody td.muted{color:var(--text3);}

/* STATUS BADGES */
.status{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap;}
.status::before{content:'';width:5px;height:5px;border-radius:50%;}
.status.delivered{background:var(--green2);color:var(--green);}
.status.delivered::before{background:var(--green);}
.status.pending{background:var(--orange2);color:var(--orange);}
.status.pending::before{background:var(--orange);}
.status.processing{background:var(--blue2);color:var(--blue);}
.status.processing::before{background:var(--blue);}
.status.cancelled{background:var(--red2);color:var(--red);}
.status.cancelled::before{background:var(--red);}
.status.returned{background:var(--purple2);color:var(--purple);}
.status.returned::before{background:var(--purple);}
.status.intransit{background:rgba(227,179,65,.15);color:var(--orange);}
.status.intransit::before{background:var(--orange);}

/* PAYMENT BADGE */
.pay-badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;}
.pay-badge.cash{background:var(--green2);color:var(--green);}
.pay-badge.bkash{background:rgba(228,38,98,.15);color:#E42662;}
.pay-badge.nagad{background:rgba(246,139,31,.15);color:#F68B1F;}
.pay-badge.bank{background:var(--blue2);color:var(--blue);}
.pay-badge.cod{background:var(--gold3);color:var(--gold);}

/* INLINE EDIT CELL */
.editable{cursor:text;border-bottom:1px dashed transparent;transition:border-color .15s;padding:1px 3px;}
.editable:hover{border-color:var(--gold);}

/* PAGINATION */
.table-footer{
  padding:12px 20px;border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  font-size:12px;color:var(--text3);
}
.pagination{display:flex;gap:4px;}
.page-btn{
  width:28px;height:28px;border-radius:6px;border:1px solid var(--border);
  background:var(--bg3);color:var(--text2);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:12px;font-weight:600;
  transition:all .15s;
}
.page-btn:hover,.page-btn.active{background:var(--gold);border-color:var(--gold);color:#000;}

/* ═══════════════════════════════════════
   FORM / MODAL
═══════════════════════════════════════ */
.modal-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.7);
  z-index:500;display:none;align-items:center;justify-content:center;
  padding:20px;
}
.modal-overlay.open{display:flex;}
.modal{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:16px;width:100%;max-width:720px;max-height:90vh;overflow-y:auto;
  animation:slideUp .25s ease;
}
@keyframes slideUp{from{transform:translateY(30px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.modal-header{
  padding:20px 24px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;background:var(--bg2);z-index:1;
}
.modal-title{font-size:16px;font-weight:700;}
.modal-close{width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:var(--bg3);cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;color:var(--text2);transition:all .15s;}
.modal-close:hover{background:var(--red2);border-color:var(--red);color:var(--red);}
.modal-body{padding:24px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.form-grid.three{grid-template-columns:1fr 1fr 1fr;}
.form-group{display:flex;flex-direction:column;gap:6px;}
.form-group.full{grid-column:1/-1;}
.form-label{font-size:11px;font-weight:700;color:var(--text2);letter-spacing:.5px;text-transform:uppercase;}
.form-input,.form-select,.form-textarea{
  background:var(--bg3);border:1px solid var(--border);
  border-radius:8px;padding:9px 12px;
  color:var(--text);font-size:13px;
  font-family:'IBM Plex Sans',sans-serif;
  outline:none;transition:border .2s;width:100%;
}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,160,23,.1);}
.form-textarea{min-height:80px;resize:vertical;}
.form-input[readonly]{color:var(--text3);cursor:not-allowed;}
.modal-footer{padding:16px 24px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;}

/* ═══════════════════════════════════════
   INVENTORY CARDS
═══════════════════════════════════════ */
.inv-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
.inv-card{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:10px;padding:16px;
  transition:all .2s;cursor:pointer;
}
.inv-card:hover{border-color:var(--gold);transform:translateY(-2px);}
.inv-card.low{border-color:rgba(248,81,73,.4);}
.inv-product{font-size:13px;font-weight:700;margin-bottom:4px;}
.inv-sku{font-size:10px;color:var(--text3);font-family:'IBM Plex Mono',monospace;margin-bottom:12px;}
.inv-stat{display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;}
.inv-stat label{color:var(--text3);}
.inv-stat span{font-weight:600;font-family:'IBM Plex Mono',monospace;}
.stock-bar{height:4px;background:var(--bg3);border-radius:2px;margin-top:8px;overflow:hidden;}
.stock-fill{height:100%;border-radius:2px;transition:width .5s;}
.stock-fill.ok{background:var(--green);}
.stock-fill.warn{background:var(--orange);}
.stock-fill.low{background:var(--red);}
.low-badge{display:inline-block;background:var(--red2);border:1px solid rgba(248,81,73,.3);color:var(--red);font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;margin-top:6px;text-transform:uppercase;letter-spacing:.5px;}

/* ═══════════════════════════════════════
   ALERTS & TOASTS
═══════════════════════════════════════ */
.alert-box{
  padding:12px 16px;border-radius:10px;
  margin-bottom:16px;display:flex;align-items:flex-start;gap:10px;
  font-size:13px;
}
.alert-box.warn{background:var(--orange2);border:1px solid rgba(227,179,65,.3);color:var(--orange);}
.alert-box.danger{background:var(--red2);border:1px solid rgba(248,81,73,.3);color:var(--red);}
.alert-box.success{background:var(--green2);border:1px solid rgba(63,185,80,.3);color:var(--green);}
.alert-box.info{background:var(--blue2);border:1px solid rgba(56,139,253,.3);color:var(--blue);}

.toast-container{position:fixed;bottom:24px;right:24px;z-index:1000;display:flex;flex-direction:column;gap:8px;}
.toast{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:10px;padding:12px 16px;
  font-size:13px;display:flex;align-items:center;gap:10px;
  box-shadow:0 8px 32px rgba(0,0,0,.4);
  animation:toastIn .3s ease;
  min-width:260px;
}
.toast.success{border-left:3px solid var(--green);}
.toast.error{border-left:3px solid var(--red);}
.toast.info{border-left:3px solid var(--blue);}
@keyframes toastIn{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}

/* ═══════════════════════════════════════
   SECTION HEADERS
═══════════════════════════════════════ */
.section-head{margin-bottom:20px;}
.section-head h2{font-size:20px;font-weight:700;color:var(--text);margin-bottom:2px;}
.section-head p{font-size:13px;color:var(--text3);}
.breadcrumb{font-size:11px;color:var(--text3);margin-bottom:12px;}
.breadcrumb span{color:var(--gold);}

/* ═══════════════════════════════════════
   ARCHITECTURE PAGE
═══════════════════════════════════════ */
.arch-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;}
.arch-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:22px;}
.arch-card h3{font-size:14px;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
.step-list{display:flex;flex-direction:column;gap:10px;}
.step-row{display:flex;gap:12px;align-items:flex-start;}
.step-num{width:24px;height:24px;flex-shrink:0;background:var(--gold);color:#000;border-radius:6px;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;}
.step-text h5{font-size:13px;font-weight:600;margin-bottom:2px;}
.step-text p{font-size:12px;color:var(--text3);}
.step-text code{font-family:'IBM Plex Mono',monospace;font-size:11px;background:var(--bg3);padding:2px 6px;border-radius:4px;color:var(--blue);}

/* CODE BLOCKS IN ARCH */
.code-block{
  background:var(--bg);border:1px solid var(--border);
  border-radius:10px;overflow:hidden;margin:16px 0;
}
.code-block-header{
  background:var(--bg3);padding:8px 16px;
  display:flex;align-items:center;justify-content:space-between;
  font-size:11px;color:var(--text3);font-family:'IBM Plex Mono',monospace;
}
.code-block pre{padding:16px;font-family:'IBM Plex Mono',monospace;font-size:12px;color:#e2e8f0;line-height:1.7;overflow-x:auto;}
.code-block pre .kw{color:#FF79C6;}
.code-block pre .fn{color:#50FA7B;}
.code-block pre .st{color:#F1FA8C;}
.code-block pre .cm{color:#6272A4;font-style:italic;}
.copy-code-btn{background:var(--bg4);border:1px solid var(--border);color:var(--text3);font-size:10px;font-weight:600;padding:3px 10px;border-radius:4px;cursor:pointer;transition:all .15s;}
.copy-code-btn:hover{color:var(--gold);border-color:var(--gold);}
.copy-code-btn.ok{color:var(--green);}

/* FORMULA TABLE */
.formula-table-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:20px;}
.formula-table-wrap table{white-space:normal;}
.formula-table-wrap thead th{background:var(--bg3);font-size:11px;}
.formula-table-wrap tbody td{vertical-align:top;padding:12px 14px;}
.formula-table-wrap tbody td code{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--blue);background:var(--bg3);padding:2px 6px;border-radius:4px;display:inline-block;margin-top:2px;word-break:break-all;}

/* ROADMAP */
.roadmap{display:flex;flex-direction:column;gap:0;}
.road-phase{display:flex;gap:20px;position:relative;padding-bottom:32px;}
.road-phase:last-child{padding-bottom:0;}
.road-phase:last-child .road-line{display:none;}
.road-left{display:flex;flex-direction:column;align-items:center;width:40px;flex-shrink:0;}
.road-circle{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;flex-shrink:0;z-index:1;}
.road-line{width:2px;flex:1;margin-top:4px;background:var(--border);}
.road-content{padding-top:8px;flex:1;}
.road-content h4{font-size:15px;font-weight:700;margin-bottom:6px;}
.road-content p{font-size:13px;color:var(--text3);margin-bottom:10px;}
.road-tasks{display:flex;flex-wrap:wrap;gap:6px;}
.road-task{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:4px 10px;font-size:11px;color:var(--text2);}

/* ═══════════════════════════════════════
   EXPENSE PAGE
═══════════════════════════════════════ */
.expense-cats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
.exp-dcell{max-width:340px;min-width:180px;white-space:normal;}
.exp-clamp{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.55;word-break:break-word;cursor:pointer;}
.exp-readmore{display:inline-block;margin-top:3px;font-size:11px;color:var(--gold);cursor:pointer;font-weight:600;}
.exp-readmore:hover{text-decoration:underline;}
.exp-rinfo{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px 16px;padding:12px 14px;border:1px solid var(--border);border-radius:10px;margin-bottom:6px;font-size:13px;}
.exp-rinfo span{display:block;font-size:10.5px;color:var(--text3);text-transform:uppercase;letter-spacing:.3px;}
.exp-rh{font-weight:700;margin:16px 0 8px;font-size:13px;}
.exp-rtext{white-space:pre-wrap;word-break:break-word;line-height:1.9;font-size:14.5px;padding:12px 14px;background:var(--bg3,rgba(255,255,255,.04));border-radius:10px;border-left:3px solid var(--gold);}
.exp-rlist{display:flex;flex-direction:column;gap:8px;}
.exp-ritem{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;background:var(--bg3,rgba(255,255,255,.04));border-radius:10px;line-height:1.7;font-size:14px;word-break:break-word;}
.exp-rno{flex:0 0 24px;height:24px;border-radius:50%;background:rgba(212,160,23,.18);color:var(--gold);font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center;margin-top:2px;}
.exp-cat-card.exp-cat-click{position:relative;cursor:pointer;transition:transform .15s,border-color .15s,box-shadow .15s;}
.exp-cat-card.exp-cat-click:hover{transform:translateY(-2px);border-color:var(--gold);box-shadow:0 6px 18px rgba(212,160,23,.18);}
.exp-cat-card.active{border-color:var(--gold);box-shadow:0 0 0 2px rgba(212,160,23,.35);background:rgba(212,160,23,.07);}
.exp-cat-card .exp-more{position:absolute;right:8px;top:6px;font-size:9px;color:var(--gold);opacity:.8;}
.exp-cat-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;}
.exp-cat-icon{font-size:28px;margin-bottom:8px;}
.exp-cat-name{font-size:12px;font-weight:600;color:var(--text2);margin-bottom:4px;}
.exp-cat-amount{font-size:20px;font-weight:800;font-family:'IBM Plex Mono',monospace;color:var(--text);}
.exp-cat-pct{font-size:10px;color:var(--text3);margin-top:2px;}

/* ═══════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════ */
.menu-toggle{display:none;width:34px;height:34px;border-radius:8px;border:1px solid var(--border);background:var(--bg3);cursor:pointer;align-items:center;justify-content:center;font-size:16px;}

@media(max-width:1200px){
  .kpi-grid{grid-template-columns:repeat(2,1fr);}
  .inv-grid{grid-template-columns:repeat(2,1fr);}
  .expense-cats{grid-template-columns:repeat(2,1fr);}
}
@media(max-width:900px){
  .sidebar{transform:translateX(-100%);transition:transform .3s;}
  .sidebar.open{transform:translateX(0);box-shadow:4px 0 24px rgba(0,0,0,.5);}
  .main{margin-left:0;}
  .menu-toggle{display:flex;}
  .arch-grid{grid-template-columns:1fr;}
  .chart-row,.chart-row.three{grid-template-columns:1fr;}
  .partner-row{grid-template-columns:1fr;}
  .form-grid,.form-grid.three{grid-template-columns:1fr;}
  /* FIX 7: Backdrop overlay when sidebar is open on mobile */
  .sidebar-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:199;backdrop-filter:blur(2px);}
  .sidebar-backdrop.show{display:block;}
}
@media(max-width:600px){
  .kpi-grid{grid-template-columns:1fr;}
  .inv-grid{grid-template-columns:1fr;}
  .content{padding:12px 10px;}
  .kpi-value{font-size:22px;}
  .table-actions{width:100%;}
  /* FIX: ensure page content is always visible on mobile */
  .page { display:none !important; }
  .page.active { display:block !important; }
  /* PIN keypad mobile fix */
  .pin-key { height:52px; font-size:18px; }
  .pin-keypad { gap:8px; }
}
@media print{
  body > *:not(#modal-invoice){ display:none!important; }
  #modal-invoice{
    position:static!important;background:none!important;
    display:block!important;overflow:visible!important;
  }
  #modal-invoice .modal{
    box-shadow:none!important;border:none!important;
    max-width:100%!important;width:100%!important;
  }
  #modal-invoice .modal-header{ display:none!important; }
  #invoice-print-area{
    background:#fff!important;color:#000!important;
    padding:20px!important;
  }
  #invoice-print-area *{ color:inherit; }
  #invoice-print-area [style*="color:var(--gold)"]{ color:#8B6914!important; }
  #invoice-print-area [style*="color:var(--green)"]{ color:#1a7a2e!important; }
  #invoice-print-area [style*="color:var(--text3)"]{ color:#555!important; }
  #invoice-print-area table thead tr{ background:#1a3a6b!important; }
  #invoice-print-area #inv-brand-logo{ display:block!important; width:150px!important; height:auto!important; max-height:none!important; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  #invoice-print-area .inv-header-left{ display:flex!important; align-items:center!important; }
}
@keyframes flashAlert{
  from{ opacity:1; box-shadow:0 0 0 0 rgba(248,81,73,0); }
  to  { opacity:.85; box-shadow:0 0 0 4px rgba(248,81,73,.25); }
}

/* ═══════════════════════════════════════
   NOTIFICATION CENTER
═══════════════════════════════════════ */
.notif-wrapper{position:relative;}
.notif-count{
  position:absolute;top:-5px;right:-5px;
  background:var(--red);color:#fff;
  font-size:9px;font-weight:800;
  width:16px;height:16px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  border:2px solid var(--bg2);
  animation:pulse 2s infinite;
  z-index:5;
}
.notif-dropdown{
  position:absolute;top:calc(100% + 10px);right:0;
  width:340px;
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:14px;
  box-shadow:0 16px 48px rgba(0,0,0,.45);
  z-index:999;
  opacity:0;transform:translateY(-8px) scale(.97);
  pointer-events:none;
  transition:opacity .2s ease, transform .2s ease;
  overflow:hidden;
}
.notif-dropdown.open{
  opacity:1;transform:translateY(0) scale(1);
  pointer-events:all;
}
.notif-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 16px;
  border-bottom:1px solid var(--border);
  background:var(--bg3);
}
.notif-head-title{font-size:13px;font-weight:700;color:var(--text);}
.notif-mark-all{font-size:11px;color:var(--blue);cursor:pointer;font-weight:600;}
.notif-mark-all:hover{text-decoration:underline;}
.notif-list{display:flex;flex-direction:column;max-height:340px;overflow-y:auto;}
.notif-list::-webkit-scrollbar{width:4px;}
.notif-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
.notif-item{
  display:flex;align-items:flex-start;gap:10px;
  padding:12px 16px;
  border-bottom:1px solid var(--border2);
  cursor:pointer;
  transition:background .15s;
  position:relative;
}
.notif-item:last-child{border-bottom:none;}
.notif-item:hover{background:var(--bg3);}
.notif-item.unread{background:rgba(56,139,253,.05);}
.notif-item.unread::before{
  content:'';position:absolute;left:0;top:0;bottom:0;
  width:3px;background:var(--blue);border-radius:0 2px 2px 0;
}
.notif-icon{
  width:34px;height:34px;border-radius:10px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:15px;
}
.notif-icon.login{background:rgba(56,139,253,.15);}
.notif-icon.stock{background:rgba(248,81,73,.15);}
.notif-icon.delivery{background:rgba(63,185,80,.15);}
.notif-icon.order{background:rgba(212,160,23,.15);}
.notif-icon.alert{background:rgba(227,179,65,.15);}
.notif-body{flex:1;min-width:0;}
.notif-msg{font-size:12px;color:var(--text);line-height:1.4;margin-bottom:3px;}
.notif-msg strong{color:var(--text);font-weight:700;}
.notif-time{font-size:10px;color:var(--text3);}
.notif-footer{
  padding:10px 16px;
  background:var(--bg3);
  border-top:1px solid var(--border);
  text-align:center;
  font-size:11px;color:var(--blue);
  cursor:pointer;font-weight:600;
}
.notif-footer:hover{background:var(--bg4);}

/* ═══════════════════════════════════════
   THEME TOGGLE BUTTON
═══════════════════════════════════════ */
.theme-toggle-btn{
  width:60px;height:30px;
  border-radius:15px;border:1px solid var(--border);
  background:var(--bg3);
  cursor:pointer;position:relative;
  transition:all .3s;flex-shrink:0;
  overflow:hidden;
}
.theme-toggle-btn::before{
  content:'';
  position:absolute;top:3px;left:3px;
  width:22px;height:22px;border-radius:50%;
  background:var(--gold);
  transition:transform .3s ease, background .3s;
  box-shadow:0 2px 6px rgba(0,0,0,.3);
}
.light .theme-toggle-btn::before{
  transform:translateX(30px);
  background:var(--gold);
}
.theme-icon-sun, .theme-icon-moon{
  position:absolute;top:50%;font-size:12px;
  transform:translateY(-50%);
  transition:opacity .2s;
}
.theme-icon-sun{right:7px;opacity:0;}
.theme-icon-moon{left:7px;opacity:1;}
.light .theme-icon-sun{opacity:1;}
.light .theme-icon-moon{opacity:0;}

/* ═══════════════════════════════════════
   EXPORT BUTTONS
═══════════════════════════════════════ */
.btn.export-excel{
  background:rgba(34,197,94,.15);
  border-color:rgba(34,197,94,.4);
  color:#22c55e;
}
.btn.export-excel:hover{background:rgba(34,197,94,.25);}
.btn.export-pdf{
  background:rgba(248,81,73,.12);
  border-color:rgba(248,81,73,.35);
  color:var(--red);
}
.btn.export-pdf:hover{background:rgba(248,81,73,.22);}

/* Chart.js canvas wrapper */
.chartjs-wrap{
  position:relative;
  height:220px;
  width:100%;
}

/* ═══════════════════════════════════════
   PRODUCT PROFIT SPLIT STYLES (v31)
═══════════════════════════════════════ */
.profit-split-section{
  grid-column:1/-1;
  background:linear-gradient(135deg,rgba(212,160,23,.08),rgba(212,160,23,.03));
  border:1px solid rgba(212,160,23,.25);
  border-radius:12px;
  padding:18px;
  margin-top:4px;
}
.profit-split-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:14px;flex-wrap:wrap;gap:8px;
}
.profit-split-title{
  font-size:12px;font-weight:700;color:var(--gold);
  letter-spacing:1px;text-transform:uppercase;
  display:flex;align-items:center;gap:6px;
}
.equal-split-btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 14px;border-radius:20px;
  background:linear-gradient(135deg,var(--gold),#8B6914);
  border:none;color:#000;font-size:12px;font-weight:700;
  cursor:pointer;font-family:'IBM Plex Sans',sans-serif;
  box-shadow:0 2px 8px rgba(212,160,23,.3);
  transition:all .2s;white-space:nowrap;
}
.equal-split-btn:hover{box-shadow:0 4px 14px rgba(212,160,23,.5);transform:translateY(-1px);}
.equal-split-btn:active{transform:translateY(0);}
.split-partners-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:12px;
  margin-bottom:14px;
}
.split-partner-box{
  background:var(--bg3);border:1px solid var(--border);
  border-radius:10px;padding:12px;
  display:flex;flex-direction:column;gap:8px;
  transition:border-color .2s;
}
.split-partner-box:hover{border-color:var(--gold);}
.split-partner-box.ismail-box{border-color:rgba(56,139,253,.3);}
.split-partner-box.ashik-box{border-color:rgba(63,185,80,.3);}

.split-partner-label{
  font-size:10px;font-weight:700;letter-spacing:.8px;
  text-transform:uppercase;display:flex;align-items:center;gap:6px;
}
.split-partner-label .p-dot{flex-shrink:0;}
.split-input-wrap{position:relative;}
.split-input-wrap input{
  width:100%;background:var(--bg2);border:1px solid var(--border);
  border-radius:8px;padding:8px 30px 8px 10px;
  color:var(--text);font-size:15px;font-weight:700;
  font-family:'IBM Plex Mono',monospace;
  outline:none;transition:border .2s;
}
.split-input-wrap input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,160,23,.1);}
.split-pct-sign{
  position:absolute;right:10px;top:50%;transform:translateY(-50%);
  font-size:13px;font-weight:700;color:var(--text3);
  pointer-events:none;
}
.company-fund-preview{
  background:var(--bg4);border:1px solid var(--border);
  border-radius:10px;padding:12px 16px;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:10px;
}
.company-fund-info{
  display:flex;align-items:center;gap:10px;
}
.company-fund-icon{
  width:34px;height:34px;border-radius:8px;
  background:rgba(212,160,23,.15);
  display:flex;align-items:center;justify-content:center;
  font-size:18px;flex-shrink:0;
}
.company-fund-text small{font-size:10px;color:var(--text3);display:block;text-transform:uppercase;letter-spacing:.8px;margin-bottom:2px;}
.company-fund-pct{font-size:20px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:var(--gold);}
.split-total-info{
  display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;
}
.split-total-info span{font-family:'IBM Plex Mono',monospace;}

/* Profit split badge in inventory table */
.profit-split-badge{
  display:flex;align-items:center;gap:4px;
  flex-wrap:wrap;margin-top:3px;
}
.psb-chip{
  display:inline-flex;align-items:center;gap:3px;
  padding:1px 6px;border-radius:4px;
  font-size:9px;font-weight:700;font-family:'IBM Plex Mono',monospace;
  letter-spacing:.3px;
}
.psb-chip.ismail{background:rgba(56,139,253,.15);color:var(--blue);}
.psb-chip.ashik{background:rgba(63,185,80,.15);color:var(--green);}

.psb-chip.company{background:rgba(212,160,23,.15);color:var(--gold);}
/* ═══════════════════════════════════════
   FIX 4 — PIN LOCK SYSTEM
═══════════════════════════════════════ */
#lock-screen {
  position:fixed;inset:0;
  background:var(--bg);
  z-index:9999;
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;
  /* OPT-1: display:none এর বদলে opacity — GPU layer maintain হয়, layout thrash নেই */
  opacity:1;
  visibility:visible;
  transition:opacity 0.2s ease, visibility 0.2s ease;
  pointer-events:auto;
}
#lock-screen.hidden {
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  /* display:none সরানো হয়েছে — এটাই freeze করত */
}
.lock-box {
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:20px;
  padding:40px 32px;
  width:320px;
  text-align:center;
  box-shadow:0 20px 60px rgba(0,0,0,.5);
}
.lock-logo { font-size:40px; margin-bottom:14px; display:flex; justify-content:center; }
.lock-logo .innogix-logo-img{width:150px;}
.lock-title { font-size:18px; font-weight:700; color:var(--text); margin-bottom:4px; }
.lock-sub { font-size:12px; color:var(--text3); margin-bottom:28px; }
.pin-dots { display:flex; justify-content:center; gap:14px; margin-bottom:28px; }
.pin-dot {
  width:14px; height:14px; border-radius:50%;
  border:2px solid var(--border);
  background:transparent;
  transition:all .2s;
}
.pin-dot.filled { background:var(--gold); border-color:var(--gold); box-shadow:0 0 8px rgba(212,160,23,.5); }
.pin-dot.error { background:var(--red); border-color:var(--red); }
.pin-keypad {
