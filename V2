    { const dg = groups.filter(g => g.tracked && g.due > 0); $('pt-k-due').textContent = money(dg.reduce((s, g) => s + Math.round(g.due * 100), 0) / 100); $('pt-k-due-sub').textContent = dg.length ? `${dg.length}টি ক্রয়ে বাকি (শুধু রেকর্ড)` : (groups.some(g => g.tracked) ? 'কোনো বাকি নেই ✅' : 'পরিশোধ ট্র্যাক করা ক্রয় নেই'); }
    $('pt-count').textContent = `${groups.length}টি ক্রয় · ${items}টি পণ্য`; renderChart();
    const pages = Math.max(1, Math.ceil(groups.length / PT.per)); if (PT.page > pages) PT.page = pages;
    const slice = groups.slice((PT.page - 1) * PT.per, PT.page * PT.per), body = $('pt-body'), pager = $('pt-pager');
