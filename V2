      else
        invSub.textContent = `${data.invActiveCount || 0} জন Active Investor`;
    }
  }

  // ── Bug 3 Fix: Dynamic % change from monthly chart data ──
  const chart = data.monthlyChart;
  if(chart && chart.revenue && chart.revenue.length >= 2){
    const len = chart.revenue.length;
    const curRev  = chart.revenue[len-1]  || 0;
    const prevRev = chart.revenue[len-2]  || 0;
    const curProf = chart.profit[len-1]   || 0;
    const prevProf= chart.profit[len-2]   || 0;
    const curExp  = (data.expBreakdown||[]).reduce((s,e)=>s+e.amount,0);
    const prevExp = chart.revenue.length >= 2 ? (chart.revenue[len-2] - (chart.profit[len-2]||0)) : 0;
    setChange('kpi-revenue-change', curRev,  prevRev);
    setChange('kpi-profit-change',  curProf, prevProf);
    setChange('kpi-expense-change', curExp,  prevExp);
    // Due: compare current total due vs delivered count change
    const curDel  = Number(data.delivered)||0;
    const kpiDue  = document.getElementById('kpi-due-change');
    if(kpiDue){ kpiDue.textContent = totalDue > 0 ? '৳'+fmt(totalDue)+' বাকি আছে' : '✅ কোনো বাকি নেই'; kpiDue.className='kpi-change '+(totalDue>0?'down':'up'); }
  }

  // ── Bug 4 Fix: Total Due — sum ALL due from sales (not just delivered) ──
  // Backend already sends correct due. If 0 but sales have due, recalc from liveSalesData
  if(totalDue === 0 && liveSalesData && liveSalesData.length > 0){
    const realDue = liveSalesData.reduce((s,r)=>{
      const d = parseFloat(String(r.due||'').replace(/[^0-9.-]/g,''))||0;
      const st = String(r.status||'').trim();
      // Count due for non-cancelled, non-returned orders
      if(st !== 'Cancelled' && st !== 'Returned') return s + d;
      return s;
    }, 0);
    if(realDue > 0) setEl('kpi-due', fmt(realDue));
  }

  // ── Top Region — from live sales, this month ──
  (async () => {
    let salesRows = liveSalesData;
    if (!salesRows || salesRows.length === 0) {
      try {
        const sd = await fetchFromAPI('sales');
        if (sd && sd.data) salesRows = sd.data.map(r=>({div:String(r[5]||''),status:String(r[16]||''),rawDateISO:String(r[1]||'')}));
      } catch(e) { salesRows = []; }
    }
    if (salesRows && salesRows.length > 0) {
      // BUG #5 FIX (v33): আগে nowMonth define করা হতো কিন্তু filter-এ ব্যবহার হতো না।
      // ফলে সব সময়ের data দিয়ে "orders this month" দেখাতো — misleading।
      // এখন rawDateISO দিয়ে এই মাস ও বছর match করে filter করা হচ্ছে।
      const now      = new Date();
      const nowMonth = now.getMonth();        // 0-indexed
      const nowYear  = now.getFullYear();
      const regionCount = {};
      let   thisMonthTotal = 0;
      salesRows.forEach(r => {
        const region = String(r.div || '').trim();
        if (!region) return;
        // Date match: rawDateISO বা rawDate থেকে মাস/বছর বের করো
        let inThisMonth = false;
        try {
          const raw = r.rawDateISO || r.rawDate || '';
          if (raw) {
            const d = new Date(raw);
            if (!isNaN(d.getTime())) {
              inThisMonth = (d.getMonth() === nowMonth && d.getFullYear() === nowYear);
            } else {
              // "31-May-2026" format — parse manually
              const parts = String(raw).split('-');
              if (parts.length === 3) {
                const months = {Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
                const m = months[parts[1]];
                const y = parseInt(parts[2]);
                inThisMonth = (m === nowMonth && y === nowYear);
              }
            }
          } else {
            inThisMonth = true; // date নেই, তাহলে count করো
          }
        } catch(de) { inThisMonth = true; }
        if (inThisMonth) {
          regionCount[region] = (regionCount[region] || 0) + 1;
          thisMonthTotal++;
        }
      });
      if(Object.keys(regionCount).length > 0){
        const topRegion = Object.keys(regionCount).reduce((a,b)=>regionCount[b]>regionCount[a]?b:a, Object.keys(regionCount)[0]);
        const topCount = regionCount[topRegion] || 0;
        setEl('kpi-top-region', topRegion || '—');
        setEl('kpi-top-region-sub', topCount + ' orders this month');
      } else {
        // এই মাসে কোনো data নেই — সব সময়ের top region দেখাও
        const allCount = {};
        salesRows.forEach(r => {
          const region = String(r.div || '').trim();
          if (region) allCount[region] = (allCount[region] || 0) + 1;
        });
        if (Object.keys(allCount).length > 0) {
          const topAll = Object.keys(allCount).reduce((a,b)=>allCount[b]>allCount[a]?b:a, Object.keys(allCount)[0]);
          setEl('kpi-top-region', topAll || '—');
          setEl('kpi-top-region-sub', allCount[topAll] + ' orders (all time)');
        } else {
          setEl('kpi-top-region', '—'); setEl('kpi-top-region-sub', 'No data');
        }
      }
    }
  })();

  // ── Partner balances — calculated server-side via JS SUMIFS (no REF! errors) ──
  setEl('ismail-inv', '৳' + fmt(data.ismail_inv));
  setEl('ismail-drw', '৳' + fmt(data.ismail_drw));
  setEl('ismail-bal', '৳' + fmt(data.ismail_bal));
  setEl('ashik-inv',  '৳' + fmt(data.ashik_inv));
  setEl('ashik-drw',  '৳' + fmt(data.ashik_drw));
  setEl('ashik-bal',  '৳' + fmt(data.ashik_bal));

  // ── Charts: pass live backend data to drawChart ──────────────
  // This replaces the hardcoded demo bars/donut with real Sheet data.
  drawChart(data);

  showToast('Live data updated ✅', 'success');
}
async function loadLiveSales(){
  const data=await fetchFromAPI('sales'); if(!data||!data.data) return;
  // Determine whether first row is a header row (strings like "ID","Date","Customer"…)
  // If it looks like a header, skip it; otherwise include all rows
  const rawRows = data.data;
  const firstRow = rawRows[0] || [];
  const isHeader = firstRow.length > 0 && typeof firstRow[0] === 'string' &&
    (String(firstRow[0]).toLowerCase().includes('id') ||
     String(firstRow[0]).toLowerCase().includes('order') ||
     String(firstRow[0]).toLowerCase() === '#' ||
     String(firstRow[1]||'').toLowerCase().includes('date') ||
     String(firstRow[3]||'').toLowerCase().includes('customer'));
  const rowsToProcess = isHeader ? rawRows.slice(1) : rawRows;
  const rows=rowsToProcess.map((r,i)=>{
    // Parse date/time — Col B = date string (dd-MMM-yyyy), Col C = time string (HH:mm:ss)
    // FIX v24: rawTime may come as a Date object if Sheets auto-converted the time string
    // to a serial number (happens when Col C has no @TEXT format set)
    let dateStr='', timeStr='';
    const rawDT = r[1]||'';
    let rawTime = r[2]||'';
    // Normalize rawTime: if it's a Date object, extract HH:mm from it
    if(rawTime && typeof rawTime === 'object' && rawTime instanceof Date){
      // Sheets time serial returned as Date — extract hours/minutes in BD timezone
      try {
        const hh = rawTime.getUTCHours();
        const mm = rawTime.getUTCMinutes();
        rawTime = String(hh).padStart(2,'0') + ':' + String(mm).padStart(2,'0') + ':00';
      } catch(e){ rawTime = ''; }
    } else if(rawTime && typeof rawTime === 'number'){
      // Time serial as fraction (0.629... = 15:07) → convert to HH:mm
      const totalSec = Math.round(rawTime * 86400);
      const hh = Math.floor(totalSec / 3600) % 24;
      const mm = Math.floor((totalSec % 3600) / 60);
      rawTime = String(hh).padStart(2,'0') + ':' + String(mm).padStart(2,'0') + ':00';
    } else {
      rawTime = String(rawTime||'');
    }
    if(rawDT){
      try{
        if(typeof rawDT==='number'){
          // Google Sheets serial date (days since Dec 30 1899)
          const dt=new Date((rawDT-25569)*86400*1000);
          const opts={timeZone:'Asia/Dhaka'};
          dateStr=new Intl.DateTimeFormat('en-BD',{...opts,day:'2-digit',month:'short',year:'numeric'}).format(dt);
          timeStr=rawTime||new Intl.DateTimeFormat('en-BD',{...opts,hour:'2-digit',minute:'2-digit',hour12:true}).format(dt);
        } else if(String(rawDT).includes('T') && String(rawDT).includes('Z')){
          // Google Sheets sent a Date object as ISO string e.g. "2026-05-28T18:00:00.000Z"
          // Extract date portion only — do NOT use time from this ISO (it's UTC, not BD)
          const isoDate = new Date(rawDT);
          const opts={timeZone:'Asia/Dhaka'};
          dateStr=new Intl.DateTimeFormat('en-BD',{...opts,day:'2-digit',month:'short',year:'numeric'}).format(isoDate);
          // Time must come from Col C (rawTime), NOT from ISO string
          if(rawTime){
            try{
              const [hh,mm]=rawTime.split(':');
              const h=parseInt(hh,10), m=parseInt(mm,10);
              const ampm=h>=12?'PM':'AM';
              const h12=h%12||12;
              timeStr=`${String(h12).padStart(2,'0')}:${String(m).padStart(2,'0')} ${ampm}`;
            } catch(te){ timeStr=rawTime; }
          } else { timeStr=''; }
