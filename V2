  const fromInventory = (liveInventoryData||[]).map(p => (p.name||'').trim());
  const fromSales = (liveSalesData||[]).map(r => (r.product||'').trim());
  const names = Array.from(new Set([...fromInventory, ...fromSales].filter(Boolean)))
    .sort((a,b) => a.localeCompare(b));
