function renderInvestors(rows) {
  const tbody = el('investor-body');
  if (!tbody) return;
  el('inv-list-count') && (el('inv-list-count').textContent = rows.length + ' investors');
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--text3);padding:40px;">কোনো Investor নেই। \"+ নতুন Investor\" বাটনে ক্লিক করুন।</td></tr>';
    return;
  }
  const statusColor = { 'Active':'var(--green)', 'Exited':'var(--text3)', 'Inactive':'var(--red)' };

  // Date formatter — handles ISO string, serial number, plain text
  const fmtDate = raw => {
    if(!raw) return '—';
    try {
      let d;
      if(typeof raw === 'number') d = new Date((raw - 25569) * 86400 * 1000);
      else { const s = String(raw); d = new Date(s); }
      if(isNaN(d.getTime())) return String(raw);
      return new Intl.DateTimeFormat('en-BD',{timeZone:'Asia/Dhaka',day:'2-digit',month:'short',year:'numeric'}).format(d);
    } catch(e){ return String(raw); }
  };

  tbody.innerHTML = rows.map(r => {
    const id=r[0],name=r[1],phone=String(r[2]||'').trim(),rawDate=r[3],amt=Number(r[4])||0,pct=Number(r[5])||0,cycle=r[6],status=r[7];
    const invType    = r[9] || 'Equity';
    const profitRate = Number(r[10])||0;
    const ratePeriod = String(r[19]||'Monthly') === 'Yearly' ? 'Yearly' : 'Monthly';
    const isYr = ratePeriod === 'Yearly';
    const duration   = Number(r[11])||0;
    const dueAmt     = Number(r[13])||0;
    const nextDueDate     = r[14] || '';
    const isOverdue       = r[15] === true;
    const durationDaysLeft= r[17];
    const durationStatus  = r[18] || '';
    const color = statusColor[status] || 'var(--text3)';
    const dateStr = fmtDate(rawDate);

    const typeTag = invType === 'Fixed Return'
      ? `<span style="background:rgba(245,180,0,.15);color:var(--gold);border-radius:4px;padding:2px 6px;font-size:10px;font-weight:700;">💰 Fixed ${profitRate}%/${isYr?'yr':'mo'}</span>`
      : `<span style="background:rgba(52,209,116,.12);color:var(--green);border-radius:4px;padding:2px 6px;font-size:10px;font-weight:700;">📊 Equity</span>`;
    const pctOrRate = invType === 'Fixed Return'
      ? `<span style="color:var(--gold);font-size:12px;">৳${fmt(Math.round(amt*profitRate/100))}/${isYr?'বছর':'মাস'}</span>${isYr?`<div style="font-size:10px;color:var(--text3);">≈ ৳${fmt(Math.round(amt*profitRate/1200))}/মাস</div>`:''}`
      : `<span style="color:var(--green);font-weight:700;cursor:help;" title="৳${fmt(amt)} ÷ ৳${fmt(_equityPoolTotal)} (মোট Equity Pool) × ১০০ = ${pct.toFixed(2)}%">${pct.toFixed(2)}% ℹ️</span>`;

    let dueCell = `<span style="color:var(--text3);font-size:11px;">—</span>`;
    if (invType === 'Fixed Return') {
      const parts = [];
      if (dueAmt > 0) parts.push(`<span style="color:var(--red);font-size:11px;font-weight:600;">⚠️ বকেয়া ৳${fmt(dueAmt)}</span>`);
      if (isOverdue) parts.push(`<span title="পেমেন্ট সাইকেল অনুযায়ী ${fmtDate(nextDueDate)} তারিখেই দেওয়ার কথা ছিল" style="cursor:help;background:rgba(248,81,73,.15);color:var(--red);border-radius:4px;padding:1px 5px;font-size:10px;font-weight:700;">🔔 Payment Overdue</span>`);
      else if (nextDueDate) parts.push(`<span style="font-size:10px;color:var(--text3);">পরবর্তী: ${fmtDate(nextDueDate)}</span>`);
      if (durationStatus === 'overdue') parts.push(`<span title="মেয়াদ ${fmtDate(r[16])} তারিখে শেষ হয়ে গেছে — মূল টাকা ফেরত/রিনিউ দরকার" style="cursor:help;background:rgba(248,81,73,.15);color:var(--red);border-radius:4px;padding:1px 5px;font-size:10px;font-weight:700;">🔴 মেয়াদ শেষ</span>`);
      else if (durationStatus === 'ending_soon') parts.push(`<span title="মেয়াদ শেষ হবে ${fmtDate(r[16])} তারিখে" style="cursor:help;background:rgba(245,180,0,.15);color:var(--gold);border-radius:4px;padding:1px 5px;font-size:10px;font-weight:700;">⚠️ মেয়াদ শেষ হচ্ছে (${durationDaysLeft}দিন)</span>`);
      if (parts.length) dueCell = `<div style="display:flex;flex-direction:column;gap:3px;align-items:flex-start;">${parts.join('')}</div>`;
    }

    // Data for edit/delete
    const invData = JSON.stringify({id,name,phone,date:dateStr,amt,pct,cycle,status,invType,profitRate,ratePeriod,duration});

    return `<tr>
      <td class="mono" style="color:var(--text3);font-size:11px;">${id}</td>
      <td>
        <div style="font-weight:600;color:var(--text);">${name}</div>
        <div style="margin-top:3px;">${typeTag}</div>
      </td>
      <td style="font-size:13px;">${phone || '<span style="color:var(--text3)">—</span>'}</td>
      <td style="font-size:12px;color:var(--text3);">${dateStr}</td>
      <td style="color:var(--gold);font-weight:600;">৳${fmt(amt)}</td>
      <td>${pctOrRate}</td>
      <td>${dueCell}</td>
      <td style="font-size:12px;">${cycle||'—'}</td>
      <td><span style="color:${color};font-weight:600;font-size:12px;">${status||'—'}</span></td>
      <td>
        <div style="display:flex;gap:5px;flex-wrap:wrap;">
          <button class="btn btn-sm" style="font-size:11px;" onclick='openPayProfit(${JSON.stringify({id,name,amt,pct,invType,profitRate,ratePeriod,dueAmt})})'>💰 Profit</button>
          <button class="btn btn-sm" style="font-size:11px;" onclick='openBuyback(${JSON.stringify({id,name,amt,pct})})'>🔄 Buyback</button>
          <button class="btn btn-sm" style="font-size:11px;" onclick="viewInvestorReport('${id}')">📊 Report</button>
          <button class="btn btn-sm" style="font-size:11px;background:rgba(56,139,253,.15);color:#58a6ff;border-color:rgba(56,139,253,.3);" onclick='openEditInvestor(${invData})'>✏️ Edit</button>
          <button class="btn btn-sm" style="font-size:11px;background:rgba(248,81,73,.1);color:var(--red);border-color:rgba(248,81,73,.3);" onclick="confirmDeleteInvestor('${id}','${name}')">🗑 Delete</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

