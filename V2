    ['weekly','monthly','yearly'].forEach(function(t){
      var el=document.getElementById('fa-tab-'+t);
      if(el) el.style.opacity=(_allTime||_selYear>0||_selMonth>0)?'0.45':'1';
    });
  }

  // ── Public API ──
  window._faTab=function(period){
    _period=period;
    _allTime=false;
    _selYear=0;
    _selMonth=0;
    // Reset dropdowns
    var ySel=document.getElementById('fa-year-sel');
    var mSel=document.getElementById('fa-month-sel');
    if(ySel) ySel.value='0';
    if(mSel) mSel.value='0';
    // Update tab active states
    ['weekly','monthly','yearly'].forEach(function(t){
      var el=document.getElementById('fa-tab-'+t);
      if(!el) return;
      el.classList.toggle('active',t===period);
      el.setAttribute('data-accent',_accent);
    });
    _updateFaFilterUI();
    render();
  };

  window._faSetAllTime=function(){
    _allTime=!_allTime;
    if(_allTime){
      _selYear=0; _selMonth=0;
      var ySel=document.getElementById('fa-year-sel');
      var mSel=document.getElementById('fa-month-sel');
      if(ySel) ySel.value='0';
      if(mSel) mSel.value='0';
      // Deactivate period tabs visually
      ['weekly','monthly','yearly'].forEach(function(t){
        var el=document.getElementById('fa-tab-'+t);
        if(el) el.classList.remove('active');
      });
    } else {
      // Restore monthly tab
      _period='monthly';
      var el=document.getElementById('fa-tab-monthly');
      if(el) el.classList.add('active');
    }
    _updateFaFilterUI();
    render();
  };

  window._faDropdownChange=function(){
    var ySel=document.getElementById('fa-year-sel');
    var mSel=document.getElementById('fa-month-sel');
    _selYear = ySel ? parseInt(ySel.value)||0 : 0;
    _selMonth= mSel ? parseInt(mSel.value)||0 : 0;
    if(_selYear>0||_selMonth>0){
      _allTime=false;
      // Deactivate period tabs
      ['weekly','monthly','yearly'].forEach(function(t){
        var el=document.getElementById('fa-tab-'+t);
        if(el) el.classList.remove('active');
      });
    } else {
      // If both reset to 0, go back to monthly
      _period='monthly';
      var el=document.getElementById('fa-tab-monthly');
      if(el) el.classList.add('active');
    }
    _updateFaFilterUI();
    render();
  };

  window.openFinAnalytics=function(type){
    _type   = type||'revenue';
    _period = 'monthly';
    _accent = type==='profit'?'gold':'green';
    _allTime= false;
    _selYear= 0;
    _selMonth=0;

    var modal=document.getElementById('modal-fin-analytics');
    var titleEl=document.getElementById('fa-title');
    if(!modal||!titleEl) return;

    titleEl.textContent = type==='profit'
      ? '📈 Net Profit — আর্থিক বিশ্লেষণ'
      : '💰 Total Revenue — আর্থিক বিশ্লেষণ';

    // Reset all tabs, set Monthly active with correct accent
    ['weekly','monthly','yearly'].forEach(function(t){
      var el=document.getElementById('fa-tab-'+t);
      if(!el) return;
      el.classList.remove('active');
      el.setAttribute('data-accent',_accent);
      if(t==='monthly') el.classList.add('active');
      el.style.opacity='1';
    });

    // Reset dropdowns
    var ySel=document.getElementById('fa-year-sel');
    var mSel=document.getElementById('fa-month-sel');
    var aBtn=document.getElementById('fa-alltime-btn');
    if(ySel){ ySel.value='0'; ySel.disabled=false; ySel.style.opacity='1'; }
    if(mSel){ mSel.value='0'; mSel.disabled=false; mSel.style.opacity='1'; }
    if(aBtn) aBtn.classList.remove('active');

    // Populate years
    _populateYears();

    modal.classList.add('open');
    document.body.style.overflow='hidden';
    render();
  };

  window._faClose=function(){
    var modal=document.getElementById('modal-fin-analytics');
    if(modal) modal.classList.remove('open');
    document.body.style.overflow='';
  };

  // Escape key support
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&document.getElementById('modal-fin-analytics')?.classList.contains('open')){
      window._faClose();
    }
  });

})();

