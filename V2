// ═══════════════════════════════════════════════════════════════
// 💸 COD চার্জ চার্ট (কুরিয়ার ম্যানেজার হাব) — দৈনিক / সাপ্তাহিক / মাসিক / বার্ষিক + সময়কাল, কুরিয়ার ও স্ট্যাটাস ফিল্টার
//  • শুধু বিদ্যমান buildCourierData() ফলাফল পড়ে — কোনো ডেটা/হিসাব বদলায় না
//  • সপ্তাহ শনিবার থেকে শুরু (বাংলাদেশের সপ্তাহ)
// ═══════════════════════════════════════════════════════════════
const CODC = { group: 'month', period: 'all', from: '', to: '', courier: '', status: 'delivered', built: false };
function _codcIso(v){ try { return (window.__igxCsv && window.__igxCsv.parseDateAny(String(v||'').trim())) || ''; } catch(e){ return ''; } }
function _codcUTC(iso){ const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(iso); return m ? Date.UTC(+m[1], +m[2]-1, +m[3]) : NaN; }
function _codcIsoOf(ms){ const d=new Date(ms); return d.getUTCFullYear()+'-'+String(d.getUTCMonth()+1).padStart(2,'0')+'-'+String(d.getUTCDate()).padStart(2,'0'); }
function _codcWeekStart(iso){ const ms=_codcUTC(iso), dow=new Date(ms).getUTCDay(); return _codcIsoOf(ms - ((dow+1)%7)*86400000); }   // শনি=0 … শুক্র=6
function _codcToday(){ try { return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Dhaka'}).format(new Date()); } catch(e){ return new Date().toISOString().slice(0,10); } }
const _CODC_MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function _codcLbl(key, group){
  if (group==='year') return key;
  if (group==='month') { const [y,m]=key.split('-'); return _CODC_MON[+m-1]+' '+y; }
  const f = iso => { const [y,m,d]=iso.split('-'); return d+' '+_CODC_MON[+m-1]; };
  if (group==='week') return f(key)+'–'+f(_codcIsoOf(_codcUTC(key)+6*86400000));
  return f(key)+' '+key.slice(0,4);
}
function _codcKey(iso, group){ return group==='year' ? iso.slice(0,4) : group==='month' ? iso.slice(0,7) : group==='week' ? _codcWeekStart(iso) : iso; }
function _codcNext(key, group){
  if (group==='year') return String(+key+1);
  if (group==='month') { let [y,m]=key.split('-').map(Number); m++; if(m>12){m=1;y++;} return y+'-'+String(m).padStart(2,'0'); }
  return _codcIsoOf(_codcUTC(key) + (group==='week'?7:1)*86400000);
}
function _codcRange(){
  const t=_codcToday(); let from='', to='';
  if (CODC.period==='week') { from=_codcWeekStart(t); to=_codcIsoOf(_codcUTC(from)+6*86400000); }
  else if (CODC.period==='month') { from=t.slice(0,7)+'-01'; to=t.slice(0,7)+'-31'; }
  else if (CODC.period==='year') { from=t.slice(0,4)+'-01-01'; to=t.slice(0,4)+'-12-31'; }
  else if (CODC.period==='last30') { from=_codcIsoOf(_codcUTC(t)-29*86400000); to=t; }
  else if (CODC.period==='custom') { from=CODC.from; to=CODC.to; }
  return {from, to};
}
function _codcSet(k, v){ CODC[k]=v; if (k==='period') { const c=document.getElementById('codc-custom'); if(c) c.style.display = v==='custom' ? 'flex' : 'none'; } renderCODChart(window._lastCourierData); }
function renderCODChart(data){
  const el = document.getElementById('cod-chart-widget'); if (!el) return;
  data = data || window._lastCourierData || {};
  if (!CODC.built) {
    const sel=(id,key,opts)=>`<select class="form-select" id="${id}" onchange="_codcSet('${key}',this.value)" style="min-width:120px;">${opts.map(([v,l])=>`<option value="${v}"${CODC[key]===v?' selected':''}>${l}</option>`).join('')}</select>`;
    const couriers = Object.keys(data).length ? Object.keys(data) : Object.keys(COURIER_CONFIG||{});
    el.innerHTML = `<div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;overflow:hidden;">
      <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <span style="font-weight:700;color:var(--text);">📊 COD চার্জ চার্ট <span style="font-weight:400;font-size:12px;color:var(--text3);">— কুরিয়ারকে কত টাকা COD চার্জ গেছে</span></span>
        <span id="codc-count" style="font-size:12px;color:var(--text3);"></span>
      </div>
      <div style="padding:12px 18px;display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;border-bottom:1px solid var(--border);">
        <div><div style="font-size:11px;color:var(--text3);margin-bottom:3px;">গ্রুপ</div>${sel('codc-group','group',[['day','দৈনিক'],['week','সাপ্তাহিক'],['month','মাসিক'],['year','বার্ষিক']])}</div>
        <div><div style="font-size:11px;color:var(--text3);margin-bottom:3px;">সময়কাল</div>${sel('codc-period','period',[['all','সব সময়'],['week','এই সপ্তাহ'],['month','এই মাস'],['year','এই বছর'],['last30','গত ৩০ দিন'],['custom','কাস্টম রেঞ্জ']])}</div>
        <div id="codc-custom" style="display:none;gap:8px;align-items:flex-end;"><div><div style="font-size:11px;color:var(--text3);margin-bottom:3px;">থেকে</div><input type="date" class="form-input" id="codc-from" onchange="_codcSet('from',this.value)"></div><div><div style="font-size:11px;color:var(--text3);margin-bottom:3px;">পর্যন্ত</div><input type="date" class="form-input" id="codc-to" onchange="_codcSet('to',this.value)"></div></div>
        <div><div style="font-size:11px;color:var(--text3);margin-bottom:3px;">কুরিয়ার</div>${sel('codc-courier','courier',[['','সব কুরিয়ার']].concat(couriers.map(c=>[c,c])))}</div>
        <div><div style="font-size:11px;color:var(--text3);margin-bottom:3px;">স্ট্যাটাস</div>${sel('codc-status','status',[['delivered','শুধু Delivered (প্রকৃত কাটা)'],['all','সব অর্ডার (হিসাবকৃত)']])}</div>
      </div>
      <div id="codc-sum" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;padding:12px 18px;"></div>
      <div id="codc-body" style="padding:6px 18px 16px;overflow-x:auto;"></div></div>`;
    CODC.built = true;
  }
  // ── ডেটা ছাঁকা ──
  const rng=_codcRange(), rows=[]; let undated=0;
  Object.entries(data).forEach(([cn,d])=>{ if (CODC.courier && cn!==CODC.courier) return;
    ((d&&d.orders)||[]).forEach(o=>{
      if (!(o.codAmt>0)) return;
      if (CODC.status==='delivered' && o.status!=='Delivered') return;
      const iso=_codcIso(o.date); if (!iso) { undated++; return; }
      if (rng.from && iso<rng.from) return; if (rng.to && iso>rng.to) return;
      rows.push({iso, amt:Number(o.codAmt)||0});
    }); });
  const map={}; rows.forEach(r=>{ const k=_codcKey(r.iso,CODC.group); (map[k]=map[k]||{amt:0,n:0}); map[k].amt+=r.amt; map[k].n++; });
  let keys=Object.keys(map).sort();
  if (keys.length>1) { const filled=[]; let k=keys[0], guard=0; while (k<=keys[keys.length-1] && guard++<400) { filled.push(k); k=_codcNext(k,CODC.group); } if (guard<400) keys=filled; }   // মাঝের ফাঁকা সময়ও ০ হিসেবে দেখায়
  const total=rows.reduce((s,r)=>s+r.amt,0), maxV=Math.max(1,...keys.map(k=>(map[k]||{amt:0}).amt));
  const fmt=n=>'৳'+Math.round(n).toLocaleString('en-BD');
  const best=keys.reduce((b,k)=>((map[k]||{amt:0}).amt>((map[b]||{amt:0}).amt)?k:b),keys[0]);
  const card=(l,v,c)=>`<div style="padding:10px 12px;border-radius:10px;background:var(--bg3,rgba(255,255,255,.03));border:1px solid var(--border);"><div style="font-size:11px;color:var(--text3);">${l}</div><div style="font-size:18px;font-weight:800;color:${c||'var(--text)'};font-family:'IBM Plex Mono',monospace;">${v}</div></div>`;
  document.getElementById('codc-sum').innerHTML = card('মোট COD চার্জ', fmt(total), 'var(--red,#ef5350)') + card('অর্ডার সংখ্যা', rows.length) + card('গড় প্রতি অর্ডার', rows.length?fmt(total/rows.length):'৳0')
    + card('সর্বোচ্চ ' + ({day:'দিন',week:'সপ্তাহ',month:'মাস',year:'বছর'}[CODC.group]), keys.length&&map[best]?`${fmt(map[best].amt)}<div style="font-size:10px;font-weight:400;color:var(--text3);font-family:inherit;">${_codcLbl(best,CODC.group)}</div>`:'—');
  document.getElementById('codc-count').textContent = rows.length + 'টি অর্ডার' + (undated?` · ${undated}টির তারিখ বোঝা যায়নি`:'');
  const body=document.getElementById('codc-body');
  if (!rows.length) { body.innerHTML = `<div style="text-align:center;color:var(--text3);padding:34px 10px;">এই ফিল্টারে কোনো COD চার্জ নেই${CODC.status==='delivered'?' <div style="font-size:12px;margin-top:4px;">(শুধু Delivered অর্ডার ধরা হচ্ছে — "সব অর্ডার" বেছে দেখুন)</div>':''}</div>`; return; }
  body.innerHTML = `<div style="display:flex;align-items:flex-end;gap:8px;height:210px;min-width:${Math.max(keys.length*52,200)}px;padding-top:20px;">`
    + keys.map(k=>{ const v=(map[k]||{amt:0,n:0}), hpx=v.amt>0?Math.max(4,Math.round((v.amt/maxV)*150)):2;
      return `<div style="flex:1;min-width:44px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;" title="${_codcLbl(k,CODC.group)} — ${fmt(v.amt)} (${v.n}টি অর্ডার)">
        <div style="font-size:10px;font-weight:700;color:${v.amt?'var(--red,#ef5350)':'var(--text3)'};margin-bottom:3px;white-space:nowrap;">${v.amt?fmt(v.amt):'০'}</div>
        <div style="width:70%;max-width:42px;height:${hpx}px;border-radius:6px 6px 0 0;background:${v.amt?'linear-gradient(180deg,#ef5350,#b71c1c)':'var(--border)'};"></div>
        <div style="font-size:10px;color:var(--text3);margin-top:6px;text-align:center;line-height:1.25;white-space:nowrap;">${_codcLbl(k,CODC.group)}</div></div>`; }).join('') + `</div>`;
}

// ── GAS-এ raw call — পুরো response (status/message/tracking_code) অপরিবর্তিত ফেরায়
async function _gasRawCall(payload) {
  if (!API_URL || !API_URL.includes('script.google.com')) {
    return { status:'error', message:'API URL সেট নেই — Setup করুন' };
  }
  const jsonStr = JSON.stringify(payload);
  const encoded = encodeURIComponent(btoa(unescape(encodeURIComponent(jsonStr))));
  const url     = `${API_URL}?action=${encodeURIComponent(payload.action||'')}&data=${encoded}`;
  try {
    const ctrl  = new AbortController();
    const timer = setTimeout(()=>ctrl.abort(), 30000);
    const res   = await fetch(url, { method:'GET', redirect:'follow', signal:ctrl.signal });
    clearTimeout(timer);
    if (!res.ok) return { status:'error', message:'HTTP ' + res.status };
    const data = safeJSONParse(await res.text());
    if (!data) return { status:'error', message:'Response parse ব্যর্থ' };
    return data;
  } catch(e) {
    return { status:'error', message: (e.name === 'AbortError') ? 'Timeout' : e.message };
  }
}

// ── Feature 5: Manual Book Courier — "🚀 Book Courier" বাটনের handler
// ✅ FIX (ডুপ্লিকেট বুকিং, Sept 2026): একই অর্ডারের জন্য আগের রিকোয়েস্ট এখনো
// চলমান থাকলে দ্বিতীয় ক্লিক সার্ভারে পাঠানোই হবে না — সাথে সাথে ব্লক করা হয়
window._bookingInFlight = window._bookingInFlight || new Set();
async function manualBookCourier(orderId, courierName) {
  const btn = event?.target;
  const key = String(orderId);
  if (window._bookingInFlight.has(key)) {
    showToast('⏳ এই অর্ডারের বুকিং এখনো প্রসেস হচ্ছে — একটু অপেক্ষা করুন, আবার ক্লিক করবেন না', 'error');
    return;
  }
  window._bookingInFlight.add(key);
  if (btn) { btn.disabled = true; btn.textContent = '⏳ বুকিং হচ্ছে...'; }
  try {
    // salesData থেকে এই order-এর পুরো info নাও
    const allOrders = window.liveSalesData || liveSalesData || [];
    // ✅ FIX (Multi-product order, Sept 2026): একাধিক প্রোডাক্ট-লাইনের অর্ডার হলে
    // গ্রুপ করা কম্বাইন্ড টোটাল/প্রোডাক্ট-লিস্ট ব্যবহার করো, শুধু প্রথম লাইনের না
    const groupedOrders = (typeof _groupSalesRows === 'function') ? _groupSalesRows(allOrders) : allOrders;
    const ord = groupedOrders.find(o => String(o.id||o.orderId||'') === String(orderId)) || {};
    const items = Array.isArray(ord.items) && ord.items.length ? ord.items : [{product:ord.product,qty:ord.qty,price:ord.price}];
    const productSummary = items.map(it => `${it.product}${items.length>1?` x${it.qty}`:''}`).join(', ');
    // v45 FIX: liveSalesData ফিল্ডের আসল নাম div/dist (division/district নয়) —
    // আগে ভুল key পড়ার কারণে match না পেয়ে PROTI order-এই silently
    // 'Dhaka'/'Dhaka'/'Dhanmondi' বসে যেত, আসল লোকেশন যাই হোক না কেন।
    const division = ord.division || ord.Division || ord.div  || '';
    const district = ord.district || ord.District || ord.dist || '';
    const thana    = ord.thana    || ord.Thana     || '';
    if (!division || !district) {
      showToast('❌ এই অর্ডারে Division/District সেট নেই — আগে Edit করে লোকেশন ঠিক করুন, তারপর বুকিং দিন', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '🚀 Book Courier'; }
      window._bookingInFlight.delete(key);
      return;
    }
    const payload = {
      action:   'bookCourier',
      courier:  courierName,
      orderId:  orderId,
      customer: ord.customer || ord.Customer || '',
      phone:    ord.phone    || ord.Phone    || '',
      address:  ord.address  || ord.Address  || '',
      division, district, thana,
      product:  productSummary,
      qty:      items.reduce((s,it)=>s+(Number(it.qty)||0),0) || 1,
      notes:    ord.notes    || ord.Notes    || '',
      // FIX 1: cod_amount = customerPayable (Product Total + Delivery), NOT netPayable
      cod_amount: (Number(ord.total||0) + Number(ord.delivery||0)),
    };
    const result = await _gasRawCall(payload);
    if (result?.status === 'success') {
      showToast('✅ ' + courierName + ' বুকিং সম্পন্ন! CN: ' + (result.tracking_code||'—'), 'success');
      // in-memory data + UI dynamically আপডেট করো (sheet আগেই server-এ সেভ হয়ে গেছে)
      _updateOSTracking(orderId, result.tracking_code||'', result.order_status||'Pending', courierName, true);
      renderCourierHub();
    } else {
      // ✅ FIX: টাইমআউট হলে স্পষ্ট করে বলো যে আবার সাথে সাথে ক্লিক করা ঠিক হবে না —
      // কারণ সার্ভার-সাইড বুকিং টাইমআউটের পরেও পেছনে চলতে থাকতে পারে
      const isTimeout = (result?.message||'').toLowerCase().includes('timeout');
      showToast(
        (isTimeout
          ? '⏳ রিকোয়েস্ট বেশি সময় নিচ্ছে (Timeout) — সাথে সাথে আবার ক্লিক করবেন না, ৩০-৪০ সেকেন্ড পর Courier Manager রিফ্রেশ করে দেখুন বুকিং হয়ে গেছে কিনা।'
          : '❌ বুকিং ব্যর্থ: ' + (result?.message||'Unknown error')),
        'error'
      );
      if (btn) { btn.disabled = false; btn.innerHTML = '🚀 Book Courier'; }
    }
  } catch(e) {
    showToast('❌ Error: ' + e.message, 'error');
    if (btn) { btn.disabled = false; btn.innerHTML = '🚀 Book Courier'; }
  } finally {
    window._bookingInFlight.delete(key);
  }
}

