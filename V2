// DELIVERY ANALYTICS
// ═══════════════════════════════════════════════════════════════
function renderDeliveryAnalytics(){
  const sales=window.allSales||window.liveSalesData||(typeof liveSalesData!=='undefined'?liveSalesData:[]);
  const selMonth=parseInt(document.getElementById('da-month')?.value||0);
  const selYear=parseInt(document.getElementById('da-year')?.value||0);
  const now=new Date();
  const fmt=(n)=>Number(n||0).toLocaleString('en-IN');

  // Filter delivered orders with delivery charge
  let delivered=sales.filter(o=>{
    const hasDelivery=Number(o.delivery||0)>0||o.deliveryStatus==='Delivered'||o.deliveryStatus==='In Transit';
    return o.status==='Delivered';
  });

  // Filter by selected month/year
  let filtered=delivered.filter(o=>{
    if(!o.date) return true;
    const d=new Date(o.date);
    const mMatch=selMonth===0||d.getMonth()+1===selMonth;
    const yMatch=selYear===0||d.getFullYear()===selYear;
    return mMatch&&yMatch;
  });

  // KPI calculations
  const thisMonth=now.getMonth()+1;const thisYear=now.getFullYear();
  const thisMonthOrders=delivered.filter(o=>{const d=new Date(o.date);return d.getMonth()+1===thisMonth&&d.getFullYear()===thisYear;});
  const thisYearOrders=delivered.filter(o=>{const d=new Date(o.date);return d.getFullYear()===thisYear;});
  const thisMonthCharge=thisMonthOrders.reduce((s,o)=>s+Number(o.delivery||0),0);
  const thisYearCharge=thisYearOrders.reduce((s,o)=>s+Number(o.delivery||0),0);
  const totalCharge=filtered.reduce((s,o)=>s+Number(o.delivery||0),0);
  const avgCharge=filtered.length?totalCharge/filtered.length:0;

  document.getElementById('da-thismonth').textContent=fmt(thisMonthCharge);
  document.getElementById('da-thisyear').textContent=fmt(thisYearCharge);
  document.getElementById('da-avg').textContent=fmt(Math.round(avgCharge));
  document.getElementById('da-count').textContent=filtered.length;

  // Monthly bar chart (canvas)
  const canvas=document.getElementById('da-monthly-chart');
  if(canvas){
    const months=['জান','ফেব','মার','এপ্র','মে','জুন','জুল','আগ','সেপ','অক্ট','নভ','ডিস'];
    const monthData=Array(12).fill(0);
    delivered.forEach(o=>{
      const yr=selYear===0||new Date(o.date).getFullYear()===selYear;
      if(yr){const m=new Date(o.date).getMonth();if(m>=0)monthData[m]+=Number(o.delivery||0);}
    });
    const max=Math.max(...monthData,1);
    const ctx=canvas.getContext('2d');
    canvas.width=canvas.offsetWidth||400;canvas.height=220;
    ctx.clearRect(0,0,canvas.width,canvas.height);
    const bw=Math.floor((canvas.width-40)/12)-4;const bh=canvas.height-50;
    const isDark=!document.body.classList.contains('light');
    ctx.fillStyle=isDark?'#8B949E':'#656D76';ctx.font='11px IBM Plex Sans';
    monthData.forEach((v,i)=>{
      const x=40+i*(bw+4);const h=v>0?Math.max(4,(v/max)*bh):0;const y=bh-h+20;
      const isCurrentMonth=i===now.getMonth()&&(selYear===0||selYear===thisYear);
      ctx.fillStyle=isCurrentMonth?'#388BFD':'#3FB950';
      ctx.beginPath();ctx.roundRect(x,y,bw,h,3);ctx.fill();
      ctx.fillStyle=isDark?'#8B949E':'#656D76';
      ctx.textAlign='center';ctx.fillText(months[i],x+bw/2,canvas.height-5);
      if(v>0){ctx.fillStyle=isDark?'#E6EDF3':'#1F2328';ctx.fillText('৳'+fmt(v),x+bw/2,y-4);}
    });
  }

  // Courier breakdown
  const courierDiv=document.getElementById('da-courier-chart');
  if(courierDiv){
    const courierMap={};
    filtered.forEach(o=>{const c=o.courier||'অজানা';courierMap[c]=(courierMap[c]||{count:0,charge:0});courierMap[c].count++;courierMap[c].charge+=Number(o.delivery||0);});
    const total=Object.values(courierMap).reduce((s,v)=>s+v.charge,0)||1;
    const colors=['#388BFD','#3FB950','#BC8CFF','#E3B341','#F85149','#39D353'];
    const entries=Object.entries(courierMap).sort((a,b)=>b[1].charge-a[1].charge);
    courierDiv.innerHTML=entries.length?entries.map(([name,{count,charge}],i)=>{
      const pct=Math.round((charge/total)*100);
      return `<div style="margin-bottom:6px;">
        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
          <span style="color:${colors[i%colors.length]};font-weight:600;">${name} <span style="color:var(--text3);">(${count}টি)</span></span>
          <span style="color:var(--text2);">৳${fmt(charge)} — ${pct}%</span>
        </div>
        <div style="background:var(--bg);border-radius:4px;height:8px;overflow:hidden;">
          <div style="height:100%;width:${pct}%;background:${colors[i%colors.length]};border-radius:4px;transition:width .5s;"></div>
        </div>
      </div>`;
    }).join(''):'<div style="color:var(--text3);font-size:13px;padding:20px;text-align:center;">ডেটা নেই</div>';
  }

  // Delivered orders table
  const tbody=document.getElementById('da-orders-tbody');
  const countEl=document.getElementById('da-table-count');
  if(tbody){
    const rows=filtered.slice().sort((a,b)=>new Date(b.date)-new Date(a.date));
    if(countEl) countEl.textContent=rows.length+'টি অর্ডার';
    tbody.innerHTML=rows.length?rows.map((o,i)=>`<tr>
      <td>${i+1}</td><td>${o.date||'—'}</td><td>${o.customer||'—'}</td>
      <td>${o.product||'—'}</td><td>${o.qty||1} পিস</td>
      <td style="color:var(--blue);font-weight:600;">৳${fmt(o.delivery||0)}</td>
      <td>${o.courier||'—'}</td><td style="font-family:'IBM Plex Mono',monospace;font-size:11px;">${o.tracking||'—'}</td>
      <td><span class="status delivered" style="font-size:10px;">Delivered</span></td>
    </tr>`).join(''):'<tr><td colspan="9" style="text-align:center;color:var(--text3);padding:30px;">এই ফিল্টারে কোনো অর্ডার নেই</td></tr>';
  }
}

