<script>
/* ═══ 👔 Salesmen + 📒 বাকি (RUHANIS) — স্বতন্ত্র মডিউল; মূল Sales ডেটা শুধু পড়ে ═══ */
(function(){
  'use strict';
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  const num = n => (Number(n) || 0).toLocaleString('en-BD', { maximumFractionDigits: 2 });
  const tk = n => '৳' + num(n);
  const MON = { jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12 };
  const MON_BN = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
  const toast = (m, t) => { try { showToast(m, t || 'success'); } catch (e) {} };
  const SM = { list: [], loaded: false, ym: '', rows: [], busy: false, editId: null, lastLoad: 0 };
  const BK = { rows: [], cur: null, busy: false };
  const todayYM = () => { try { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka' }).format(new Date()).slice(0, 7); } catch (e) { return new Date().toISOString().slice(0, 7); } };
  SM.ym = todayYM();
  const FAIL = ['Returned', 'Cancelled'], ACTIVE = ['Pending', 'Processing', 'In Transit'];

  function ordParts(o) {
    const m = /(\d{1,2})\W+([A-Za-z]{3})[a-z]*\W+(\d{4})/.exec(String(o.date || ''));
    if (m && MON[m[2].toLowerCase()]) return { y: +m[3], m: MON[m[2].toLowerCase()], d: +m[1] };
    const iso = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(o.rawDateISO || ''));
    return iso ? { y: +iso[1], m: +iso[2], d: +iso[3] } : null;
  }
  const ordYM = o => { const p = ordParts(o); return p ? p.y + '-' + String(p.m).padStart(2, '0') : ''; };
  const ordDays = o => { const p = ordParts(o); if (!p) return null; const now = new Date(); return Math.max(0, Math.floor((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - Date.UTC(p.y, p.m - 1, p.d)) / 86400000)); };
  function allOrders() {
    const rows = Array.isArray(window.allSales) ? window.allSales : [];
    return (typeof _groupSalesRows === 'function') ? _groupSalesRows(rows) : rows;
  }
  async function ensureSales(force) {
    if (force || !(window.allSales || []).length) { try { await loadLiveSales(); } catch (e) {} }
  }

  // ───────── Salesman তালিকা ─────────
  async function loadSalesmen() {
    try {
      const d = await fetchFromAPI('salesmen');
      if (d && Array.isArray(d.data)) { SM.list = d.data; SM.loaded = true; SM.lastLoad = Date.now(); }
    } catch (e) {}
    fillOrderSelect();
    return SM.list;
  }
  function fillOrderSelect(cur) {
    const sel = $('order-salesman'); if (!sel) return;
    if (cur === undefined) cur = sel.value || '';
    const names = SM.list.filter(s => s.active).map(s => s.name);
    if (cur && !names.some(n => n.toLowerCase() === String(cur).toLowerCase())) names.push(cur);
    sel.innerHTML = '<option value="">— কেউ না —</option>' + names.map(n => `<option value="${esc(n)}">${esc(n)}</option>`).join('');
    sel.value = cur || '';
  }

  // ───────── হিসাব ─────────
  function compute() {
    const period = SM.ym || '';
    const map = {};
    const mk = (s, ghost) => ({ s, name: s ? s.name : 'কেউ না (Salesman ছাড়া)', perSale: s ? Number(s.perSale) || 0 : 0, salary: s ? Number(s.salary) || 0 : 0, active: s ? s.active !== false : true, none: !s, ghost: !!ghost, orders: [], total: 0, delivered: 0, running: 0, failed: 0, sales: 0 });
    SM.list.forEach(s => { map[s.name.toLowerCase()] = mk(s); });
    const none = mk(null);
    allOrders().forEach(o => {
      if (period && ordYM(o) !== period) return;
      const nm = String(o.salesman || '').trim(), key = nm.toLowerCase();
      let t = none;
      if (key) t = map[key] || (map[key] = mk({ name: nm, perSale: 0, salary: 0, active: false }, true));
      t.orders.push(o); t.total++;
      if (o.status === 'Delivered') { t.delivered++; t.sales += Number(o.total) || 0; }
      else if (FAIL.includes(o.status)) t.failed++;
      else t.running++;
    });
    const rows = Object.keys(map).map(k => map[k]).filter(t => t.active || t.total > 0);
    rows.forEach(t => { t.commission = t.delivered * t.perSale; t.paySalary = period ? t.salary : 0; t.payable = t.commission + t.paySalary; });
    rows.sort((a, b) => b.delivered - a.delivered || b.total - a.total || a.name.localeCompare(b.name));
    if (none.total > 0) { none.commission = 0; none.paySalary = 0; none.payable = 0; rows.push(none); }
    return rows;
  }
  const periodLabel = () => { const m = /^(\d{4})-(\d{2})$/.exec(SM.ym || ''); return m ? `${MON_BN[+m[2] - 1]} ${m[1]}` : 'সব সময়'; };

  // ───────── Salesmen পেজ ─────────
  function render() {
    const body = $('sm-body'); if (!body) return;
    const rows = SM.rows = compute();
    if ($('sm-month')) $('sm-month').value = SM.ym || '';
    if ($('sm-period-label')) $('sm-period-label').textContent = '📅 ' + periodLabel() + (SM.ym ? '' : ' — বেতন যোগ হয়নি, মাস বাছুন');
    const real = rows.filter(r => !r.none);
    const T = real.reduce((a, r) => ({ total: a.total + r.total, del: a.del + r.delivered, run: a.run + r.running, fail: a.fail + r.failed, sales: a.sales + r.sales, comm: a.comm + r.commission, sal: a.sal + r.paySalary, pay: a.pay + r.payable }), { total: 0, del: 0, run: 0, fail: 0, sales: 0, comm: 0, sal: 0, pay: 0 });
    $('sm-kpis').innerHTML = [
      ['👔 সক্রিয় Salesman', SM.list.filter(s => s.active).length],
      ['🛒 মোট অর্ডার (Salesman সহ)', T.total],
      ['✅ Delivered', T.del],
      ['❌ ফেল', `<span class="sm-fail">${T.fail}</span>`],
      ['💵 বিক্রয় (Delivered)', tk(T.sales)],
      ['💰 মোট প্রদেয় (বেতন+কমিশন)', tk(T.pay)],
    ].map(k => `<div class="sm-kpi"><small>${k[0]}</small><strong>${k[1]}</strong></div>`).join('');
    if (!rows.length) {
      body.innerHTML = `<tr><td colspan="12" style="text-align:center;color:var(--text3);padding:40px;">${SM.list.length ? 'এই সময়ে কোনো অর্ডার নেই' : 'এখনো কোনো Salesman যোগ করা হয়নি — "＋ নতুন Salesman" চাপুন'}</td></tr>`;
      $('sm-foot').innerHTML = ''; return;
    }
    body.innerHTML = rows.map((t, i) => {
      const rate = t.total ? Math.round(t.delivered / Math.max(1, t.delivered + t.failed) * 100) : 0;
      const nameCell = t.none ? `<span style="color:var(--text3);">${esc(t.name)}</span>` : `<span class="sm-link" onclick="smDrill(${i})">${esc(t.name)}</span>${t.active ? '' : ' <span class="sm-tag" style="background:rgba(139,148,158,.2);color:var(--text3);">নিষ্ক্রিয়</span>'}${t.ghost ? ' <span class="sm-tag" style="background:rgba(248,81,73,.15);color:var(--red);">তালিকায় নেই</span>' : ''}`;
      return `<tr class="${t.active ? '' : 'sm-inactive'}">
        <td>${nameCell}</td>
        <td class="mono" style="text-align:right;">${t.total}</td>
        <td class="mono" style="text-align:right;color:var(--green);">${t.delivered}</td>
        <td class="mono" style="text-align:right;">${t.running}</td>
        <td class="mono ${t.failed ? 'sm-fail' : ''}" style="text-align:right;">${t.failed}</td>
        <td class="mono" style="text-align:right;">${t.none ? '—' : (t.delivered + t.failed ? rate + '%' : '—')}</td>
        <td class="mono" style="text-align:right;">${tk(t.sales)}</td>
        <td class="mono" style="text-align:right;">${t.none ? '—' : tk(t.perSale)}</td>
        <td class="mono" style="text-align:right;">${t.none ? '—' : tk(t.commission)}</td>
        <td class="mono" style="text-align:right;">${t.none ? '—' : (SM.ym ? tk(t.salary) : '<span style="color:var(--text3)" title="মাস বাছলে যোগ হবে">(' + tk(t.salary) + '/মাস)</span>')}</td>
        <td class="mono" style="text-align:right;font-weight:700;color:var(--gold);">${t.none ? '—' : tk(t.payable)}</td>
        <td>${t.none || t.ghost ? '' : `<button class="btn" style="padding:4px 10px;font-size:11px;" onclick="smOpenEdit(${t.s.id})">✏️</button>`}</td>
      </tr>`;
    }).join('');
    $('sm-foot').innerHTML = `<tr style="font-weight:700;border-top:2px solid var(--border);"><td>মোট</td><td class="mono" style="text-align:right;">${T.total}</td><td class="mono" style="text-align:right;color:var(--green);">${T.del}</td><td class="mono" style="text-align:right;">${T.run}</td><td class="mono sm-fail" style="text-align:right;">${T.fail}</td><td></td><td class="mono" style="text-align:right;">${tk(T.sales)}</td><td></td><td class="mono" style="text-align:right;">${tk(T.comm)}</td><td class="mono" style="text-align:right;">${SM.ym ? tk(T.sal) : '—'}</td><td class="mono" style="text-align:right;color:var(--gold);">${tk(T.pay)}</td><td></td></tr>`;
  }
  async function openPage() {
    render();
    await Promise.all([ensureSales(false), loadSalesmen()]);
    render(); refreshDash();
