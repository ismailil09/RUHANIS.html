    $('sm-imp-summary').innerHTML = `মোট ${rows.length}টি সারি · ✅ Import হবে <b style="color:var(--green)">${okN}</b> · ⏭️ বাদ ${rows.length - okN}`;
    $('sm-imp-tbody').innerHTML = rows.map(r => `<tr style="${r.state === 'ok' ? '' : 'opacity:.55;'}"><td style="padding:5px 10px;">${esc(r.name) || '—'}</td><td style="padding:5px 10px;text-align:right;">${isFinite(r.perSale) ? tk(r.perSale) : '—'}</td><td style="padding:5px 10px;text-align:right;">${isFinite(r.salary) ? tk(r.salary) : '—'}</td><td style="padding:5px 10px;color:${r.state === 'ok' ? 'var(--green)' : 'var(--red)'};">${r.state === 'ok' ? '✅ নতুন' : esc(r.state)}</td></tr>`).join('');
    $('sm-imp-drop').style.display = 'none'; $('sm-imp-preview').style.display = 'block'; $('sm-imp-go').style.display = okN ? '' : 'none';
  }
  async function impGo() {
    if (IMPX.busy) return;
    const rows = IMPX.rows.filter(r => r.state === 'ok'); if (!rows.length) return;
    IMPX.busy = true; const btn = $('sm-imp-go'); btn.disabled = true;
    try {
      const r = await postToAPI({ action: 'bulkImportSalesmen', rows: rows.map(x => ({ name: x.name, perSale: x.perSale, salary: x.salary, note: x.note, active: x.active })) });
      if (r && r.status !== 'error') {
        closeModal('sm-import'); toast(`✅ ${r.added}টি Salesman Import হয়েছে${r.skipped ? ` (${r.skipped}টি আগে থেকেই ছিল)` : ''}`);
        try { logAction(`Salesman CSV import: ${r.added}টি`); } catch (e) {}
        await loadSalesmen(); render(); refreshDash();
      }
    } finally { IMPX.busy = false; btn.disabled = false; }
  }

  // ───────── Dashboard কার্ড ─────────
  function refreshDash() {
    try {
      const t = bakiTotals();
      if ($('kpi-baki')) { $('kpi-baki').textContent = num(t.due); $('kpi-baki-sub').textContent = t.n ? `${t.n}টি Delivered অর্ডারে বাকি` : 'কোনো বাকি নেই'; }
      if ($('kpi-top-salesman')) {
        const saved = SM.ym; SM.ym = todayYM(); const rows = compute().filter(r => !r.none && r.total > 0); SM.ym = saved;
        const top = rows[0];
        $('kpi-top-salesman').textContent = top ? top.name : '—';
        $('kpi-top-salesman-sub').textContent = top ? `এই মাস: ✅ ${top.delivered} · ❌ ${top.failed} · মোট ${top.total}` : 'এই মাসে কোনো Salesman-এর অর্ডার নেই';
      }
      updateBadge();
    } catch (e) {}
  }

  // loadLiveSales শেষ হলে নতুন মডিউলগুলো আপডেট হবে (মূল ফাংশন অপরিবর্তিত)
  const _ls = window.loadLiveSales;
  if (typeof _ls === 'function') {
    window.loadLiveSales = async function () {
      const r = await _ls.apply(this, arguments);
      try {
        if (!SM.loaded || Date.now() - SM.lastLoad > 60000) await loadSalesmen();
        refreshDash();
        if ($('page-salesmen') && $('page-salesmen').classList.contains('active')) render();
        if ($('page-baki') && $('page-baki').classList.contains('active')) bakiRender();
      } catch (e) {}
      return r;
    };
  }
  if (typeof pageTitles === 'object') {
    pageTitles.salesmen = ['Salesmen', '— বিক্রয়কর্মী ট্র্যাকিং ও বেতন'];
    pageTitles.baki = ['বাকি (Due)', '— ডেলিভারি হয়েছে কিন্তু টাকা বাকি'];
  }
  Object.assign(window, { smOpenPage: openPage, smReload: reload, smPeriod: v => { SM.ym = v || ''; render(); }, smAll: () => { SM.ym = ''; render(); }, smThisMonth: () => { SM.ym = todayYM(); render(); },
    smDrill: drill, smOpenEdit: openEdit, smSave: save, smDelete: del, smExport: exportSm, smOpenImport: openImp, smImpRead: impRead, smImpGo: impGo, smSampleCSV: smSample, smPrint: printSm, smFillOrderSelect: fillOrderSelect, smLoad: loadSalesmen,
    bakiOpenPage, bakiReload, bakiRender, bakiEdit, bakiCollect, bakiCPrev, bakiCSave, bakiExport, bakiPrint });
})();
</script>
</body>
</html>
