    PT.rows = d.data; PT.loaded = true; render(); if (manual) toast('✅ রিফ্রেশ হয়েছে', 'info'); return true;
  }
  function filtered() {
    const q = $('pt-f-q').value.trim().toLowerCase(), from = $('pt-f-from').value, to = $('pt-f-to').value;
    const qd = /^[\d+\-\s()]+$/.test(q) ? q.replace(/\D/g, '') : '';   // ফোন-সার্চ শুধু সংখ্যা-ধরনের কোয়েরিতে
    return PT.rows.filter(r => {
      if (from && r.date < from) return false;
      if (to && r.date > to) return false;
      if (q) {
        const hit = [r.supplier, r.item, r.invoice].some(x => String(x || '').toLowerCase().includes(q)) || (qd && String(r.phone || '').replace(/\D/g, '').includes(qd));
        if (!hit) return false;
      }
