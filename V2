let _expCatState = { key:'', list:[] };
function _expMonthKey(e){
  const m = /(\d{1,2})-([A-Za-z]{3})-(\d{4})/.exec(String(e.date||''));
  if(m) return m[3]+'-'+String(['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'].indexOf(m[2].toLowerCase())+1).padStart(2,'0');
  const iso = /^(\d{4})-(\d{2})/.exec(String(e.rawDate||'')); return iso ? iso[1]+'-'+iso[2] : '—';
}
function expCatOpen(i){
  const c = EXP_CATS[i]; if(!c) return;
