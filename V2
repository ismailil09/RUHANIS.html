async function ensurePinHashCache() {
  if (pinHashCache) return pinHashCache;
  if (pinHashCacheLoading) return pinHashCacheLoading;
  pinHashCacheLoading = postToAPI({ action: 'getPinHashes' }).then(result => {
    pinHashCacheLoading = null;
    if (result && result.hashes) { pinHashCache = { salt: result.salt, hashes: result.hashes }; }
    return pinHashCache;
  }).catch(() => { pinHashCacheLoading = null; return null; });
