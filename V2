let _binData = [];

async function loadRecycleBin() {
  const tbody = document.getElementById('recycle-bin-body');
  if(tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:30px;color:var(--text3);">⏳ লোড হচ্ছে...</td></tr>';
  const res = await postToAPI({action:'getRecycleBin'});
  _binData = (res && res.data) ? res.data : [];
  renderRecycleBin();
  updateBinBadge(_binData.length);
}

function renderRecycleBin() {
  const tbody = document.getElementById('recycle-bin-body');
  if(!tbody) return;
  const filter = (document.getElementById('bin-type-filter')||{}).value || '';
  let items = filter ? _binData.filter(x=>x.itemType===filter) : _binData;

  document.getElementById('bin-count').textContent = items.length + ' items';
  document.getElementById('bin-total-count').textContent = _binData.length;

  // Expiry info
  const expInfo = document.getElementById('bin-expiry-info');
  if(_binData.length > 0) {
    const soonest = _binData.reduce((a,b)=>a.daysLeft<b.daysLeft?a:b);
    expInfo.textContent = `"${soonest.label.substring(0,30)}..." — ${soonest.daysLeft} দিন বাকি`;
  } else {
    if(expInfo) expInfo.textContent = '—';
  }

  if(items.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text3);">🗑️ রিসাইকেল বিন খালি</td></tr>';
    return;
  }

  const typeColor = {Order:'var(--blue)',Expense:'var(--red)',Product:'var(--green)',Transaction:'var(--gold)',Investor:'#a78bfa'};
  const typeIcon  = {Order:'🛒',Expense:'💸',Product:'📦',Transaction:'🤝',Investor:'📈'};

  tbody.innerHTML = items.map(item => {
    const daysLeft = item.daysLeft;
    const urgentStyle = daysLeft <= 5 ? 'color:var(--red);font-weight:700;' : daysLeft <= 10 ? 'color:orange;font-weight:600;' : 'color:var(--text3);';
    const tc = typeColor[item.itemType] || 'var(--text)';
    return `<tr>
      <td><code style="font-size:10px;color:var(--text3);">${item.binId}</code></td>
      <td><span style="background:${tc}22;color:${tc};border:1px solid ${tc}44;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;">${typeIcon[item.itemType]||'📄'} ${item.itemType}</span></td>
      <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${item.label}">${item.label}</td>
      <td style="font-size:12px;color:var(--text3);">${item.deletedAt}</td>
      <td style="${urgentStyle}font-size:12px;">${daysLeft <= 0 ? '⚠️ মুছে যাবে শীঘ্রই' : daysLeft + ' দিন'}</td>
      <td style="white-space:nowrap;">
        <button class="btn" style="padding:4px 10px;font-size:11px;background:rgba(16,185,129,.15);color:var(--green);border-color:rgba(16,185,129,.3);" onclick="restoreBinItem('${item.binId}')">♻️ Restore</button>
        <button class="btn danger" style="padding:4px 10px;font-size:11px;margin-left:4px;" onclick="permanentDeleteItem('${item.binId}','${item.label.replace(/'/g,'')}')">🗑 চিরতরে মুছুন</button>
      </td>
    </tr>`;
  }).join('');
}

async function restoreBinItem(binId) {
  if(!confirm('এই আইটেমটি মূল শিটে ফিরিয়ে দেবেন?')) return;
  showToast('⏳ পুনরুদ্ধার হচ্ছে...','info');
  const res = await postToAPI({action:'restoreItem', binId});
  if(res && res.status==='success') {
    showToast('✅ ' + res.message, 'success');
    logAction(`Recycle Bin থেকে আইটেম Restore করেছেন — ${binId}`);
    await loadRecycleBin();
    // Refresh all modules
    setTimeout(()=>{ try{loadLiveOrders();}catch(e){} try{loadLiveExpenses();}catch(e){} try{loadLiveInventory();}catch(e){} try{loadLivePartners();}catch(e){} try{loadLiveDashboard();}catch(e){} }, 1200);
  } else {
    showToast('❌ ' + (res?.message || 'Restore ব্যর্থ হয়েছে'), 'error');
  }
}

async function permanentDeleteItem(binId, label) {
  if(!confirm(`"${label}" চিরতরে মুছে ফেলবেন?\n\n⚠️ এই কাজ আর undo করা যাবে না!`)) return;
  const res = await postToAPI({action:'permanentDelete', binId});
  if(res && res.status==='success') {
    showToast('🗑️ চিরতরে মুছে ফেলা হয়েছে', 'info');
    await loadRecycleBin();
  } else {
    showToast('❌ ' + (res?.message || 'ব্যর্থ হয়েছে'), 'error');
  }
}

function updateBinBadge(count) {
  const badge = document.getElementById('bin-badge');
  if(!badge) return;
  if(count === undefined) {
    // Just fetch count silently
    postToAPI({action:'getRecycleBin'}).then(res=>{
      const n = res?.data?.length || 0;
      badge.textContent = n;
      badge.style.display = n > 0 ? 'inline-block' : 'none';
    }).catch(()=>{});
    return;
  }
  badge.textContent = count;
  badge.style.display = count > 0 ? 'inline-block' : 'none';
}

