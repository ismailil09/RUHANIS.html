    }).sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : (a.id < b.id ? 1 : -1)));
  }
  const isFiltering = () => !!($('pt-f-q').value.trim() || $('pt-f-from').value || $('pt-f-to').value);

  // ── গ্রুপিং: একই সরবরাহকারী + তারিখ + ইনভয়েস = একটি "ক্রয়" (শিটে প্রতিটি পণ্য আলাদা row-ই থাকে) ──
  const gKey = r => [r.date, String(r.supplier || '').trim().toLowerCase(), String(r.invoice || '').trim().toLowerCase()].join('\u0001');
  const same = (arr, f) => { const s = new Set(arr.map(f)); return s.size === 1 ? arr[0] && f(arr[0]) : (s.size ? 'মিশ্র' : ''); };
  function makeGroup0(items) {
    const it = items.slice().sort((a, b) => (a.id < b.id ? -1 : 1)), f = it[0];
    return { key: gKey(f), date: f.date, supplier: f.supplier, phone: same(it, x => x.phone), invoice: f.invoice, method: same(it, x => x.method), source: same(it, x => x.source), note: same(it, x => x.note),
      items: it, ids: it.map(x => x.id), total: it.reduce((s, x) => s + Math.round((Number(x.total) || 0) * 100), 0) / 100 };
  }
  function makeGroup(items) {
    const g = makeGroup0(items), tr = items.some(x => x.paid != null), pc = items.reduce((s, x) => s + Math.round((Number(x.paid) || 0) * 100), 0);
    g.tracked = tr; g.paid = pc / 100; g.due = tr ? Math.max(0, Math.round(g.total * 100) - pc) / 100 : 0; return g;
  }
  const dueCell = g => !g.tracked ? '<span style="color:var(--text3)">—</span>' : (g.due <= 0 ? '<span class="pt-due ok">✅ পরিশোধিত</span>' : `<span class="pt-due bad">বাকি ${money(g.due)}</span><div style="font-size:10px;color:var(--text3);margin-top:2px;">দেওয়া ${money(g.paid)}</div>`);
  function groupRows(rows) {
    const m = new Map(); rows.forEach(r => { const k = gKey(r); if (!m.has(k)) m.set(k, []); m.get(k).push(r); });
    return Array.from(m.values()).map(makeGroup).sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : (a.ids[0] < b.ids[0] ? 1 : -1)));
  }
  function filteredGroups() {
    const q = $('pt-f-q').value.trim().toLowerCase(), from = $('pt-f-from').value, to = $('pt-f-to').value, qd = /^[\d+\-\s()]+$/.test(q) ? q.replace(/\D/g, '') : '';
    return groupRows(PT.rows).filter(g => {
      if (from && g.date < from) return false; if (to && g.date > to) return false;
      if (!q) return true;
      return [g.supplier, g.invoice].some(x => String(x || '').toLowerCase().includes(q)) || g.items.some(r => String(r.item || '').toLowerCase().includes(q) || String(r.supplier || '').toLowerCase().includes(q) || (qd && String(r.phone || '').replace(/\D/g, '').includes(qd)));
    });
  }
  const itemsLabel = g => { const names = g.items.map(x => x.item); const first = names.slice(0, 2).map(esc).join(', '); return `<span class="pt-badge">${g.items.length}টি পণ্য</span> <span style="color:var(--text2);font-size:12px;">${first}${names.length > 2 ? ` +${names.length - 2}` : ''}</span>`; };
  function render() {
