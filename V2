// OPT-K: Inventory table pagination — render 50 rows at a time.
// Prevents DOM from ballooning with 200+ product rows.
// ═══════════════════════════════════════════════════════════
const INV_PAGE_SIZE = 50;
let _invPage = 1;
let _invFilteredRows = [];

function _wrapInventoryPagination() {
  const origRender = window.renderInventoryData;
  if (!origRender || origRender._paginated) return;
  window.renderInventoryData = function(rows) {
    _invFilteredRows = rows;
    _invPage = 1;
    origRender(rows.slice(0, INV_PAGE_SIZE));
    _renderInvPagination();
  };
  window.renderInventoryData._paginated = true;
}

function _renderInvPagination() {
  const total = _invFilteredRows.length, pages = Math.ceil(total / INV_PAGE_SIZE);
  const container = document.getElementById('inv-pagination') || (() => {
    const d = document.createElement('div');
    d.id = 'inv-pagination';
    d.style.cssText = 'display:flex;gap:8px;align-items:center;padding:12px 0;flex-wrap:wrap;';
    const tb = document.getElementById('inv-body');
    if (tb && tb.closest('table')) tb.closest('table').after(d);
    return d;
  })();
  if (pages <= 1) { container.innerHTML = `<span style="color:var(--text3);font-size:12px;">${total} products</span>`; return; }
  let h = `<span style="color:var(--text3);font-size:12px;">${total} products · Page ${_invPage}/${pages}</span>`;
  if (_invPage > 1) h += `<button class="btn" style="padding:3px 10px;font-size:12px;" onclick="_goInvPage(${_invPage-1})">← Prev</button>`;
  for (let p = Math.max(1,_invPage-2); p <= Math.min(pages,_invPage+2); p++) {
    h += `<button class="btn" style="padding:3px 10px;font-size:12px;${p===_invPage?'background:var(--gold);color:#000;border-color:var(--gold);font-weight:700;':''}" onclick="_goInvPage(${p})">${p}</button>`;
  }
  if (_invPage < pages) h += `<button class="btn" style="padding:3px 10px;font-size:12px;" onclick="_goInvPage(${_invPage+1})">Next →</button>`;
  container.innerHTML = h;
}

function _goInvPage(p) {
  _invPage = p;
  const origRender = window.renderInventoryData;
  if (origRender && origRender._paginated) {
    // Get original function before wrapping
    const start = (p - 1) * INV_PAGE_SIZE;
    const slice = _invFilteredRows.slice(start, start + INV_PAGE_SIZE);
    // Call original render temporarily
    const orig = origRender._orig;
    if (orig) orig(slice);
  }
  _renderInvPagination();
  document.getElementById('inv-body')?.closest('.table-wrap')?.scrollTo({ top: 0, behavior: 'smooth' });
}

// Wire inventory pagination after page load
document.addEventListener('DOMContentLoaded', () => {
  setTimeout(_wrapInventoryPagination, 500);
});


