      <div class="table-scroll"><table><thead><tr><th>#</th><th>তারিখ</th><th>কাস্টমার</th><th>প্রোডাক্ট</th><th>পরিমাণ</th><th>Total</th><th>কুরিয়ার</th></tr></thead><tbody>${rows||'<tr><td colspan="7" style="text-align:center;color:var(--text3);">ডেটা নেই</td></tr>'}</tbody></table></div>`;
  }
  else if(type==='capital'){
    title.textContent='🏦 Business Capital — বিস্তারিত';
    const partnerNames=[...new Set(partners.map(p=>p.partner))];
    const partnerRows=partnerNames.map(name=>{
      const invested=partners.filter(p=>p.partner===name&&p.type==='Investment').reduce((s,p)=>s+Number(p.amount||0),0);
      const drawn=partners.filter(p=>p.partner===name&&p.type==='Drawings').reduce((s,p)=>s+Number(p.amount||0),0);
