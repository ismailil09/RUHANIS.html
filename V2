 * @param {object} order — submitOrder-এর payload object
 */
async function dispatchCourierBooking(order) {
  const courierName = (order.courier || "").trim();
  if (!courierName) return;

  let result = null;

  if (courierName === "Steadfast") {
    showToast("⏳ Steadfast-এ বুকিং পাঠানো হচ্ছে...", "info");
    result = await bookWithSteadfast(order);

    if (result) {
      showToast(`✅ Steadfast বুকিং সম্পন্ন! Tracking: ${result.tracking_code}${result.consignment_id?' | CID: #'+result.consignment_id:''}`, "success");
      _updateOSTracking(order.orderId, result.tracking_code, result.status, "Steadfast", false, result.consignment_id||'');
    }

  } else if (courierName === "Pathao") {
    showToast("⏳ Pathao-এ বুকিং পাঠানো হচ্ছে...", "info");
    result = await bookWithPathao(order);

    if (result) {
      showToast(`✅ Pathao বুকিং সম্পন্ন! Consignment: ${result.tracking_code}`, "success");
      _updateOSTracking(order.orderId, result.tracking_code, result.status, "Pathao", false, result.consignment_id||'');
    }

  } else {
    // অন্য কুরিয়ার — local entry, কোনো API call নেই
    logAction(`Local courier entry: ${courierName} — Order ${order.orderId}`);
  }
}

