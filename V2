  const money = n => (Number(n) < 0 ? '−' : '') + '৳' + num(Math.abs(Number(n) || 0));
  const toast = (m, t) => { try { showToast(m, t || 'success'); } catch (e) {} };
  const todayBD = () => { try { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka' }).format(new Date()); } catch (e) { return new Date().toISOString().slice(0, 10); } };
  const fmtDate = d => { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(d || '')); return m ? `${m[3]}-${MONTHS[+m[2] - 1]}-${m[1]}` : esc(d || '—'); };

  // ── হিসাব: Opening + Credit − Debit ──
  function compute() {
    let cr = 0, db = 0, crN = 0, dbN = 0; const L = liveEntries();
    L.forEach(e => { const p = Math.round(e.amount * 100); if (e.type === 'Credit') { cr += p; crN++; } else { db += p; dbN++; } });
    const op = Math.round(CF.opening * 100);
    return { opening: op / 100, credit: cr / 100, debit: db / 100, balance: (op + cr - db) / 100, crN, dbN };
  }

  // তারিখ অনুযায়ী (পুরোনো→নতুন) running balance — id → balance
  // তারিখ অনুযায়ী (পুরোনো→নতুন) running balance — id → balance
  function runningMap() {
    const asc = liveEntries().slice().sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : idNum(a) - idNum(b)));
    let bal = Math.round(CF.opening * 100); const map = {};
    asc.forEach(e => { const p = Math.round(e.amount * 100); bal += e.type === 'Credit' ? p : -p; map[e.id == null ? 'p:' + e.cid : e.id] = bal / 100; });
    return map;
  }

  // ── Render ──
  const rowKey = e => (e.id == null ? 'p:' + e.cid : e.id);
  function render() {
    const t = compute();
    const set = (id, v) => { const x = $(id); if (x) x.textContent = v; };
    set('cf-kpi-balance', money(t.balance));
    const bEl = $('cf-kpi-balance'); if (bEl) bEl.style.color = t.balance < 0 ? 'var(--red)' : '';
    set('cf-kpi-credit', money(t.credit)); set('cf-kpi-credit-sub', `মোট জমা · ${t.crN}টি এন্ট্রি`);
    set('cf-kpi-debit', money(t.debit)); set('cf-kpi-debit-sub', `মোট খরচ · ${t.dbN}টি এন্ট্রি`);
    set('cf-kpi-opening', money(t.opening));
    set('cf-kpi-opening-sub', CF.openingSet ? ((CF.openingDate ? 'শুরু: ' + fmtDate(CF.openingDate) : 'শুরুতে থাকা টাকা') + (CF.openingHistory.length > 1 ? ' · ' + (CF.openingHistory.length - 1) + ' বার আপডেট' : '')) : 'এখনো সেট করা হয়নি');
    const notice = $('cf-open-notice'); if (notice) notice.classList.toggle('show', CF.loaded && !CF.openingSet);
    const failedN = CF.pending.filter(p => p.state === 'failed').length, ob = $('cf-outbox-notice');
    if (ob) { ob.classList.toggle('show', failedN > 0); const ot = $('cf-outbox-text'); if (ot) ot.textContent = `❌ ${failedN}টি এন্ট্রি সেভ হয়নি (ব্যালেন্সে ধরা হয়নি) — এগুলো এই ব্রাউজারে জমা আছে, হারাবে না।`; }
    paintCard(t.balance, t.credit, t.debit);

    const from = $('cf-f-from').value, to = $('cf-f-to').value, ty = $('cf-f-type').value, q = $('cf-f-q').value.trim().toLowerCase();
    const run = runningMap();
    const all = CF.entries.concat(CF.pending.map(p => Object.assign({}, p, { _pending: true })));
    let rows = all.slice().sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : idNum(b) - idNum(a)));
    if (from) rows = rows.filter(e => e.date >= from);
    if (to) rows = rows.filter(e => e.date <= to);
    if (ty) rows = rows.filter(e => e.type === ty);
    if (q) rows = rows.filter(e => (e.note || '').toLowerCase().includes(q) || String(e.amount).includes(q) || String(e.id) === q);

    const body = $('cf-body'), foot = $('cf-foot');
    set('cf-count', `${rows.length} / ${all.length} টি লেনদেন`);
    if (!rows.length) {
      body.innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--text3);padding:40px;">${all.length ? 'এই ফিল্টারে কোনো লেনদেন নেই' : 'এখনো কোনো লেনদেন নেই — উপরের <strong>Credit</strong> বা <strong>Debit</strong> বাটনে ক্লিক করে প্রথম এন্ট্রি দিন'}</td></tr>`;
      foot.style.display = 'none'; return;
    }
    body.innerHTML = rows.map(e => {
      const cr = e.type === 'Credit', failed = e._pending && e.state === 'failed', saving = (e._pending && !failed) || e._sync, k = rowKey(e);
      let actions;
      if (e._pending) actions = failed ? `<button class="btn btn-sm" title="আবার পাঠান" onclick="cfRetry('${esc(e.cid)}')">🔁 আবার</button><button class="btn btn-sm" title="বাদ দিন" onclick="cfDiscard('${esc(e.cid)}')">🗑️</button>` : '<span title="সেভ হচ্ছে">⏳</span>';
      else if (e._sync) actions = '<span title="সেভ হচ্ছে">⏳</span>';
      else actions = `<button class="btn btn-sm" title="Edit" onclick="cfOpenEntry(null,${Number(e.id)})">✏️</button><button class="btn btn-sm" title="Delete" onclick="cfDelete(${Number(e.id)})">🗑️</button>`;
      const style = failed ? 'background:rgba(248,81,73,.08);' : (saving ? 'opacity:.7;' : '');
      const tag = failed ? '<div style="color:var(--red);font-size:11px;font-weight:700;">❌ সেভ হয়নি</div>' : (e._pending ? '<div style="color:var(--text3);font-size:11px;">⏳ সেভ হচ্ছে…</div>' : '');
      return `<tr style="${style}">
        <td style="white-space:nowrap;">${fmtDate(e.date)}</td>
        <td><span class="cf-pill ${cr ? 'credit' : 'debit'}">${cr ? '＋ Credit' : '− Debit'}</span></td>
        <td class="cf-amt ${cr ? 'credit' : 'debit'}">${cr ? '+' : '−'}৳${num(e.amount)}</td>
        <td class="cf-note">${esc(e.note) || '<span style="color:var(--text3)">—</span>'}${tag}</td>
        <td class="cf-run" style="${run[k] < 0 ? 'color:var(--red);' : ''}">${failed ? '—' : money(run[k])}</td>
        <td><div class="cf-row-actions">${actions}</div></td>
      </tr>`;
    }).join('');
    let c = 0, d = 0; rows.filter(e => !(e._pending && e.state === 'failed')).forEach(e => { const p = Math.round(e.amount * 100); if (e.type === 'Credit') c += p; else d += p; });
    foot.style.display = 'flex';
    foot.innerHTML = `<span>দেখানো লেনদেনের মোট Credit: <strong style="color:var(--green)">${money(c / 100)}</strong></span><span>মোট Debit: <strong style="color:var(--red)">${money(d / 100)}</strong></span><span>নিট: <strong>${money((c - d) / 100)}</strong></span>`;
  }

  // মূল Dashboard-এর Cash Flow কার্ড
  function paintCard(balance, credit, debit) {
    const v = $('kpi-cashflow-balance'); if (!v) return;
    v.textContent = num(balance); v.style.color = balance < 0 ? 'var(--red)' : '';
    const s = $('kpi-cashflow-sub'); if (s) s.textContent = `Credit ৳${num(credit)} · Debit ৳${num(debit)}`;
  }
  async function refreshCard() {
    if (!$('kpi-cashflow-balance')) return;
    const d = await netGet('cashflow_summary');
    if (d && d.summary) paintCard(d.summary.currentBalance, d.summary.totalCredit, d.summary.totalDebit);
  }

  // ── Load ──
  async function load() {
    const d = await netGet('cashflow');
    if (!d || !Array.isArray(d.entries)) {
      if (!CF.loaded) $('cf-body').innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--red);padding:40px;">❌ Cash Flow ডেটা লোড হয়নি — API URL ও Apps Script-এর নতুন Deployment চেক করুন, তারপর 🔄 রিফ্রেশ চাপুন</td></tr>';
      render(); return false;
    }
    for (let i = 0; CF.inflight > 0 && i < 200; i++) await sleep(150);          // চলমান সেভ শেষ হওয়ার পর সার্ভারের তালিকা বসাই — নইলে নতুন এন্ট্রি মুছে যেতে পারে
    const s = d.summary || {}, onServer = new Set(d.entries.map(e => e.cid).filter(Boolean));
    CF.pending = CF.pending.filter(p => !onServer.has(p.cid)); obSave();        // যেগুলো আসলে সার্ভারে পৌঁছে গেছে সেগুলো আউটবক্স থেকে বাদ
    CF.entries = d.entries; CF.opening = Number(s.opening) || 0; CF.openingSet = !!s.openingSet; CF.openingDate = s.openingDate || '';
    CF.openingInitial = d.openingInitial || null; CF.openingHistory = Array.isArray(d.openingHistory) ? d.openingHistory : [];
    CF.loaded = true; render(); return true;
  }

  // ── Entry modal (Add / Edit) ──
  function setType(t) {
    CF.type = t;
    $('cf-type-credit').className = t === 'Credit' ? 'on-credit' : '';
    $('cf-type-debit').className = t === 'Debit' ? 'on-debit' : '';
    $('cf-modal-title').textContent = (CF.editId ? '✏️ এন্ট্রি Edit — ' : '') + (t === 'Credit' ? '＋ Credit (টাকা জমা)' : '− Debit (টাকা খরচ)');
  }
  function openEntry(type, id) {
    CF.editId = null; CF.cid = 'cf' + Date.now() + Math.random().toString(36).slice(2, 8);
    let amount = '', date = todayBD(), note = '';
    if (id != null) {
      const e = CF.entries.find(x => Number(x.id) === Number(id)); if (!e) { toast('এন্ট্রি পাওয়া যায়নি', 'error'); return; }
      if (e._sync) { toast('এই এন্ট্রি এখনো সেভ হচ্ছে — একটু অপেক্ষা করুন', 'info'); return; }
      CF.editId = Number(e.id); type = e.type; amount = e.amount; date = e.date || date; note = e.note || '';
    }
    $('cf-amount').value = amount; $('cf-date').value = date; $('cf-note').value = note;
    setType(type || 'Credit');
    $('modal-cf-entry').classList.add('open');
    setTimeout(() => { try { $('cf-amount').focus(); } catch (e) {} }, 80);
  }

  // সেভ: মডাল সঙ্গে সঙ্গে বন্ধ, এন্ট্রি সঙ্গে সঙ্গে তালিকা/ব্যালেন্সে; সার্ভারে যায় পেছনে (আলাদা রিফেচ ছাড়াই)
  async function submitEntry() {
    const amount = Number(String($('cf-amount').value).replace(/,/g, ''));
    const date = $('cf-date').value, note = $('cf-note').value.trim().slice(0, 500);
    if (!CF.editId && !CF.cid) return;                                       // ডাবল-ক্লিক: প্রথম ক্লিকেই cid ব্যবহার হয়ে গেছে
    if (!isFinite(amount) || amount <= 0) { toast('সঠিক টাকার পরিমাণ লিখুন (০ এর বেশি)', 'error'); return; }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) { toast('তারিখ বেছে নিন', 'error'); return; }
    const type = CF.type, amt = Math.round(amount * 100) / 100;
    if (CF.editId) {                                                          // ── Edit (আশাবাদী আপডেট; ব্যর্থ হলে আগের অবস্থায় ফেরে) ──
      const id = CF.editId, e = CF.entries.find(x => Number(x.id) === id); CF.editId = null;
      if (!e || e._sync) return;
      const old = { type: e.type, amount: e.amount, date: e.date, note: e.note };
      Object.assign(e, { type, amount: amt, date, note, _sync: true });
      closeModal('cf-entry'); render();
      const r = await track(() => netPost({ action: 'cfUpdateEntry', id, type, amount: amt, date, note }));
      e._sync = false;
      if (!r) { Object.assign(e, old); toast('❌ Edit সেভ হয়নি — আগের অবস্থায় ফেরানো হয়েছে', 'error'); }
      else { toast('✅ এন্ট্রি আপডেট হয়েছে', 'success'); try { logAction(`Cash Flow এডিট: ${type} ৳${num(amt)}`); } catch (x) {} }
      render(); return;
    }
    const it = { cid: CF.cid, type, amount: amt, date, note, state: 'saving' }; CF.cid = '';
    CF.pending.push(it); obSave(); closeModal('cf-entry'); render();
    sendPending(it);
  }
  async function sendPending(it) {
    it.state = 'saving'; render();
    const r = await track(() => netPost({ action: 'cfAddEntry', cid: it.cid, type: it.type, amount: it.amount, date: it.date, note: it.note }));
    if (!r) { it.state = 'failed'; obSave(); render(); toast('❌ সেভ হয়নি — তালিকায় লাল সারির 🔁 চাপুন (এন্ট্রি হারায়নি)', 'error'); return; }
    CF.pending = CF.pending.filter(p => p !== it); obSave();
    if (r.id != null) CF.entries.push({ id: Number(r.id), date: it.date, type: it.type, amount: it.amount, note: it.note, createdAt: '', cid: it.cid });
    render();
    toast(it.type === 'Credit' ? '✅ Credit সেভ হয়েছে' : '✅ Debit সেভ হয়েছে', 'success');
    try { logAction(`Cash Flow যোগ: ${it.type} ৳${num(it.amount)}`); } catch (x) {}
    if (r.id == null) load();
  }
  function retry(cid) { const it = CF.pending.find(p => p.cid === cid); if (it && it.state === 'failed') sendPending(it); }
  function retryAll() { CF.pending.filter(p => p.state === 'failed').forEach(sendPending); }
  function discard(cid) {
    const it = CF.pending.find(p => p.cid === cid); if (!it) return;
    if (!confirm(`এই এন্ট্রি বাদ দেবেন?\n\n${it.type} ৳${num(it.amount)} — ${fmtDate(it.date)}\n${it.note || ''}\n\n(এটি সেভ হয়নি; বাদ দিলে আর ফিরবে না)`)) return;
    CF.pending = CF.pending.filter(p => p !== it); obSave(); render();
  }

  async function del(id) {
    const idx = CF.entries.findIndex(x => Number(x.id) === Number(id)); if (idx < 0) return;
    const e = CF.entries[idx]; if (e._sync) return;
    if (!confirm(`⚠️ এই এন্ট্রি ডিলিট করবেন?\n\n${e.type} ৳${num(e.amount)} — ${fmtDate(e.date)}\n${e.note || ''}\n\n🗑️ এটি Recycle Bin-এ যাবে (৩০ দিনের মধ্যে Restore করা যাবে)। ব্যালেন্স নতুন করে হিসাব হবে।`)) return;
    CF.entries.splice(idx, 1); render();                                       // আশাবাদী: সঙ্গে সঙ্গে সরে যায়; ব্যর্থ হলে ফিরে আসে
    const r = await track(() => netPost({ action: 'cfDeleteEntry', id: Number(id) }));
    if (!r) { CF.entries.splice(Math.min(idx, CF.entries.length), 0, e); render(); toast('❌ ডিলিট হয়নি — এন্ট্রি ফিরিয়ে আনা হয়েছে', 'error'); return; }
    toast('🗑️ এন্ট্রি Recycle Bin-এ গেছে', 'info');
    try { logAction(`Cash Flow এন্ট্রি #${id} (${e.type} ৳${num(e.amount)}) Recycle Bin-এ পাঠিয়েছেন`); } catch (x) {}
    setTimeout(() => { try { if (typeof updateBinBadge === 'function') updateBinBadge(); } catch (x) {} }, 600);
  }

  // ── Opening Balance ──
  function openOpening() {
    CF.openCid = 'op' + Date.now() + Math.random().toString(36).slice(2, 8);
    $('cf-open-amount').value = CF.openingSet || CF.opening ? CF.opening : '';
    $('cf-open-date').value = CF.openingDate || '';
    $('cf-open-reason').value = '';
    const first = !CF.openingSet, info = $('cf-open-info');
    info.innerHTML = first
      ? 'এটি <b>প্রথমবার</b> Opening Balance সেট। এই মান ও তারিখ <b>প্রাথমিক রেকর্ড</b> হিসেবে চিরস্থায়ীভাবে সংরক্ষিত থাকবে।'
      : `বর্তমান Opening Balance: <b>${money(CF.opening)}</b>${CF.openingDate ? ' (' + fmtDate(CF.openingDate) + ' থেকে)' : ''}<br>পরিবর্তন করলে <b>আগের মান ইতিহাসে থেকে যাবে</b> — কোনো লেনদেন বা পুরোনো রেকর্ড মুছবে না; শুধু Current Balance নতুন করে হিসাব হবে।`;
    $('cf-open-reason-wrap').style.display = first ? 'none' : '';
    cfPreview();
    $('modal-cf-opening').classList.add('open');
    setTimeout(() => { try { $('cf-open-amount').focus(); } catch (e) {} }, 80);
  }
  function cfPreview() {
    const box = $('cf-open-preview'); if (!box) return;
    const raw = String($('cf-open-amount').value).replace(/,/g, '').trim(), amt = Number(raw), t = compute();
    if (raw === '' || !isFinite(amt) || amt < 0) { box.innerHTML = ''; return; }
    const nb = Math.round((Math.round(amt * 100) + Math.round(t.credit * 100) - Math.round(t.debit * 100))) / 100, diff = Math.round((amt - CF.opening) * 100) / 100;
    box.innerHTML = `<div style="padding:10px 12px;border-radius:8px;background:rgba(128,128,128,.1);border:1px solid var(--border);">
      ${CF.openingSet ? `Opening: ${money(CF.opening)} → <b>${money(amt)}</b> <span style="color:${diff >= 0 ? 'var(--green)' : 'var(--red)'};">(${diff >= 0 ? '+' : '−'}৳${num(Math.abs(diff))})</span><br>` : ''}
      Current Balance: ${money(t.balance)} → <b style="color:${nb < 0 ? 'var(--red)' : 'var(--gold)'};">${money(nb)}</b>
      <div style="color:var(--text3);font-size:11px;">= Opening ${money(amt)} + Credit ${money(t.credit)} − Debit ${money(t.debit)}</div></div>`;
  }
  async function submitOpening() {
    if (CF.busy) return;
    const raw = String($('cf-open-amount').value).replace(/,/g, '').trim(), amount = Number(raw);
    if (raw === '' || !isFinite(amount) || amount < 0) { toast('সঠিক Opening Balance লিখুন (০ বা তার বেশি)', 'error'); return; }
    const date = $('cf-open-date').value || '', reason = ($('cf-open-reason').value || '').trim();
    if (CF.openingSet && Math.round(amount * 100) === Math.round(CF.opening * 100) && date === (CF.openingDate || '')) { toast('কোনো পরিবর্তন নেই — এই মানই আগে থেকে আছে', 'info'); return; }
    if (CF.openingSet && reason.length < 3) { toast('পরিবর্তনের কারণ লিখুন (অডিট ট্রেইলের জন্য)', 'error'); try { $('cf-open-reason').focus(); } catch (e) {} return; }
    CF.busy = true; const btn = $('cf-open-save'); btn.disabled = true; btn.textContent = '⏳ সেভ হচ্ছে…';
    const by = (typeof currentPartner !== 'undefined' && currentPartner) ? currentPartner : '';
    try {
      const r = await track(() => netPost({ action: 'cfSetOpening', amount, date, reason, cid: CF.openCid, by }));
      if (!r || r.status === 'error') { toast('❌ ' + ((r && r.message) || 'সেভ হয়নি — আবার চেষ্টা করুন'), 'error'); return; }
      if (r.unchanged) { toast('কোনো পরিবর্তন নেই', 'info'); closeModal('cf-opening'); return; }
      CF.opening = Math.round(amount * 100) / 100; CF.openingSet = true; CF.openingDate = date;   // সার্ভারের অপেক্ষায় রিফেচ নয়
      closeModal('cf-opening'); render(); toast(r.duplicate ? 'ℹ️ এই পরিবর্তন আগেই সেভ হয়েছে' : '✅ Opening Balance সেভ হয়েছে — ইতিহাসে রেকর্ড রাখা হয়েছে', 'success');
