// Global DOM shorthand used throughout this module
function el(id) { return document.getElementById(id); }

// 📜 Equity % History Log — investorId দিলে শুধু সেই investor-এর, না দিলে সবার (global timeline)
async function openEquityHistoryModal(investorId) {
  const titleEl = el('eqh-modal-title');
  const body = el('eqh-body');
  body.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text3);">লোড হচ্ছে...</div>';
  openModal('equity-history');

  const oneInvestor = investorId && String(investorId).trim();
  titleEl.textContent = oneInvestor ? '📜 Equity History — ' + (oneInvestor) : '📜 Equity % History Log (সবাই)';

  try {
    const url = 'equity_history' + (oneInvestor ? ('&investorId=' + encodeURIComponent(oneInvestor)) : '');
    const data = await fetchFromAPI(url);
    if (!data || data.status !== 'ok') { body.innerHTML = '❌ History লোড ব্যর্থ'; return; }
    const rows = data.data || [];
    if (!rows.length) {
      body.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text3);">এখনো কোনো পরিবর্তনের রেকর্ড নেই।</div>';
      return;
    }
    body.innerHTML = rows.map(r => {
      const date = r[1], name = r[3], before = Number(r[4])||0, after = Number(r[5])||0, reason = r[6] || '';
      const up = after > before;
      const arrowColor = up ? 'var(--green)' : (after < before ? 'var(--red)' : 'var(--text3)');
      const arrow = up ? '▲' : (after < before ? '▼' : '—');
      let dateStr = date;
      try { dateStr = new Intl.DateTimeFormat('bn-BD',{timeZone:'Asia/Dhaka',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date(date)); } catch(e){}
      return `<div style="background:var(--bg2);border-radius:8px;padding:10px 14px;border-left:3px solid ${arrowColor};">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
          <div style="font-weight:600;color:var(--text);font-size:13px;">${name}</div>
          <div style="font-size:12px;color:${arrowColor};font-weight:700;">${before.toFixed(2)}% → ${after.toFixed(2)}% ${arrow}</div>
        </div>
        <div style="font-size:11px;color:var(--text3);margin-top:3px;">${reason}</div>
        <div style="font-size:10px;color:var(--text3);margin-top:2px;">${dateStr}</div>
      </div>`;
    }).join('');
  } catch(e) { body.innerHTML = '❌ Error: ' + e.message; }
}

async function loadInvestors() {
  try {
    const data = await fetchFromAPI('investors');
    if (!data || data.status !== 'ok') { showToast('Investor লোড ব্যর্থ', 'error'); return; }
    _investorData = data.data || [];
    _equityPoolTotal = Number(data.equityPoolTotal) || 0;
    renderInvestors(_investorData);
    updateInvestorSummary(_investorData);
    renderInvestorAlertsPanel(_investorData);
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

function updateInvestorSummary(rows) {
  const active   = rows.filter(r => String(r[7]||'').trim() === 'Active');
  const totalAmt = active.reduce((s,r) => s + (Number(r[4])||0), 0);
  el('inv-total-count') && (el('inv-total-count').textContent = rows.length);
  el('inv-active-count') && (el('inv-active-count').textContent = active.length);
  el('inv-total-amt') && (el('inv-total-amt').textContent = fmt(totalAmt));
  el('inv-equity-pool-total') && (el('inv-equity-pool-total').textContent = fmt(_equityPoolTotal));
  runInvestorSanityCheck(rows);
  // total profit paid: loaded from transactions separately
  loadInvestorTotalPaid();
}

// ✅ Sanity-Check Validator — Equity %-এর যোগফল ঠিক ১০০% হচ্ছে কিনা,
// আর কোনো Fixed Return investor-এর গায়ে ভুলবশত Equity % বসে গেছে কিনা
function runInvestorSanityCheck(rows) {
  const box = el('inv-sanity-check');
  if (!box) return;

  const activeEquity = rows.filter(r => String(r[7]||'').trim()==='Active' && String(r[9]||'Equity')==='Equity');
  const pctSum = activeEquity.reduce((s,r) => s + (Number(r[5])||0), 0);
  const pctDiff = Math.round((pctSum - 100) * 100) / 100; // 2 decimal

  const badFixed = rows.filter(r => String(r[7]||'').trim()==='Active' && String(r[9]||'')==='Fixed Return' && Math.abs(Number(r[5])||0) > 0.01);

  const problems = [];
  if (activeEquity.length > 0 && Math.abs(pctDiff) > 0.5) {
    problems.push(`Equity %-এর যোগফল ${pctSum.toFixed(2)}% (হওয়া উচিত ১০০%, পার্থক্য ${pctDiff>0?'+':''}${pctDiff}%)`);
  }
  if (badFixed.length > 0) {
    problems.push(`${badFixed.length} জন Fixed Return investor-এর গায়ে ভুলভাবে Equity % বসে আছে`);
  }

  if (!problems.length) {
    box.innerHTML = `<span title="Equity %-এর যোগফল ঠিক ১০০% এবং কোনো টাইপ-মিশ্রণ নেই" style="cursor:help;background:rgba(52,209,116,.15);color:var(--green);border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;">✅ ১০০% ম্যাচ</span>`;
  } else {
    box.innerHTML = `<span title="${problems.join(' | ')}" style="cursor:help;background:rgba(248,81,73,.15);color:var(--red);border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;">⚠️ Mismatch — বিস্তারিত দেখতে হোভার করুন</span>`;
  }
}

function _fmtShortDate(iso) {
  if (!iso) return '—';
  try {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return String(iso);
    return new Intl.DateTimeFormat('en-BD',{timeZone:'Asia/Dhaka',day:'2-digit',month:'short'}).format(d);
  } catch(e) { return String(iso); }
}

