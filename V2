  } else if(kind==='plan'){
    icon='🧭'; title = it.title||'Plan';
    badges = `<span class="status ${it.type==='Long-Term'?'processing':'pending'}">${shEsc(it.type)}</span> <span class="status ${SH_STATUS_CSS[it.status]||'pending'}">${shEsc(it.status)}</span>`;
    meta.push(['🎯 লক্ষ্য তারিখ', shDueCell(it.targetDate, it.status==='Achieved')], ['💰 বাজেট', '৳'+(it.budget||0).toLocaleString()], ['👤 Owner', shEsc(person(it.owner))], ['🔢 ID', '#'+shEsc(it.id)]);
    bodyParts.push(shReaderSection('মাইলস্টোন / ধাপসমূহ', it.milestones));
  } else {
    icon='💡'; title = it.title||'Idea';
    badges = `<span class="status ${SH_STATUS_CSS[it.status]||'pending'}">${shEsc(it.status)}</span>`;
    meta.push(['📅 তারিখ', shFmtDate(it.date)], ['👤 প্রস্তাবক', shEsc(person(it.proposedBy))], ['🔢 ID', '#'+shEsc(it.id)]);
    bodyParts.push(shReaderSection('বিস্তারিত বিবরণ', it.description), shReaderSection('Action Plan Notes', it.actionNotes));
  }
  const bodyHtml = bodyParts.join('') || '<div class="sh-rd-empty">আর কোনো বিস্তারিত লেখা নেই।</div>';
  document.getElementById('sh-reader-content').innerHTML = `
    <div class="sh-rd-head"><div class="sh-rd-title">${icon} ${shEsc(title)}</div><div class="sh-rd-badges">${badges}</div></div>
    <div class="sh-rd-meta">${meta.map(m=>`<div><span>${m[0]}</span><b>${m[1]}</b></div>`).join('')}</div>
    <div class="sh-rd-body">${bodyHtml}</div>`;
  document.getElementById('sh-reader-actions').innerHTML = `
    ${kind==='idea' ? `<button class="btn btn-gold" onclick="shIdeaTo('plan','${shEsc(id)}')">🧭 Plan বানাও</button><button class="btn btn-gold" onclick="shIdeaTo('task','${shEsc(id)}')">✅ Task বানাও</button>` : ''}
