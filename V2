    const find = vs => hd.findIndex(h => h && vs.some(v => h === v || h.includes(v)));
    const ci = { name: find(['name', 'নাম', 'salesman']), ps: find(['per sale', 'persale', 'প্রতি সেল', 'কমিশন', 'commission']), sal: find(['salary', 'বেতন']), note: find(['note', 'নোট']), act: find(['active', 'সক্রিয়']) };
