// ═══════════════════════════════════════════════════════════════
// DASHBOARD KPI FILTER — Year / Month / All-Time Dropdown Logic
// ═══════════════════════════════════════════════════════════════
(function(){
  'use strict';
  // ── State ──
  var _dashYear   = 0;    // 0 = all
  var _dashMonth  = 0;    // 0 = all
  var _dashAllTime= true; // default: all-time

  var MONTH_NAMES = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন',
                     'জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];

  // ── Parse date (reuse same logic as FA modal) ──
  function parseD(raw){
    if(!raw) return null;
    if(typeof raw==='number') return new Date((raw-25569)*86400*1000);
    var s=String(raw).trim();
    if(s.indexOf('T')>-1){ var d=new Date(s); return isNaN(d.getTime())?null:d; }
    var m=s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})/);
    if(m){ var mons={Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11}; return new Date(parseInt(m[3]),mons[m[2]]||0,parseInt(m[1])); }
    var fb=new Date(s); return isNaN(fb.getTime())?null:fb;
  }

  // ── Format taka ──
  function fmt(n){ return '৳'+Math.round(Number(n)||0).toLocaleString('en-BD'); }

  // ── Update dashboard KPI cards with filtered data ──
  function applyDashFilter(){
    var sales    = window.allSales    ||(typeof liveSalesData   !=='undefined'?liveSalesData   :[])||[];
    var expenses = window.allExpenses ||(typeof liveExpenseData !=='undefined'?liveExpenseData :[])||[];

    // Filter sales
    var filtSales = sales.filter(function(o){
      if(_dashAllTime) return true;
      var d = parseD(o.rawDateISO||o.rawDate||o.date||'');
      if(!d) return (_dashYear===0 && _dashMonth===0);
      var yOk = _dashYear===0  || d.getFullYear()===_dashYear;
      var mOk = _dashMonth===0 || (d.getMonth()+1)===_dashMonth;
      return yOk && mOk;
    });

    // Filter expenses
    var filtExp = expenses.filter(function(e){
      if(_dashAllTime) return true;
      var d = parseD(e.rawDate||e.date||'');
      if(!d) return (_dashYear===0 && _dashMonth===0);
      var yOk = _dashYear===0  || d.getFullYear()===_dashYear;
      var mOk = _dashMonth===0 || (d.getMonth()+1)===_dashMonth;
      return yOk && mOk;
    });

    // Revenue = sum of Delivered orders
    var revenue = filtSales
      .filter(function(o){ return String(o.status||'').trim()==='Delivered'; })
      .reduce(function(s,o){ return s+(Number(o.total)||0); }, 0);

    // Expenses total
    var expTotal = filtExp.reduce(function(s,e){ return s+(Number(e.amount)||0); }, 0);

    // Net Profit
    var _g = (typeof window.igpDash==='function') ? window.igpDash(filtSales, _dashAllTime) : null;
    var _cogs = _g ? _g.cogs : 0;
    var profit = revenue - _cogs - expTotal;
    if(_g){ _g = {revenue:revenue, cogs:_cogs, gross:revenue-_cogs}; window.igpCard(_g); }

    // Due = non-cancelled, non-returned orders due
    var due = filtSales.reduce(function(s,o){
      var st = String(o.status||'').trim();
      if(st==='Cancelled'||st==='Returned') return s;
      return s + (Number(o.due)||0);
    }, 0);

    // Pending count
    var pending = filtSales.filter(function(o){ return String(o.status||'').trim()==='Pending'; }).length;
    var delivered = filtSales.filter(function(o){ return String(o.status||'').trim()==='Delivered'; }).length;

    // Update KPI elements
    function setEl(id,val){ var el=document.getElementById(id); if(el) el.textContent=val; }
    setEl('kpi-revenue', Math.round(revenue).toLocaleString('en-BD'));
    setEl('kpi-profit',  Math.round(profit).toLocaleString('en-BD'));
    setEl('kpi-expense', Math.round(expTotal).toLocaleString('en-BD'));
    setEl('kpi-due',     Math.round(due).toLocaleString('en-BD'));
    setEl('kpi-pending', String(pending));
    setEl('kpi-delivered', String(delivered));

    // Update filter info badge
    var info = document.getElementById('dash-filter-info');
    if(info){
      if(_dashAllTime){
        info.textContent = 'সব ডেটা — '+filtSales.length+'টি অর্ডার';
      } else {
        var yStr = _dashYear>0 ? _dashYear+' সাল' : 'সব বছর';
        var mStr = _dashMonth>0 ? MONTH_NAMES[_dashMonth-1] : 'সব মাস';
        info.textContent = mStr+' / '+yStr+' — '+filtSales.length+'টি অর্ডার';
      }
    }

    // Update KPI change labels
    var revCh = document.getElementById('kpi-revenue-change');
    var prCh  = document.getElementById('kpi-profit-change');
    if(revCh && !_dashAllTime && (_dashYear>0||_dashMonth>0)){
      revCh.textContent = '💰 '+fmt(revenue);
      revCh.className = 'kpi-change up';
    }
    if(prCh && !_dashAllTime && (_dashYear>0||_dashMonth>0)){
      prCh.textContent = (profit>=0?'▲ ':'▼ ')+fmt(Math.abs(profit));
      prCh.className = 'kpi-change '+(profit>=0?'up':'down');
    }
  }

  // ── Populate year dropdown from liveSalesData ──
  function populateDashYears(){
    var sales = window.allSales||(typeof liveSalesData!=='undefined'?liveSalesData:[])||[];
    var years = {};
    sales.forEach(function(o){
      var d = parseD(o.rawDateISO||o.rawDate||o.date||'');
      if(d) years[d.getFullYear()]=1;
    });
    var sorted = Object.keys(years).map(Number).sort(function(a,b){return b-a;});
    var sel = document.getElementById('dash-year-sel');
    if(!sel) return;
    var curVal = sel.value;
    sel.innerHTML = '<option value="0">সব বছর</option>';
    sorted.forEach(function(y){
      var opt = document.createElement('option');
      opt.value=y; opt.textContent=y+' সাল';
      if(Number(curVal)===y) opt.selected=true;
      sel.appendChild(opt);
    });
  }

  // ── Update UI state (All-Time button active/inactive) ──
  function updateDashUI(){
    var allBtn  = document.getElementById('dash-alltime-btn');
    var yearSel = document.getElementById('dash-year-sel');
    var monthSel= document.getElementById('dash-month-sel');
    if(allBtn) allBtn.classList.toggle('active', _dashAllTime);
    if(yearSel){  yearSel.disabled =_dashAllTime; yearSel.style.opacity =_dashAllTime?'0.4':'1'; }
    if(monthSel){ monthSel.disabled=_dashAllTime; monthSel.style.opacity=_dashAllTime?'0.4':'1'; }
  }

  // ── Public handlers ──
  window.setDashAllTime = function(){
    _dashAllTime = !_dashAllTime;
    if(_dashAllTime){
      _dashYear=0; _dashMonth=0;
      var ySel=document.getElementById('dash-year-sel');
      var mSel=document.getElementById('dash-month-sel');
      if(ySel) ySel.value='0';
      if(mSel) mSel.value='0';
    }
    updateDashUI();
    applyDashFilter();
  };

  window.onDashFilterChange = function(){
    var ySel  = document.getElementById('dash-year-sel');
    var mSel  = document.getElementById('dash-month-sel');
    _dashYear  = ySel  ? parseInt(ySel.value) ||0 : 0;
    _dashMonth = mSel  ? parseInt(mSel.value) ||0 : 0;
    if(_dashYear>0 || _dashMonth>0){
      _dashAllTime = false;
    } else {
      _dashAllTime = true;
    }
    updateDashUI();
    applyDashFilter();
  };

  // ── Auto-populate years after sales load ──
  window._dashFilterRefresh = function(){
    populateDashYears();
    applyDashFilter();
  };

  // ── Initial state ──
  updateDashUI();
})();

async function loadLiveDashboard(){
  const data = await fetchFromAPI('dashboard'); if(!data) return;

  // ── Helpers ──
  const toFloat = v => { const n = parseFloat(String(v||'').replace(/[^0-9.-]/g,'')); return isNaN(n)?0:n; };
  const fmt = n => Math.round(toFloat(n)).toLocaleString('en-BD');
  const setEl = (id, val) => { const el=document.getElementById(id); if(el) el.textContent=val; };
  const setChange = (id, curr, prev) => {
    const el = document.getElementById(id); if(!el) return;
    if(prev === 0){ el.textContent = curr > 0 ? '▲ নতুন' : '—'; el.className='kpi-change '+(curr>0?'up':''); return; }
    const pct = Math.round(((curr - prev) / Math.abs(prev)) * 100);
    const sign = pct >= 0 ? '▲' : '▼';
    el.textContent = sign + ' ' + Math.abs(pct) + '% from last month';
    el.className = 'kpi-change ' + (pct >= 0 ? 'up' : 'down');
  };

  // ── Core values ──
  const totalRevenue  = toFloat(data.revenue);
  const totalExpenses = toFloat(data.expenses);
  const totalCOGS     = toFloat(data.cogs);
  const netProfit     = totalCOGS > 0
    ? (totalRevenue - totalCOGS - totalExpenses)
    : toFloat(data.profit) || (totalRevenue - totalExpenses);
  const totalDue = toFloat(data.due);

  window._dashBackend = {revenue: totalRevenue, cogs: totalCOGS, expenses: totalExpenses};
  setEl('kpi-revenue',   fmt(totalRevenue));
  setEl('kpi-profit',    fmt(netProfit));
  try{ window.igpCard({revenue: totalRevenue, cogs: totalCOGS, gross: totalRevenue - totalCOGS}); }catch(_e){}
  setEl('kpi-expense',   fmt(totalExpenses));
  setEl('kpi-due',       fmt(totalDue));
  setEl('kpi-pending',   String(Number(data.pending)   || 0));
  setEl('kpi-delivered', String(Number(data.delivered) || 0));
  setEl('kpi-capital',   fmt(data.capital));
  setEl('kpi-stock',     String(Number(data.stock) || 0));

  // Investor KPI
  if(data.invTotalAmt !== undefined){
    setEl('kpi-total-investment', fmt(data.invTotalAmt));
