const SH_STATUS_CSS = { // .status CSS ক্লাসের সাথে মিলিয়ে রঙ ব্যবহার
  'Pending':'pending', 'In Progress':'intransit', 'Completed':'delivered',
  'Planning':'pending', 'Active':'intransit', 'Achieved':'delivered',
  'New Idea':'pending', 'Under Review':'processing', 'Approved':'delivered', 'Archived':'cancelled',
};
const SH_PRIORITY_CSS = { 'High':'cancelled', 'Medium':'processing', 'Low':'delivered' };

function showStrategyTab(tab){
  ['tasks','plans','ideas'].forEach(t=>{
    document.getElementById('sh-section-'+t).style.display = (t===tab)?'block':'none';
    const btn = document.getElementById('sh-tab-'+t);
    if(btn){
      btn.classList.toggle('active', t===tab);
      btn.style.background = (t===tab) ? 'rgba(88,166,255,.15)' : '';
      btn.style.borderColor = (t===tab) ? 'rgba(88,166,255,.4)' : '';
      btn.style.color = (t===tab) ? '#58a6ff' : '';
    }
  });
}

async function loadStrategyHubAll(){
  await Promise.all([loadLiveDailyTasks(), loadLiveStrategyPlans(), loadLiveIdeaNotes()]);
}

// ─── DAILY TASKS ──────────────────────────────────────────────
async function loadLiveDailyTasks(){
  const data = await fetchFromAPI('dailyTasks');
  if(!data || !data.data){ liveDailyTasksData = []; renderDailyTasksTable(); return; }
  liveDailyTasksData = data.data.map(r => ({
    id: r[0], date: String(r[1]||''), assignedTo: String(r[2]||''),
    description: String(r[3]||''), priority: String(r[4]||'Medium'),
    status: String(r[5]||'Pending'), remarks: String(r[6]||''), deadline: String(r[7]||''),
  })).filter(t => t.id !== '' && t.id != null);
  renderDailyTasksTable();
}
function renderDailyTasksTable(){
  const filterStatus = document.getElementById('sh-task-filter-status')?.value || '';
  let rows = liveDailyTasksData.slice().reverse(); // নতুনগুলো আগে
  if(filterStatus==='__overdue') rows = rows.filter(t => shDueInfo(t.deadline, t.status==='Completed').overdue);
  else if(filterStatus) rows = rows.filter(t => t.status === filterStatus);
  rows = shSearch(rows, 'sh-task-search', ['id','description','assignedTo','remarks','priority']);
  _shVisible.task = rows.map(t => String(t.id));
  const body = document.getElementById('sh-tasks-body');
  if(!rows.length){
    body.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--text3);padding:40px;">কোনো Task নেই — "+ নতুন Task" চাপুন</td></tr>';
    document.getElementById('sh-tasks-showing').textContent = 'Showing 0 records';
    return;
  }
  body.innerHTML = rows.map(t => `<tr class="sh-row" onclick="shOpenReader('task','${shEsc(String(t.id))}')" title="খুলে পড়তে ক্লিক করুন">
    <td class="mono muted">${shEsc(t.id)}</td>
    <td class="mono">${shFmtDate(t.date)}</td>
    <td><strong>${shEsc(t.assignedTo==='Ashik'?'Partner B (Golam Rabbi)':t.assignedTo)}</strong></td>
    <td><div class="sh-preview">${shEsc(t.description)||'—'}</div></td>
    <td>${shDueCell(t.deadline, t.status==='Completed')}</td>
    <td><span class="status ${SH_PRIORITY_CSS[t.priority]||'pending'}">${shEsc(t.priority)}</span></td>
    <td>
      <span class="status ${SH_STATUS_CSS[t.status]||'pending'}" style="cursor:pointer;" onclick="event.stopPropagation();shCycleTaskStatus('${shEsc(String(t.id))}')" title="ক্লিক করে Status পরিবর্তন করুন">
        ${t.status==='Completed'?'✅':t.status==='In Progress'?'🔄':'⏳'} ${shEsc(t.status)}
      </span>
    </td>
    <td><div class="sh-preview sh-preview-sm">${shEsc(t.remarks)||'—'}</div></td>
    <td class="sh-actions">
      <button class="btn" style="padding:4px 10px;font-size:11px;" onclick="event.stopPropagation();shEditItem('task','${shEsc(String(t.id))}')">✏️</button>
      <button class="btn" style="padding:4px 8px;font-size:11px;background:var(--red);color:#fff;border-color:var(--red);" onclick="event.stopPropagation();shDeleteItem('task','${shEsc(String(t.id))}')">🗑️</button>
    </td>
  </tr>`).join('');
  { const od = rows.filter(t=>shDueInfo(t.deadline,t.status==='Completed').overdue).length; document.getElementById('sh-tasks-showing').textContent = `Showing ${rows.length} record(s)` + (od?` · ⚠️ ${od} টি Overdue`:''); }
}
// Status বাটনে ক্লিক করলে Pending → In Progress → Completed → Pending চক্রে যায় (instant toggle)
async function shCycleTaskStatus(taskId){
  const cur = liveDailyTasksData.find(x => String(x.id)===String(taskId));
  const currentStatus = cur ? cur.status : 'Pending';
  const next = currentStatus==='Pending' ? 'In Progress' : currentStatus==='In Progress' ? 'Completed' : 'Pending';
  const result = await postToAPI({ action:'updateTaskStatus', taskId, status: next });
  if(!result) return;
  const t = liveDailyTasksData.find(x => String(x.id)===String(taskId));
  if(t) t.status = next;
  renderDailyTasksTable();
  showToast('✅ Task status: ' + next, 'success');
  logAction('Task #'+taskId+' স্ট্যাটাস পরিবর্তন করেছেন → '+next);
}
