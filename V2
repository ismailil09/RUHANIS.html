function updateProfitDefaults() {
  const proj = document.getElementById('order-project')?.value || 'RUHANIS';
  const def = PROJECT_SPLITS[proj] || { Ismail:50, Ashik:50 };
  const si = document.getElementById('split-ismail');
  const sa = document.getElementById('split-ashik');
  if(si) si.value = def.Ismail;
  if(sa) sa.value = def.Ashik;
  updateCompanyFundPreview();
