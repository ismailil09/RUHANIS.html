// ═══════════════════════════════════════════════════════════════
// FINANCIAL ANALYTICS — Premium Modal Engine
// Handles Revenue & Profit with Weekly / Monthly / Yearly tabs
// ═══════════════════════════════════════════════════════════════
(function(){
  'use strict';

  // ── private state ──
  var _type    = 'revenue'; // 'revenue' | 'profit'
  var _period  = 'monthly'; // 'weekly' | 'monthly' | 'yearly' | 'custom'
  var _accent  = 'green';   // 'green' | 'gold'
  var _selYear = 0;         // 0 = all years
  var _selMonth= 0;         // 0 = all months
  var _allTime = false;     // true = শুরু থেকে শেষ পর্যন্ত

  // ── Date parser: handles GSheet serial, ISO, and BD text ──
  function parseDate(raw){
    if(!raw) return null;
    if(typeof raw==='number'){
      // Google Sheets serial (days since Dec 30 1899)
      return new Date((raw-25569)*86400*1000);
    }
    var s=String(raw).trim();
    if(!s) return null;
    // ISO  e.g. "2026-05-28T18:00:00.000Z"
    if(s.indexOf('T')>-1){
      var d=new Date(s);
      return isNaN(d.getTime())?null:d;
    }
    // BD text  e.g. "28-May-2026 06:30 PM"
    var m=s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})/);
    if(m){
      var mons={Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
      return new Date(parseInt(m[3]),mons[m[2]]||0,parseInt(m[1]));
    }
    // Last-resort
    var fb=new Date(s);
    return isNaN(fb.getTime())?null:fb;
  }

  // ── Taka formatter with bn-BD grouping ──
  function taka(n){
    var v=Math.round(Number(n)||0);
    try{ return '৳'+v.toLocaleString('bn-BD'); }
    catch(e){ return '৳'+v.toLocaleString(); }
  }

  // ── Period boundaries ──
  function getBounds(period){
    var now=new Date();
    var today=new Date(now.getFullYear(),now.getMonth(),now.getDate());

    if(period==='weekly'){
      var cEnd=new Date(today); cEnd.setHours(23,59,59,999);
      var cStart=new Date(today); cStart.setDate(today.getDate()-6); cStart.setHours(0,0,0,0);
      var pEnd=new Date(cStart); pEnd.setDate(pEnd.getDate()-1); pEnd.setHours(23,59,59,999);
      var pStart=new Date(pEnd); pStart.setDate(pEnd.getDate()-6); pStart.setHours(0,0,0,0);
      // Format label as "DD MMM – DD MMM"
      var fmt2=function(d){return d.getDate()+' '+'JanFebMarAprMayJunJulAugSepOctNovDec'.substr(d.getMonth()*3,3);};
      return{
        curr:{s:cStart,e:cEnd},
        prev:{s:pStart,e:pEnd},
        cLbl:fmt2(cStart)+' – '+fmt2(cEnd),
        pLbl:fmt2(pStart)+' – '+fmt2(pEnd)
      };
    }

    if(period==='monthly'){
      var mn=now.getMonth(), yr=now.getFullYear();
      var cStart=new Date(yr,mn,1,0,0,0,0);
      var cEnd=new Date(yr,mn+1,0,23,59,59,999);
      var pmn=mn===0?11:mn-1, pyr=mn===0?yr-1:yr;
      var pStart=new Date(pyr,pmn,1,0,0,0,0);
      var pEnd=new Date(pyr,pmn+1,0,23,59,59,999);
      var mnames=['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
      return{
        curr:{s:cStart,e:cEnd},
        prev:{s:pStart,e:pEnd},
        cLbl:mnames[mn]+' '+yr,
        pLbl:mnames[pmn]+' '+pyr
      };
    }

    // yearly
    var yr=now.getFullYear();
    return{
      curr:{s:new Date(yr,0,1,0,0,0,0),   e:new Date(yr,11,31,23,59,59,999)},
      prev:{s:new Date(yr-1,0,1,0,0,0,0), e:new Date(yr-1,11,31,23,59,59,999)},
      cLbl:yr+' সাল',
      pLbl:(yr-1)+' সাল'
    };
  }

  // ── Filter array by date field within [start, end] ──
  function filterPeriod(arr, dateField, start, end){
    return arr.filter(function(item){
      var raw=item[dateField]||item.rawDateISO||item.rawDate||'';
      var d=parseDate(raw);
      if(!d) return false;
      return d>=start && d<=end;
    });
  }

  // ── Revenue sum from Delivered orders ──
  function sumRevenue(salesArr){
    return salesArr
      .filter(function(o){return String(o.status||'').trim()==='Delivered';})
      .reduce(function(s,o){return s+(Number(o.total)||0);},0);
  }

  // ── Expense sum ──
  function sumExpenses(expArr){
    return expArr.reduce(function(s,e){return s+(Number(e.amount)||0);},0);
  }

  // ── Percentage change badge ──
  function badge(curr,prev){
    if(prev===0&&curr===0) return '<span class="fa-badge neutral">── পরিবর্তন নেই</span>';
    if(prev===0) return '<span class="fa-badge growth">↑ নতুন ডেটা</span>';
    var pct=((curr-prev)/Math.abs(prev))*100;
    var abs=Math.abs(pct).toFixed(1);
    if(pct>0) return '<span class="fa-badge growth">↑ '+abs+'% Growth</span>';
    if(pct<0) return '<span class="fa-badge decline">↓ '+abs+'% Decline</span>';
    return '<span class="fa-badge neutral">── কোনো পরিবর্তন নেই</span>';
  }

  // ── Top-5 bar breakdown ──
  function buildBars(items, valKey, lblKey, color){
    if(!items||!items.length) return '';
    var sorted=items.slice().sort(function(a,b){return b[valKey]-a[valKey];}).slice(0,5);
    var max=sorted[0][valKey]||1;
    return sorted.map(function(item){
      var pct=Math.round((item[valKey]/max)*100);
      var lbl=String(item[lblKey]||'—').substring(0,16);
      return '<div class="fa-bar-row">'
        +'<span class="fa-bar-label" title="'+String(item[lblKey]||'')+'">'+lbl+'</span>'
        +'<div class="fa-bar-track"><div class="fa-bar-fill" style="width:'+pct+'%;background:'+color+';"></div></div>'
        +'<span class="fa-bar-val">'+taka(item[valKey])+'</span>'
        +'</div>';
    }).join('');
  }

  // ── Mini orders table ──
  function buildOrdersTable(rows){
    if(!rows||!rows.length) return '<div class="fa-empty">এই পিরিয়ডে কোনো Delivered অর্ডার নেই</div>';
    var top=rows.slice().sort(function(a,b){return (Number(b.total)||0)-(Number(a.total)||0);}).slice(0,8);
    return '<div style="overflow-x:auto;"><table class="fa-mini-table">'
      +'<thead><tr><th>#ID</th><th>তারিখ</th><th>কাস্টমার</th><th>প্রোডাক্ট</th><th style="text-align:right;">Total</th></tr></thead><tbody>'
      +top.map(function(o){
        return '<tr>'
          +'<td style="color:var(--text3);">#'+String(o.id||'—')+'</td>'
          +'<td>'+String(o.date||'—')+'</td>'
          +'<td style="color:var(--text);">'+String(o.customer||'—')+'</td>'
          +'<td>'+String(o.product||'—')+'</td>'
          +'<td style="color:var(--green);font-weight:700;text-align:right;font-family:\'IBM Plex Mono\',monospace;">'+taka(o.total)+'</td>'
          +'</tr>';
      }).join('')
      +'</tbody></table></div>';
  }

  // ── Main render ──
  function render(){
    var body=document.getElementById('fa-body');
    if(!body) return;
    body.innerHTML='<div class="fa-empty">বিশ্লেষণ করা হচ্ছে...</div>';

    var sales   =window.allSales   ||(typeof liveSalesData   !=='undefined'?liveSalesData   :[])||[];
    var expenses=window.allExpenses||(typeof liveExpenseData !=='undefined'?liveExpenseData :[])||[];

    var accent=_type==='profit'?'gold':'green';
    var cSales, pSales, cExp, pExp;
    var currLabel='', prevLabel='', showBadge=true;

    if(_allTime){
      // ── All-Time mode: সব ডেটা একসাথে, কোনো period comparison নেই ──
      cSales = sales;
      pSales = [];
      cExp   = expenses;
      pExp   = [];
      currLabel = 'শুরু থেকে এখন পর্যন্ত';
      prevLabel = '—';
      showBadge = false;
    } else if(_selYear > 0 || _selMonth > 0){
      // ── Custom dropdown filter mode ──
      cSales = sales.filter(function(o){
        var d = parseDate(o.rawDateISO||o.rawDate||o.date||'');
        if(!d) return _selYear===0 && _selMonth===0;
        var yMatch = _selYear===0 || d.getFullYear()===_selYear;
        var mMatch = _selMonth===0 || (d.getMonth()+1)===_selMonth;
        return yMatch && mMatch;
      });
      pSales = [];
      cExp = expenses.filter(function(e){
        var d = parseDate(e.rawDate||e.date||'');
        if(!d) return _selYear===0 && _selMonth===0;
        var yMatch = _selYear===0 || d.getFullYear()===_selYear;
        var mMatch = _selMonth===0 || (d.getMonth()+1)===_selMonth;
        return yMatch && mMatch;
      });
      pExp = [];
