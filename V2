let chartState = { months: 6, year: 0, data: null }; // persists between redraws

// ─── CHART CONTROLS ──────────────────────────────────────────
function setChartMonths(n) {
  chartState.months = n;
  chartState.year   = 0; // rolling mode when switching months
  const sel = document.getElementById('chart-year-sel');
  if (sel) sel.value = '0';
  _styleChartButtons(n);
  _reloadChartFromAPI();
}

function onChartControlChange() {
  const sel = document.getElementById('chart-year-sel');
  chartState.year = parseInt(sel ? sel.value : '0') || 0;
  _styleChartButtons(chartState.year > 0 ? 12 : chartState.months);
  _reloadChartFromAPI();
}

function _styleChartButtons(activeMonths) {
  const b6  = document.getElementById('btn-6mo');
  const b12 = document.getElementById('btn-12mo');
  if (!b6 || !b12) return;
  if (activeMonths === 12) {
    b12.style.background = 'var(--gold)'; b12.style.color = '#000'; b12.style.fontWeight = '700';
    b6.style.background  = 'var(--bg3)';  b6.style.color  = 'var(--text3)'; b6.style.fontWeight = 'normal';
  } else {
    b6.style.background  = 'var(--gold)'; b6.style.color  = '#000'; b6.style.fontWeight = '700';
    b12.style.background = 'var(--bg3)';  b12.style.color = 'var(--text3)'; b12.style.fontWeight = 'normal';
  }
}

async function _reloadChartFromAPI() {
  const params = `months=${chartState.months}&year=${chartState.year}`;
  const data = await fetchFromAPI('dashboard&' + params);
  if (data) { chartState.data = data; drawChart(data); }
}

function _populateYearDropdown(currentYear) {
  const sel = document.getElementById('chart-year-sel');
  if (!sel) return;
  // Keep "Rolling" option, add years from 2023 up to current year
  const startYear = 2023;
  const existing = Array.from(sel.options).map(o => o.value);
  for (let y = startYear; y <= currentYear; y++) {
    if (!existing.includes(String(y))) {
      const opt = document.createElement('option');
      opt.value = y; opt.textContent = y;
      sel.appendChild(opt);
    }
  }
  // Set to current selected year
  sel.value = String(chartState.year);
}


// ─── CHART.JS — MAIN DRAW FUNCTION ──────────────────────────
// drawChart(liveData) — renders both charts from live backend data.
// Falls back to demo data at boot (before API loads).
window._revChart = null; // Chart.js instance reference
window._lastChartData = null; // last data for theme re-render

function drawChart(liveData) {
  window._lastChartData = liveData;

  // ── 1. Revenue vs Profit — Chart.js Bar Chart ────────────
  const hasMonthly = liveData && liveData.monthlyChart &&
                     Array.isArray(liveData.monthlyChart.labels) &&
                     liveData.monthlyChart.labels.length > 0;

  const months  = hasMonthly ? liveData.monthlyChart.labels  : ['Jan','Feb','Mar','Apr','May','Jun'];
  const revenue = hasMonthly ? liveData.monthlyChart.revenue : [185000,210000,195000,245000,230000,284500];
  const profit  = hasMonthly ? liveData.monthlyChart.profit  : [42000, 55000, 48000, 68000, 61000, 72300];

  // Populate year dropdown once we know the current year from data
  const nowYear = new Date().getFullYear();
  _populateYearDropdown(nowYear);
  if (chartState.year > 0) {
    const sel = document.getElementById('chart-year-sel');
    if (sel) sel.value = String(chartState.year);
  }

  // Update subtitle
  const sub = document.getElementById('rev-chart-sub');
  if (sub) {
    if (chartState.year > 0) sub.textContent = 'Full year ' + chartState.year;
    else sub.textContent = 'Last ' + months.length + ' months performance';
  }

  // Total summary line
  const totalRev = revenue.reduce((a,b)=>a+b,0);
  const totalPrf = profit.reduce((a,b)=>a+b,0);
  const totalsEl = document.getElementById('rev-chart-totals');
  if (totalsEl && hasMonthly) {
    totalsEl.innerHTML =
      `<span style="color:var(--green);">Rev: ৳${totalRev.toLocaleString('en-BD')}</span>` +
      `<span style="margin:0 6px;color:var(--border);">|</span>` +
      `<span style="color:var(--gold);">Profit: ৳${totalPrf.toLocaleString('en-BD')}</span>`;
  }

  _rebuildChartJs(liveData);

  // ── 2. Expense Breakdown chart ────────────────────────────
  const donut = document.getElementById('donut-chart');
  if (!donut) return;

  const hasExp = liveData && Array.isArray(liveData.expBreakdown) && liveData.expBreakdown.length > 0;

  const catColors = {
    'Marketing / Ad Spend': 'var(--blue)',
    'Product Sourcing':     'var(--gold)',
    'Delivery Cost':        'var(--purple)',
    'Office & Utility':     'var(--green)',
    'Staff / Labor':        'var(--orange)',
    'COD Charge':           'var(--red)',
    'Machine & Equipment':  'var(--blue)',
    'R&D (Research & Development)': 'var(--purple)',
    'Other':                'var(--text3)',
  };
  const fallbackColors = ['var(--blue)','var(--gold)','var(--purple)','var(--green)','var(--orange)','var(--text3)'];

  const shortName = n => n.replace('Marketing / Ad Spend','Marketing')
                          .replace('Product Sourcing','Sourcing')
                          .replace('Office & Utility','Office')
                          .replace('Staff / Labor','Staff')
                          .replace('Machine & Equipment','Machine')
                          .replace('R&D (Research & Development)','R&D');

  const cats = hasExp
    ? liveData.expBreakdown.map((c, i) => ({
        name:   shortName(c.name),
        pct:    c.pct,
        amount: c.amount,
        c:      catColors[c.name] || fallbackColors[i % fallbackColors.length]
      }))
    : [
        {name:'Marketing', pct:28, amount:0, c:'var(--blue)'},
        {name:'Sourcing',  pct:37, amount:0, c:'var(--gold)'},
        {name:'Delivery',  pct:20, amount:0, c:'var(--purple)'},
        {name:'Office',    pct:15, amount:0, c:'var(--green)'},
      ];

  const fmtAmt = n => {
    if (n >= 100000) return '৳' + (n/100000).toFixed(1) + 'L';
    if (n >= 1000)   return '৳' + (n/1000).toFixed(1) + 'k';
    return n > 0 ? '৳' + n : '—';
  };

  donut.innerHTML = `<div style="display:flex;flex-direction:column;gap:7px;width:100%;padding-top:4px;">
    ${cats.map(c => `
    <div style="display:flex;align-items:center;gap:8px;font-size:11px;">
      <div style="width:9px;height:9px;border-radius:2px;background:${c.c};flex-shrink:0;"></div>
      <span style="flex:1;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${c.name}</span>
      <div style="flex:2;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden;">
        <div style="width:${c.pct}%;height:100%;background:${c.c};border-radius:3px;transition:width .5s ease;"></div>
      </div>
      <span style="color:var(--text);font-weight:700;font-family:'IBM Plex Mono',monospace;min-width:54px;text-align:right;font-size:10px;">
        ${hasExp ? fmtAmt(c.amount) : c.pct + '%'}
      </span>
    </div>`).join('')}
    ${hasExp ? `<div style="text-align:right;font-size:9px;color:var(--text3);margin-top:2px;">${cats.length} categories active</div>` : ''}
  </div>`;
}

function _rebuildChartJs(liveData) {
  const canvas = document.getElementById('rev-chart-canvas');
  if (!canvas || typeof Chart === 'undefined') return;

  const hasMonthly = liveData && liveData.monthlyChart &&
                     Array.isArray(liveData.monthlyChart.labels) &&
                     liveData.monthlyChart.labels.length > 0;

  const months  = hasMonthly ? liveData.monthlyChart.labels  : ['Jan','Feb','Mar','Apr','May','Jun'];
  const revenue = hasMonthly ? liveData.monthlyChart.revenue : [185000,210000,195000,245000,230000,284500];
  const profit  = hasMonthly ? liveData.monthlyChart.profit  : [42000, 55000, 48000, 68000, 61000, 72300];

  // থিম বুঝে রঙ ঠিক করো
  const isDark = !document.body.classList.contains('light');
  const textColor   = isDark ? '#8B949E' : '#656D76';
  const gridColor   = isDark ? 'rgba(48,54,61,0.6)' : 'rgba(208,215,222,0.5)';
  const tooltipBg   = isDark ? '#1C2330' : '#ffffff';
  const tooltipText = isDark ? '#E6EDF3' : '#1F2328';

  // পুরনো chart ধ্বংস করো
  if (window._revChart) { window._revChart.destroy(); window._revChart = null; }

  window._revChart = new Chart(canvas, {
    type: 'bar',
    data: {
      labels: months,
      datasets: [
        {
          label: 'Revenue ৳',
          data: revenue,
          backgroundColor: 'rgba(63,185,80,0.75)',
          borderColor: 'rgba(63,185,80,1)',
          borderWidth: 1.5,
          borderRadius: 5,
          borderSkipped: false,
          hoverBackgroundColor: 'rgba(63,185,80,0.95)',
        },
        {
          label: 'Profit ৳',
          data: profit,
          backgroundColor: profit.map(v => v >= 0 ? 'rgba(212,160,23,0.75)' : 'rgba(248,81,73,0.75)'),
          borderColor:     profit.map(v => v >= 0 ? 'rgba(212,160,23,1)'    : 'rgba(248,81,73,1)'),
          borderWidth: 1.5,
          borderRadius: 5,
          borderSkipped: false,
          hoverBackgroundColor: profit.map(v => v >= 0 ? 'rgba(212,160,23,0.95)' : 'rgba(248,81,73,0.95)'),
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 700, easing: 'easeInOutQuart' },
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          enabled: true,
          backgroundColor: tooltipBg,
          titleColor: tooltipText,
          bodyColor: textColor,
          borderColor: isDark ? '#30363D' : '#D0D7DE',
          borderWidth: 1,
          padding: 12,
          cornerRadius: 10,
          callbacks: {
            label: ctx => {
              const v = ctx.raw;
              const abs = Math.abs(v);
              const sign = v < 0 ? '-' : '';
              let fmt;
              if(abs >= 100000) fmt = sign + '৳' + (abs/100000).toFixed(2) + ' লাখ';
              else if(abs >= 1000) fmt = sign + '৳' + (abs/1000).toFixed(1) + 'k';
              else fmt = sign + '৳' + abs.toLocaleString();
              return ' ' + ctx.dataset.label.replace(' ৳','') + ': ' + fmt;
            }
          }
        }
      },
      scales: {
        x: {
          grid: { color: gridColor, drawBorder: false },
          ticks: { color: textColor, font: { family: "'IBM Plex Sans', sans-serif", size: 11 } },
          border: { color: gridColor }
        },
        y: {
          grid: { color: gridColor, drawBorder: false },
          ticks: {
            color: textColor,
            font: { family: "'IBM Plex Mono', monospace", size: 10 },
            callback: v => {
              const abs = Math.abs(v);
              if(abs >= 100000) return '৳' + (abs/100000).toFixed(0) + 'L';
              if(abs >= 1000)   return '৳' + (abs/1000).toFixed(0) + 'k';
              return '৳' + v;
            }
          },
          border: { color: gridColor }
        }
      }
    }
  });
}

// ─── LIVE DATA FROM GOOGLE SHEETS ────────────────────────────
// ─── DEBOUNCE & LOAD THROTTLE ────────────────────────────────────────
// FIX v24: একই সময়ে একই API call বারবার না যাওয়ার জন্য debounce
// কোনো নতুন order/update দেওয়ার পর সব refresh একসাথে হয়ে speed কমায়
const _loadTimers = {};

// ═══════════════════════════════════════════════════════════
// OPT-E: Global debounce utility — prevents filter from firing
// on every keystroke. 300ms delay = smooth typing experience.
// ═══════════════════════════════════════════════════════════
function debounce(fn, delay) {
  let t;
  return function(...args) {
    clearTimeout(t);
    t = setTimeout(() => fn.apply(this, args), delay || 300);
  };
}

// মূল ইমপ্লিমেন্টেশন — নাম আলাদা রাখা হয়েছে (_debouncedLoadImpl) যাতে নিচের
// pause-aware wrapper-এর সাথে ফাংশন-হোইস্টিং কনফ্লিক্ট না হয়।
// ⚠️ আগে এখানে দুইবার একই নামে (debouncedLoad) function declare করা ছিল —
// JS হোইস্টিং-এর কারণে "const _origDebouncedLoad = debouncedLoad" আসলে
// wrapper-কেই নিজের রেফারেন্স ধরে ফেলতো (দ্বিতীয় declaration প্রথমটাকে
// ওভাররাইট করে ফেলে, তাই তখনকার "debouncedLoad" ইতিমধ্যেই wrapper হয়ে যায়) —
// ফলে প্রতিটা কল ইনফিনিট রিকার্সনে গিয়ে সাইলেন্টলি ক্র্যাশ করতো, আর
// Sales/Dashboard/Inventory কখনো auto-refresh হতো না (ম্যানুয়াল রিফ্রেশ ছাড়া)।
function _debouncedLoadImpl(fn, key, delay) {
  if(_loadTimers[key]) clearTimeout(_loadTimers[key]);
  _loadTimers[key] = setTimeout(fn, delay || 800);
}

// Refresh after add/update: sales+CRM একসাথে, dashboard ও inventory একটু পরে

// ═══════════════════════════════════════════════════════════
// OPT-G: Page Visibility API — pause/resume auto-refresh.
// When user switches tabs or locks screen, heavy data reloads
// are suppressed. They only resume when tab becomes visible again.
// This eliminates the "unlock freeze" bug.
// ═══════════════════════════════════════════════════════════
let _appPaused = false;
document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    _appPaused = true;
  } else {
    // Small delay before resuming — lets browser settle compositing layers
    setTimeout(() => {
      _appPaused = false;
    }, 200);
  }
});

// Public entrypoint — pause-aware, calls the real implementation directly (no self-reference risk)
function debouncedLoad(fn, key, delay) {
  if (_appPaused) return; // OPT-G: skip refresh when tab is hidden
  _debouncedLoadImpl(fn, key, delay);
}

