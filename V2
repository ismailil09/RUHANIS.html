async function impSubmit() {
  let rows = impRawRows.filter(r=>r.some(c=>String(c).trim()));
  if(!rows.length){ showToast('কোনো data নেই','error'); return; }

  // Required check
  if(impColMap['customer']===undefined || impColMap['product']===undefined){
    showToast('Customer ও Product column map করুন','error'); return;
  }

  { const d = await igxSafe.dedupe('sales', rows, impColMap); rows = d.rows;
    if(!rows.length){ showToast('সব order আগে থেকেই আছে — নতুন কিছু import হয়নি','info'); return; } }
  document.getElementById('imp-submit-btn').disabled = true;
  document.getElementById('imp-preview-wrap').style.display='none';
  document.getElementById('imp-progress-wrap').style.display='block';

  let success=0, failed=0;

  // FIX v24: Current BD time — fallback হিসেবে ব্যবহার হবে যদি CSV-এ date না থাকে
  function getBDTimeNow() {
    const d = new Date();
    const opts = {timeZone:'Asia/Dhaka'};
    const day = new Intl.DateTimeFormat('en-GB',{...opts,day:'2-digit'}).format(d);
    const mon = new Intl.DateTimeFormat('en-GB',{...opts,month:'short'}).format(d);
    const yr  = new Intl.DateTimeFormat('en-GB',{...opts,year:'numeric'}).format(d);
    const hr  = new Intl.DateTimeFormat('en-GB',{...opts,hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(d);
    return day+'-'+mon+'-'+yr+' '+hr;
  }

  // FIX v24: CSV-এর date parse করো — dd-Mon-yyyy বা dd/mm/yyyy বা yyyy-mm-dd সব support
  function parseDateFromCSV(raw) {
    if(!raw || !raw.trim()) return '';
    const s = raw.trim();
    // Already in dd-Mon-yyyy format (e.g. 31-May-2026)
    if(/^\d{1,2}-[A-Za-z]{3}-\d{4}$/.test(s)) return s;
    // dd/mm/yyyy
    const m1 = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if(m1) {
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return String(m1[1]).padStart(2,'0')+'-'+months[parseInt(m1[2])-1]+'-'+m1[3];
    }
    // yyyy-mm-dd
    const m2 = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if(m2) {
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return String(m2[3]).padStart(2,'0')+'-'+months[parseInt(m2[2])-1]+'-'+m2[1];
    }
    // dd-mm-yyyy
    const m3 = s.match(/^(\d{1,2})-(\d{1,2})-(\d{4})$/);
    if(m3) {
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return String(m3[1]).padStart(2,'0')+'-'+months[parseInt(m3[2])-1]+'-'+m3[3];
    }
    return s; // যেভাবে আছে সেভাবে পাঠাও
  }

  for(let i=0;i<rows.length;i++){
    const r = rows[i];
    const get = (field) => {
      const idx = impColMap[field];
      return idx!==undefined ? String(r[idx]||'').trim() : '';
    };

    // FIX v24: CSV-এর original date/time preserve করো
    const csvDate = parseDateFromCSV(get('date'));
    const csvTime = get('time') || '00:00:00';
    // timestamp = CSV date থাকলে সেটা, না থাকলে এখনকার BD time
    const timestamp = csvDate ? (csvDate + ' ' + csvTime) : getBDTimeNow();

    const qty      = impCleanNum(get('qty'))    || 1;
    const price    = impCleanNum(get('price'))   || 0;
    const paid     = impCleanNum(get('paid'))    || 0;
    const delivery = impCleanNum(get('delivery'))|| 0;

    const payload = {
      action:    'addOrder',
      timestamp: timestamp,
      customer:  get('customer') || 'Unknown',
      phone:     igxSafe.phone(get('phone')),
      division:  get('division'),
      district:  get('district'),
      thana:     get('thana'),
      address:   get('address'),
      product:   get('product'),
      qty:       qty,
      price:     price,
      paid:      paid,
      delivery:  delivery,
      status:    get('status')    || 'Pending',
      payment:   get('payment')   || 'COD',
      courier:   get('courier')   || '',
      tracking:  get('tracking')  || '',       // FIX v24: tracking যোগ করা হয়েছে
      delStatus: get('delstatus') || 'Not Sent', // FIX v24: delivery status যোগ করা হয়েছে
      notes:     get('notes')     || '',
    };

    try {
      const ok = await postToAPI(payload);
      if(ok) success++; else failed++;
    } catch(e){ failed++; }

    // Progress update
    const pct = Math.round(((i+1)/rows.length)*100);
    document.getElementById('imp-progress-bar').style.width = pct+'%';
    document.getElementById('imp-progress-text').textContent = `Importing... ${i+1}/${rows.length} (${pct}%)`;

    // Rate limit — একটু delay দাও
    await new Promise(r=>setTimeout(r,300));
  }

  // Done
  document.getElementById('imp-progress-wrap').style.display='none';
  const res = document.getElementById('imp-result');
  res.style.display='block';
  if(failed===0){
    res.style.background='rgba(34,201,122,0.1)';
    res.style.border='1px solid rgba(34,201,122,0.3)';
    res.style.color='var(--green)';
    res.textContent = `✅ ${success}টি order সফলভাবে import হয়েছে!`;
    // v35 FIX: সব module refresh করো — import এর পরে সব page এ data দেখা যাবে
    setTimeout(()=>{
      closeModal('import-csv');
      impReset();
      loadLiveSales().then(()=>{ loadLiveCRM(); });
      loadLiveDashboard();
      loadLiveInventory();
      loadLiveExpenses();
      loadLivePartners();
      showToast(`✅ ${success}টি order import সম্পন্ন!`,'success');
    }, 2000);
  } else {
    res.style.background='rgba(248,81,73,0.1)';
    res.style.border='1px solid rgba(248,81,73,0.3)';
    res.style.color='var(--red)';
    res.innerHTML = `
      <div style="margin-bottom:10px;">✅ ${success}টি সফল &nbsp;|&nbsp; ❌ ${failed}টি failed</div>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
        <button class="btn" style="font-size:12px;padding:5px 14px;" onclick="impReset()">
          🔄 নতুন CSV দিন
        </button>
        <button class="btn primary" style="font-size:12px;padding:5px 14px;" onclick="
          document.getElementById('imp-result').style.display='none';
          document.getElementById('imp-submit-btn').disabled=false;
          document.getElementById('imp-preview-wrap').style.display='block';
        ">
          ↩ আগের Preview এ ফিরুন
        </button>
      </div>
    `;
    document.getElementById('imp-submit-btn').disabled=false;
  }
}
