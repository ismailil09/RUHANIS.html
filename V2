/* Wide modal for this feature */
#modal-top-region .modal { max-width: 860px; }

/* Division ranking list */
.region-rank-list {
  display: flex; flex-direction: column; gap: 8px;
  margin-bottom: 20px;
}
.region-rank-item {
  display: flex; align-items: center; gap: 12px;
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: 10px; padding: 10px 14px;
  transition: border-color .15s, background .15s;
  cursor: pointer;
}
.region-rank-item:hover {
  border-color: var(--blue);
  background: var(--bg4);
}
.region-rank-item.rri-selected {
  border-color: var(--blue);
  background: rgba(56,139,253,.08);
}
.rri-rank {
  width: 28px; height: 28px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 800; flex-shrink: 0;
  font-family: 'IBM Plex Mono', monospace;
}
.rri-rank.r1 { background: rgba(212,160,23,.2); color: var(--gold); }
.rri-rank.r2 { background: rgba(139,148,158,.15); color: var(--text2); }
.rri-rank.r3 { background: rgba(188,140,255,.15); color: var(--purple); }
.rri-rank.rn { background: var(--bg4); color: var(--text3); }
.rri-name { flex: 1; font-size: 13px; font-weight: 600; color: var(--text); }
.rri-bar-wrap { flex: 2; height: 6px; background: var(--bg4); border-radius: 3px; overflow: hidden; }
.rri-bar-fill { height: 100%; border-radius: 3px; transition: width .5s ease; }
.rri-count { font-size: 12px; font-weight: 700; font-family: 'IBM Plex Mono', monospace; color: var(--blue); min-width: 56px; text-align: right; }
.rri-drill-hint { font-size: 10px; color: var(--text3); margin-left: 4px; }

/* Drill-down chart area */
.rgn-chart-section {
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: 12px; padding: 18px;
}
.rgn-chart-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 14px; flex-wrap: wrap; gap: 8px;
}
.rgn-chart-title { font-size: 13px; font-weight: 700; color: var(--text); }
.rgn-chart-sub   { font-size: 11px; color: var(--text3); margin-top: 2px; }
.rgn-back-btn {
  display: none; /* shown via JS */
  align-items: center; gap: 6px;
  background: rgba(56,139,253,.12); border: 1px solid rgba(56,139,253,.3);
  color: var(--blue); border-radius: 8px;
  padding: 5px 12px; font-size: 12px; font-weight: 600;
  cursor: pointer; transition: background .15s;
}
.rgn-back-btn:hover { background: rgba(56,139,253,.2); }
.rgn-bars-wrap {
  display: flex; align-items: flex-end; gap: 6px;
  height: 200px; overflow-x: auto;
  padding-bottom: 24px; /* room for labels */
}
.rgn-bar-col {
  flex: 1; min-width: 32px; max-width: 72px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: flex-end;
  height: 100%; cursor: pointer; position: relative;
}
.rgn-bar-col:hover .rgn-bar-inner { opacity: .8; }
.rgn-bar-inner {
  width: 100%; border-radius: 5px 5px 0 0;
  min-height: 4px; transition: height .45s ease;
  position: relative;
}
.rgn-bar-val {
  position: absolute; top: -18px; left: 0; right: 0;
  text-align: center; font-size: 9px; color: var(--text2);
  font-family: 'IBM Plex Mono', monospace; white-space: nowrap;
}
.rgn-bar-lbl {
  position: absolute; bottom: -22px; left: 0; right: 0;
  text-align: center; font-size: 9px; color: var(--text3);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.rgn-chart-empty {
  width: 100%; text-align: center;
  color: var(--text3); font-size: 13px;
  padding: 40px 0;
}
/* Breadcrumb trail inside modal */
.rgn-breadcrumb {
  font-size: 11px; color: var(--text3); margin-bottom: 16px;
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
}
.rgn-breadcrumb span { color: var(--blue); cursor: pointer; font-weight: 600; }
.rgn-breadcrumb span:hover { text-decoration: underline; }

/* ═══════════════════════════════════════
   COURIER MANAGER HUB — STYLES
═══════════════════════════════════════ */
.courier-card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px 20px;
  position: relative;
  overflow: hidden;
  transition: border-color .2s, box-shadow .2s;
}
.courier-card:hover {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(212,160,23,.1);
}
.courier-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  border-radius: 14px 14px 0 0;
}
.courier-card.pathao::before   { background: linear-gradient(90deg,#f02d65,#ff6b98); }
.courier-card.steadfast::before{ background: linear-gradient(90deg,#0a84ff,#4daaff); }
.courier-card.redx::before     { background: linear-gradient(90deg,#e83a2b,#ff7060); }
.courier-card.sa::before       { background: linear-gradient(90deg,#22c55e,#4ade80); }
.courier-card.sundarban::before{ background: linear-gradient(90deg,#f59e0b,#fcd34d); }
.courier-card.janani::before   { background: linear-gradient(90deg,#8b5cf6,#c084fc); }

.courier-card-head {
  display: flex; align-items: center; gap: 12px; margin-bottom: 14px;
}
.courier-logo-badge {
  width: 40px; height: 40px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
}
.courier-card.pathao   .courier-logo-badge { background: rgba(240,45,101,.15); }
.courier-card.steadfast .courier-logo-badge{ background: rgba(10,132,255,.15); }
.courier-card.redx     .courier-logo-badge { background: rgba(232,58,43,.15); }
.courier-card.sa       .courier-logo-badge { background: rgba(34,197,94,.15); }
.courier-card.sundarban .courier-logo-badge{ background: rgba(245,158,11,.15); }
.courier-card.janani   .courier-logo-badge { background: rgba(139,92,246,.15); }

.courier-card-name {
  font-size: 15px; font-weight: 800; color: var(--text);
  letter-spacing: .3px;
}
.courier-card-sub { font-size: 11px; color: var(--text3); margin-top: 2px; }

.courier-stats-row {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 10px; margin-bottom: 12px;
}
.c-stat {
  background: var(--bg3); border-radius: 8px; padding: 8px 10px;
}
.c-stat-label { font-size: 10px; color: var(--text3); font-weight: 600; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 3px; }
.c-stat-val   { font-size: 16px; font-weight: 800; font-family: 'IBM Plex Mono',monospace; color: var(--text); }
.c-stat-val.green { color: var(--green); }
.c-stat-val.red   { color: var(--red); }
.c-stat-val.gold  { color: var(--gold); }
.c-stat-val.blue  { color: var(--blue); }

.courier-progress {
  height: 5px; background: var(--bg4); border-radius: 3px; overflow: hidden; margin-top: 10px;
}
.courier-progress-fill {
  height: 100%; border-radius: 3px; transition: width .6s ease;
}
.courier-card.pathao    .courier-progress-fill { background: #f02d65; }
.courier-card.steadfast .courier-progress-fill { background: #0a84ff; }
.courier-card.redx      .courier-progress-fill { background: #e83a2b; }
.courier-card.sa        .courier-progress-fill { background: #22c55e; }
.courier-card.sundarban .courier-progress-fill { background: #f59e0b; }
.courier-card.janani    .courier-progress-fill { background: #8b5cf6; }

/* Tracking table special cells */
.delivery-cost-cell  { color: var(--red) !important; font-weight: 700; font-family:'IBM Plex Mono',monospace; }
.cod-cost-cell       { color: var(--red) !important; font-weight: 700; font-family:'IBM Plex Mono',monospace; }
.net-payable-cell    { color: var(--green) !important; font-weight: 800; font-family:'IBM Plex Mono',monospace; }

.courier-badge-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 9px; border-radius: 20px;
  font-size: 11px; font-weight: 700;
}
.cb-pathao    { background:rgba(240,45,101,.15);  color:#f02d65; }
.cb-steadfast { background:rgba(10,132,255,.15);  color:#0a84ff; }
.cb-redx      { background:rgba(232,58,43,.15);   color:#e83a2b; }
.cb-sa        { background:rgba(34,197,94,.15);   color:#22c55e; }
.cb-sundarban { background:rgba(245,158,11,.15);  color:#f59e0b; }
.cb-janani    { background:rgba(139,92,246,.15);  color:#8b5cf6; }

/* Sync animation */
@keyframes spin { to { transform: rotate(360deg); } }
.syncing { display: inline-block; animation: spin .7s linear infinite; }

/* ═══════════════════════════════════════════════════════════════
   FINANCIAL ANALYTICS — Premium Glassmorphic Modal System
   Revenue & Profit cards get enhanced hover + dedicated modal
   ═══════════════════════════════════════════════════════════════ */

/* Override hover for the two clickable financial cards */
.kpi-card.fin-card {
  cursor: pointer;
  transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease !important;
}
.kpi-card.fin-card:hover {
  transform: scale(1.02) translateY(-1px) !important;
}
.kpi-card.green.fin-card:hover {
  border-color: var(--green) !important;
  box-shadow: 0 0 0 1px rgba(63,185,80,.25), 0 0 28px rgba(63,185,80,.15), 0 8px 24px rgba(0,0,0,.4) !important;
}
.kpi-card.gold.fin-card:hover {
  border-color: var(--gold) !important;
  box-shadow: 0 0 0 1px rgba(212,160,23,.25), 0 0 28px rgba(212,160,23,.15), 0 8px 24px rgba(0,0,0,.4) !important;
}

/* Glassmorphic overlay */
#modal-fin-analytics {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.60);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 1300;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
#modal-fin-analytics.open { display: flex; }

/* Modal box */
.fa-box {
  background: rgba(22,27,34,.95);
  border: 1px solid rgba(48,54,61,.9);
  border-radius: 20px;
  width: 100%;
  max-width: 660px;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 32px 80px rgba(0,0,0,.65), 0 0 0 1px rgba(255,255,255,.04);
  animation: faSlideUp .28s cubic-bezier(.22,.68,0,1.2);
}
@keyframes faSlideUp {
  from { transform: translateY(30px) scale(.96); opacity: 0; }
  to   { transform: translateY(0)    scale(1);   opacity: 1; }
}

/* Header */
.fa-header {
  padding: 20px 22px 14px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.fa-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 8px;
}
.fa-close {
  width: 30px; height: 30px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--bg3);
  cursor: pointer;
  font-size: 15px;
  display: flex; align-items: center; justify-content: center;
  color: var(--text2);
  transition: all .15s;
}
.fa-close:hover { background: var(--red2); border-color: var(--red); color: var(--red); }

/* Segmented tab bar */
.fa-tabs {
  display: flex;
  gap: 0;
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 3px;
  margin: 14px 22px 0;
  flex-shrink: 0;
}
.fa-tab {
  flex: 1;
  padding: 8px 0;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .8px;
  text-transform: uppercase;
  color: var(--text3);
  background: transparent;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all .18s;
  font-family: 'IBM Plex Sans', sans-serif;
}
.fa-tab:hover { color: var(--text2); }
.fa-tab.active {
  background: var(--bg2);
  color: var(--text);
  box-shadow: 0 1px 8px rgba(0,0,0,.35);
}
.fa-tab.active[data-accent="green"] { color: var(--green); }
.fa-tab.active[data-accent="gold"]  { color: var(--gold);  }

/* Scrollable body */
.fa-body {
  padding: 18px 22px 22px;
  overflow-y: auto;
  flex: 1;
}

/* Metric comparison row */
.fa-metric-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 14px;
}
.fa-metric-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 18px 16px 14px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.fa-metric-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
}
.fa-metric-card.curr::before  { background: linear-gradient(90deg,transparent,var(--green),transparent); }
.fa-metric-card.curr.is-gold::before { background: linear-gradient(90deg,transparent,var(--gold),transparent); }
.fa-metric-card.prev::before  { background: linear-gradient(90deg,transparent,var(--border),transparent); }
.fa-metric-lbl {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--text3);
  margin-bottom: 8px;
}
.fa-metric-val {
  font-size: 21px;
  font-weight: 700;
  font-family: 'IBM Plex Mono', monospace;
  color: var(--text);
  line-height: 1.15;
  word-break: break-all;
}
.fa-metric-card.curr .fa-metric-val        { color: var(--green); }
.fa-metric-card.curr.is-gold .fa-metric-val { color: var(--gold); }
.fa-metric-card.prev .fa-metric-val        { color: var(--text2); }
.fa-metric-period {
  font-size: 11px;
  color: var(--text3);
  margin-top: 5px;
}

/* Change badge */
.fa-badge-row {
  display: flex;
  justify-content: center;
  margin-bottom: 16px;
}
.fa-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 20px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 700;
}
.fa-badge.growth {
  background: rgba(63,185,80,.10);
  border: 1px solid rgba(63,185,80,.30);
  color: var(--green);
  box-shadow: 0 0 18px rgba(63,185,80,.12);
}
.fa-badge.decline {
  background: rgba(248,81,73,.10);
  border: 1px solid rgba(248,81,73,.30);
  color: var(--red);
  box-shadow: 0 0 18px rgba(248,81,73,.12);
}
.fa-badge.neutral {
  background: var(--bg3);
  border: 1px solid var(--border);
  color: var(--text3);
}

/* Breakdown bars */
.fa-sep { border: none; border-top: 1px solid var(--border); margin: 14px 0; }
.fa-sec-title {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--text3);
  margin-bottom: 12px;
}
.fa-bar-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 9px;
}
.fa-bar-label { font-size: 12px; color: var(--text2); min-width: 90px; max-width: 90px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 0; }
.fa-bar-track { flex: 1; height: 5px; background: var(--bg4); border-radius: 99px; overflow: hidden; }
.fa-bar-fill  { height: 100%; border-radius: 99px; transition: width .55s ease; }
.fa-bar-val   { font-size: 11px; color: var(--text); font-family: 'IBM Plex Mono', monospace; min-width: 72px; text-align: right; }

/* Orders mini-table inside modal */
.fa-mini-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.fa-mini-table th { background: var(--bg4); color: var(--text3); font-size: 10px; letter-spacing: .5px; text-transform: uppercase; padding: 7px 10px; text-align: left; border-bottom: 1px solid var(--border); }
.fa-mini-table td { padding: 7px 10px; border-bottom: 1px solid var(--border2); color: var(--text2); }
.fa-mini-table tr:last-child td { border-bottom: none; }
.fa-mini-table tr:hover td { background: var(--bg3); }
.fa-empty { text-align: center; padding: 28px; color: var(--text3); font-size: 13px; }

/* ═══════════════════════════════════════════════════════════════
   DASHBOARD KPI FILTER BAR — Year / Month / All-Time Dropdowns
   ═══════════════════════════════════════════════════════════════ */
.dash-filter-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 10px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}
.dash-filter-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--text3);
  letter-spacing: .8px;
  text-transform: uppercase;
  flex-shrink: 0;
  margin-right: 4px;
}
.dash-filter-sel {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 5px 28px 5px 10px;
  color: var(--text);
  font-size: 12px;
  font-family: 'IBM Plex Sans', sans-serif;
  cursor: pointer;
  outline: none;
