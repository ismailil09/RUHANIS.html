async function saveCourierSettings() {
  const courier  = document.getElementById('cs-courier').value;
  const fields   = COURIER_SETTINGS_FIELDS[courier];
  const pin      = document.getElementById('cs-pin').value.trim();
  const errEl    = document.getElementById('cs-error');
  const partner  = currentPartner;

  if (!partner) { errEl.textContent = '⚠️ আগে লগইন করো'; return; }
  if (!/^\d{4}$/.test(pin)) { errEl.textContent = '❌ 4-digit PIN দাও'; return; }

  const credentials = {};
  let anyFilled = false;
  fields.forEach(f => {
    const v = document.getElementById('cs-f-' + f.key).value.trim();
    if (v) anyFilled = true;
    credentials[f.key] = v;
  });
  if (!anyFilled) { errEl.textContent = '⚠️ অন্তত একটা ফিল্ড পূরণ করো'; return; }

  errEl.textContent = '⏳ সেভ করা হচ্ছে...';
  const result = await postToAPI({ action: 'saveCourierCredentials', partner, pin, courier, credentials });
  errEl.textContent = '';

  if (!result) { errEl.textContent = '❌ সেভ ব্যর্থ হয়েছে — PIN বা ইনপুট চেক করো'; return; }

