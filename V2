    </div>`;
    return `<tr>
      <td class="mono">${p.id}</td>
      <td><strong>${p.name}</strong>${splitBadge}</td><td>${p.cat}</td>
      <td class="mono">৳${Number(p.cost).toLocaleString()}</td>
      <td class="mono">৳${Number(p.sell).toLocaleString()}</td>
      <td><span style="color:${margin>30?'var(--green)':margin>15?'var(--orange)':'var(--red)'};">${margin.toFixed(1)}%</span></td>
      <td class="mono">${p.opening}</td><td class="mono">${p.in}</td><td class="mono">${p.sold}</td>
      <td class="mono" style="font-weight:700;color:${p.current<=p.alert?'var(--red)':'var(--text)'};">${p.current}${p.current<=5?` <span style="display:inline-block;background:var(--red2);border:1px solid rgba(248,81,73,.4);color:var(--red);font-size:9px;font-weight:700;padding:1px 5px;border-radius:4px;margin-left:4px;animation:flashAlert 1.2s ease-in-out infinite alternate;">⚠️ Low</span>`:''}</td>
      <td class="mono">${p.alert}</td>
