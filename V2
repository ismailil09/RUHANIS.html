.pin-key:hover { background:var(--bg4); border-color:var(--gold); color:var(--gold); }
.pin-key:active { transform:scale(.95); }
.pin-key.del { font-size:16px; }
.pin-key.enter { background:var(--gold); border-color:var(--gold); color:#000; font-size:14px; }
.pin-key.enter:hover { background:#c4920f; }
.pin-error { color:var(--red); font-size:12px; margin-top:8px; min-height:18px; }
.pin-change-link { color:var(--gold); font-size:11px; cursor:pointer; text-decoration:underline; margin-top:12px; display:inline-block; }

/* Partner Login Chips */
.partner-login-chip {
  display:flex;align-items:center;gap:10px;
  padding:10px 14px;border-radius:10px;
  border:1px solid var(--border);
  background:var(--bg3);
  cursor:pointer;transition:all .2s;
}
.partner-login-chip:hover { background:var(--bg4); }
.partner-login-chip.selected { background:var(--gold3); border-width:2px !important; }

/* Logged-in partner badge in topbar */
#current-partner-badge {
  display:flex;align-items:center;gap:7px;
  padding:5px 12px;border-radius:8px;
  font-size:12px;font-weight:600;
  border:1px solid var(--border);
  background:var(--bg3);
  cursor:default;
}

/* Activity Log table */
#page-activity-log .log-table-wrap {
  background:var(--bg2);border:1px solid var(--border);
  border-radius:12px;overflow:hidden;
}

/* Change PIN Modal */
#modal-change-pin .form-group { margin-bottom:14px; }
.lock-icon-btn {
  position:fixed; bottom:24px; left:24px;
  width:40px; height:40px; border-radius:10px;
  border:1px solid var(--border); background:var(--bg3);
  display:flex; align-items:center; justify-content:center;
  cursor:pointer; font-size:18px; z-index:150;
  transition:all .15s; color:var(--text2);
}
.lock-icon-btn:hover { border-color:var(--gold); color:var(--gold); }
#lock-btn { display:none; }

