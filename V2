 */
function downloadInvoicePNG(){
  const area = document.getElementById('invoice-print-area');
  if (!area) { showToast('ইনভয়েস পাওয়া যায়নি','error'); return; }
  // ✅ FIX: এডিট মোড চালু থাকলেও PNG-তে ড্যাশড আউটলাইন যেন না দেখায়
  if (typeof _setInvoiceEditMode === 'function') _setInvoiceEditMode(false);
  showToast('PNG তৈরি হচ্ছে...', 'info');
  const doCapture = () => {
    // ✅ FIX (PNG ঝাপসা টেক্সট বাগ, Sept 2026): ইনভয়েসটা একটা মোডালের ভেতরে
    // থাকে, যেটা ওপেন হওয়ার সময় CSS অ্যানিমেশন চালায় আর স্ক্রলও হতে পারে
    // (ছোট মোবাইল স্ক্রিনে)। PDF এসব সমস্যায় পড়ে না কারণ সেটা outerHTML কপি
    // করে সম্পূর্ণ নতুন, animation/scroll-মুক্ত উইন্ডোতে বসায়। PNG-ও এখন
    // একই কৌশল নিচ্ছে — লাইভ মোডালের বদলে একটা আলাদা, অফ-স্ক্রিন, স্থির
    // (animation/scroll-মুক্ত) ক্লোন থেকে ক্যাপচার করা হয়, সাথে
    // document.fonts.ready-এর জন্য অপেক্ষা করা হয় (Google Fonts পুরোপুরি
    // লোড হওয়ার আগে ছবি না তোলার জন্য) এবং foreignObjectRendering বন্ধ
    // রাখা হলো (বেশি স্টেবল রেন্ডারিং পাথ)।
    const clone = area.cloneNode(true);
    const wrapper = document.createElement('div');
    wrapper.style.position = 'fixed';
    wrapper.style.left = '-99999px';
    wrapper.style.top = '0';
    wrapper.style.opacity = '1';
    wrapper.style.transform = 'none';
    wrapper.style.animation = 'none';
    wrapper.style.pointerEvents = 'none';
    wrapper.appendChild(clone);
    document.body.appendChild(wrapper);

    const capture = () => html2canvas(clone, {
      backgroundColor: '#ffffff',
      scale: 3,
      useCORS: true,
      logging: false,
      windowWidth: clone.scrollWidth,
      foreignObjectRendering: false,
      imageTimeout: 15000,
    }).then(canvas => {
      const invId = (document.getElementById('inv-id')?.textContent || '').trim() || Date.now();
      const link = document.createElement('a');
      link.download = `RUHANIS_Invoice_${invId}.png`;
