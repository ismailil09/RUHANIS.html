/* ═══════════ শেয়ার্ড CSV হেল্পার (Cash Flow + Strategy & Tasks ব্যবহার করে) ═══════════ */
(function () {
  'use strict';
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const csvCell = v => { let t = String(v == null ? '' : v); if (/^[=+\-@\t\r]/.test(t)) t = "'" + t; return '"' + t.replace(/"/g, '""') + '"'; }; // Excel formula-injection রোধ
  function downloadCSV(rows, name) {
    const csv = '\uFEFF' + rows.map(r => r.map(csvCell).join(',')).join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    a.download = name; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(a.href), 1500);
  }
  // RFC-4180 CSV parser — "" escape, quoted newline, delimiter auto-detect (, ; tab)
  function parseCSV(text) {
    text = String(text || '').replace(/^\uFEFF/, '');
    const first = text.split(/\r?\n/)[0] || '';
    let q0 = false; const cnt = { ',': 0, ';': 0, '\t': 0 };
    for (const ch of first) { if (ch === '"') q0 = !q0; else if (!q0 && ch in cnt) cnt[ch]++; }
    const delim = cnt[';'] > cnt[','] && cnt[';'] >= cnt['\t'] ? ';' : (cnt['\t'] > cnt[','] ? '\t' : ',');
    const rows = []; let row = [], cur = '', inQ = false;
    for (let i = 0; i < text.length; i++) {
      const ch = text[i];
      if (inQ) { if (ch === '"') { if (text[i + 1] === '"') { cur += '"'; i++; } else inQ = false; } else cur += ch; }
      else if (ch === '"') inQ = true;
      else if (ch === delim) { row.push(cur); cur = ''; }
      else if (ch === '\n' || ch === '\r') { if (ch === '\r' && text[i + 1] === '\n') i++; row.push(cur); cur = ''; rows.push(row); row = []; }
      else cur += ch;
    }
    if (cur !== '' || row.length) { row.push(cur); rows.push(row); }
    return rows.filter(r => r.some(c => String(c).trim() !== ''));
  }
  const bn2en = s => String(s).replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d));
  function parseDateAny(v) {
    const s = bn2en(String(v || '').trim()); let y, m, d, x;
    if ((x = /^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/.exec(s))) { y = +x[1]; m = +x[2]; d = +x[3]; }
    else if ((x = /^(\d{1,2})[-\/. ](\d{1,2})[-\/. ](\d{4})/.exec(s))) { d = +x[1]; m = +x[2]; y = +x[3]; }
    else if ((x = /^(\d{1,2})[-\s]([A-Za-z]{3})[A-Za-z]*[-\s,]*(\d{4})/.exec(s))) { d = +x[1]; m = MONTHS.findIndex(n => n.toLowerCase() === x[2].toLowerCase()) + 1; y = +x[3]; }
    else return '';
    const dt = new Date(y, m - 1, d);
    if (!m || dt.getFullYear() !== y || dt.getMonth() !== m - 1 || dt.getDate() !== d) return '';
    return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  }
  const parseAmt = v => { const s = bn2en(String(v == null ? '' : v)).replace(/[৳,\s]/g, '').replace(/[()]/g, ''); if (!/^[+-]?\d*\.?\d+$/.test(s)) return NaN; return Math.round(parseFloat(s) * 100) / 100; };

  // নেটওয়ার্ক কল ≥১ms ফাঁকে: file:// JSONP callback নাম Date.now()-ভিত্তিক, একই ms-এ দুই কল গেলে একটা হারায়
  let _lastNet = 0;
  async function spaced(fn) { let n = Date.now(); while (n <= _lastNet) { await new Promise(r => setTimeout(r, 2)); n = Date.now(); } _lastNet = n; return fn(); }
  window.__igxCsv = { csvCell, downloadCSV, parseCSV, bn2en, parseDateAny, parseAmt, spaced, MONTHS };
})();

