// OPT-J: Event Delegation for table buttons
// Instead of attaching onclick to every row (causes memory bloat
// with 500+ rows), use a single delegated listener per table body.
// All Edit/Delete/Invoice buttons bubble up to one handler.
// ═══════════════════════════════════════════════════════════
(function _initTableDelegation() {
  function delegateTableClicks(tbodyId, handlers) {
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    tbody.addEventListener('click', function(e) {
      const btn = e.target.closest('button[data-action]');
      if (!btn) return;
      const action = btn.getAttribute('data-action');
      const dataRaw = btn.getAttribute('data-row');
      if (handlers[action] && dataRaw) {
        try { handlers[action](JSON.parse(dataRaw)); } catch(err) { console.error('Delegation err:', err); }
      }
    });
  }

  // Wire after DOM ready (tables rendered by loadLive*)
  // Sales table delegation
  const salesHandlers = {
    'invoice':      (r) => openInvoice(r),
    'edit-order':   (r) => openEditOrder(r),
    'delete-order': (r) => deleteOrder(r),
  };
  const invHandlers = {
    'edit-product':   (r) => openEditProduct(r),
    'delete-product': (r) => deleteProduct(r),
  };
  const expHandlers = {
    'edit-expense':   (r) => openEditExpense(r),
    'delete-expense': (r) => deleteExpense(r),
  };
  const partnerHandlers = {
    'edit-partner':   (r) => openEditPartnerTxn(r),
    'delete-partner': (r) => deletePartnerTxn(r),
  };

  // Delegate immediately (tbody exists in DOM even if empty)
  requestAnimationFrame(() => {
    delegateTableClicks('sales-body',   salesHandlers);
    delegateTableClicks('inv-body',     invHandlers);
    delegateTableClicks('exp-body',     expHandlers);
    delegateTableClicks('partner-body', partnerHandlers);
  });
})();


