      if (!PT.loaded) $('pt-body').innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--red);padding:40px;">❌ Purchase ডেটা লোড হয়নি — API URL ও Apps Script v57 ডিপ্লয় চেক করুন</td></tr>';
