  status:   ['order status','status','অবস্থা'],
  payment:  ['payment method','payment','পেমেন্ট','method'],
  courier:  ['courier','কুরিয়ার','courier service'],
  tracking: ['tracking no','tracking','ট্র্যাকিং','tracking number','track'],
