/**
 * exportTableToCSV — টেবিল থেকে CSV বানিয়ে Excel-এ খোলার জন্য ডাউনলোড করো
 * @param {string} tableId  — table element-এর id অথবা tbody id
 * @param {string} filename — ফাইলের নাম (extension ছাড়া)
 * @param {boolean} isTbody — true হলে শুধু tbody; false/undefined হলে পুরো table
 */
function exportTableToCSV(tableId, filename, isTbody) {
  try {
    let rows = [];
    if (isTbody) {
      // tbody থেকে ডাটা নিই — thead আলাদা খুঁজব
      const tbody = document.getElementById(tableId);
      if (!tbody) { showToast('টেবিল পাওয়া যায়নি', 'error'); return; }
      const table = tbody.closest('table');
      if (table) {
        const theadCells = table.querySelectorAll('thead th');
        if (theadCells.length) rows.push(Array.from(theadCells).map(th => '"' + (th.textContent||'').replace(/"/g,'""').trim() + '"'));
      }
      tbody.querySelectorAll('tr').forEach(tr => {
        rows.push(Array.from(tr.querySelectorAll('td')).map(td => '"' + (td.innerText||td.textContent||'').replace(/"/g,'""').replace(/\n/g,' ').trim() + '"'));
      });
    } else {
      const table = document.getElementById(tableId);
      if (!table) { showToast('টেবিল পাওয়া যায়নি', 'error'); return; }
      table.querySelectorAll('tr').forEach(tr => {
        const cells = tr.querySelectorAll('th, td');
        rows.push(Array.from(cells).map(c => '"' + (c.innerText||c.textContent||'').replace(/"/g,'""').replace(/\n/g,' ').trim() + '"'));
      });
    }
    // BOM যোগ করো — Excel বাংলা ঠিকমতো দেখাবে
    const bom = '\uFEFF';
    const csv = bom + rows.map(r => r.join(',')).join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    const date = new Date().toISOString().slice(0,10);
    a.href = url;
    a.download = `${filename}_${date}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast('📥 CSV ডাউনলোড হয়েছে — Excel-এ খুলুন', 'success');
  } catch(e) {
    showToast('Export ব্যর্থ: ' + e.message, 'error');
  }
}


