   ═══════════════════════════════════════════════════════════ */

/* OPT-A1: GPU-accelerated page transitions — FIXED
   transform:translateZ(0) on .page creates stacking context issues on mobile.
   Only apply GPU hint on .page.active to avoid blank content bug. */
.page {
  display: none;
}
.page.active {
  display: block !important;
  will-change: auto;
  backface-visibility: hidden;
}

/* OPT-A2: Modal animations via transform (no layout thrash) */
.modal-overlay { will-change: opacity; }
.modal-box{background:var(--bg2);border:1px solid var(--border);border-radius:16px;width:100%;max-height:90vh;overflow-y:auto;}
.modal-box {
  will-change: transform, opacity;
  transform: translateZ(0);
}
.modal-overlay.open .modal-box {
  animation: modalIn 0.18s cubic-bezier(.22,.68,0,1.2) forwards;
}
@keyframes modalIn {
  from { opacity:0; transform: scale(0.96) translateY(-8px); }
  to   { opacity:1; transform: scale(1)    translateY(0);    }
}

/* OPT-A3: Sidebar — GPU composite layer, no layout during open/close */
.sidebar { will-change: transform; }

/* OPT-A4: Table rows — contain removed (caused blank content on mobile)
   Mobile browsers handle table reflow differently */
/* .data-table tbody tr { contain: layout style; } */

/* OPT-A5: Scroll container — will-change removed for mobile compat */
.table-wrap {
  -webkit-overflow-scrolling: touch;
  overflow-x: auto;
}

/* OPT-A6: Status badges — prevent text reflow */
.status, .pay-badge {
  contain: layout;
  white-space: nowrap;
}

/* OPT-A7: Toast notifications — GPU layer */
.toast {
  will-change: transform, opacity;
  transform: translateZ(0);
}

/* OPT-A8: Virtual scroll sentinel */
#vscroll-sentinel {
  height: 1px;
  width: 100%;
  visibility: hidden;
}


