    const share = Math.round(total * pct / 100);
    return `<tr data-investor-id="${id}" data-investor-name="${name}">
      <td><input type="checkbox" class="dist-include" checked onchange="recalcDistributeSum()"></td>
      <td style="font-size:13px;">${name}</td>
      <td style="font-size:12px;color:var(--green);">${pct.toFixed(2)}%</td>
      <td><input type="number" class="form-input dist-amount" style="padding:4px 8px;font-size:13px;" value="${share}" oninput="recalcDistributeSum()"></td>
    </tr>`;
  }).join('');

  recalcDistributeSum();
}

function recalcDistributeSum() {
  const total = parseFloat(el('dist-total-profit')?.value || 0);
  const rows = document.querySelectorAll('#dist-preview-body tr');
  let sum = 0, includedCount = 0;
  rows.forEach(tr => {
    const checked = tr.querySelector('.dist-include')?.checked;
    const amtInput = tr.querySelector('.dist-amount');
    if (checked) { sum += parseFloat(amtInput?.value || 0); includedCount++; amtInput.disabled = false; }
    else { amtInput.disabled = true; }
  });
  const diff = Math.round((sum - total) * 100) / 100;
  const box = el('dist-sum-check');
  if (Math.abs(diff) < 1) {
    box.style.background = 'rgba(52,209,116,.1)'; box.style.color = 'var(--green)';
    box.innerHTML = `✅ মোট বণ্টিত ৳${fmt(sum)} — ইনপুট করা ৳${fmt(total)}-এর সাথে মিলে গেছে (${includedCount} জন investor)।`;
    el('dist-confirm-btn').disabled = includedCount === 0;
  } else {
    box.style.background = 'rgba(245,180,0,.1)'; box.style.color = 'var(--gold)';
    box.innerHTML = `⚠️ মোট বণ্টিত ৳${fmt(sum)} — ইনপুট করা ৳${fmt(total)}-এর থেকে ${diff>0?'বেশি':'কম'} ৳${fmt(Math.abs(diff))}। এখনো কনফার্ম করতে পারবে, কিন্তু চাইলে amount ঠিক করে নাও।`;
    el('dist-confirm-btn').disabled = includedCount === 0;
  }
}

async function submitDistributeProfit() {
  const total = parseFloat(el('dist-total-profit')?.value || 0);
  const date  = el('dist-date')?.value || '';
  const notes = el('dist-notes')?.value || `মাসিক লাভ বণ্টন — ${date}`;
  if (!total || total <= 0) { showToast('মোট লাভের পরিমাণ দিন', 'warning'); return; }

  const entries = [];
  document.querySelectorAll('#dist-preview-body tr').forEach(tr => {
    const checked = tr.querySelector('.dist-include')?.checked;
    if (!checked) return;
    const amt = parseFloat(tr.querySelector('.dist-amount')?.value || 0);
    if (amt <= 0) return;
    entries.push({
      investorId: tr.dataset.investorId,
      investorName: tr.dataset.investorName,
      amount: amt,
      notes: notes
    });
  });

  if (!entries.length) { showToast('অন্তত একজন investor সিলেক্ট থাকতে হবে', 'warning'); return; }

  el('dist-confirm-btn').disabled = true;
  el('dist-confirm-btn').textContent = 'প্রসেসিং...';
  const res = await postToAPI({ action: 'distributeProfit', totalProfit: total, date: date, notes: notes, entries: entries });
  el('dist-confirm-btn').textContent = '✅ বণ্টন নিশ্চিত করুন';
  el('dist-confirm-btn').disabled = false;

  if (res?.status === 'success') {
    showToast('✅ ' + (res.message || 'Profit বণ্টন সম্পন্ন হয়েছে'), 'success');
    closeModal('distribute-profit');
    loadInvestors();
  } else { showToast('❌ ' + (res?.message||'Error'), 'error'); }
}

