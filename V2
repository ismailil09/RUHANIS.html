function updateCompanyFundPreview() {
  const i  = Number(parseFloat(document.getElementById('split-ismail')?.value||0)) || 0;
  const a  = Number(parseFloat(document.getElementById('split-ashik')?.value||0)) || 0;
  const total = i + a;
  const comp  = Math.max(0, 100 - total);
  const el = id => document.getElementById(id);
  if(el('preview-company')) el('preview-company').textContent = comp.toFixed(1) + '%';
  if(el('preview-total'))   {
    el('preview-total').textContent = total.toFixed(1) + '%';
    el('preview-total').style.color = total > 100 ? 'var(--red)' : total === 100 ? 'var(--green)' : 'var(--text)';
  }
  // Net profit preview (COD ও delivery বাদ দিয়ে)
  const totalPriceEl = document.getElementById('total-price');
  const deliveryEl   = document.getElementById('order-delivery');
  const codPctEl2    = document.getElementById('order-cod-pct');
  if(totalPriceEl && el('preview-net')) {
    const totalSale  = parseFloat(totalPriceEl.value||0);
    const delivery   = parseFloat(deliveryEl?.value||0);
    const codPct2    = parseFloat(codPctEl2?.value||0);
    // ✅ BUG #2 FIX: COD % applies to customerPayable (totalSale + delivery)
    const customerPayable2 = totalSale + delivery;
    const codAmt2    = (customerPayable2 * codPct2) / 100;
    // netProfit = totalSale - codAmt2 (delivery is pass-through, cancels out)
    const netProfit  = totalSale - codAmt2;
    const codNote    = codAmt2 > 0 ? ` (COD: ৳${Math.round(codAmt2).toLocaleString()} বাদে)` : '';
    el('preview-net').textContent = netProfit > 0 ? '৳' + Math.round(netProfit).toLocaleString() + codNote : '—';
  }
}

