  }
  function sampleCSV() {
    downloadCSV([['Date', 'Type', 'Amount', 'Note'], ['2026-10-01', 'Opening Balance', 10000, 'শুরুর ব্যালেন্স (ঐচ্ছিক)'], ['2026-10-05', 'Credit', 5000, 'বিক্রির টাকা'], ['2026-10-06', 'Debit', 1200.5, 'অফিস ভাড়া']], 'cashflow_sample.csv');
  }

  const keyOf = (date, type, amount, note) => `${date}|${type}|${Math.round(amount * 100)}|${String(note || '').trim().slice(0, 500)}`;

  // CSV টেক্সট → { rows:[{line,date,type,amount,note,bad}], opening, error }
  function analyzeCSV(text) {
    const all = parseCSV(text);
    if (all.length < 2) return { error: 'CSV-এ কোনো ডেটা নেই' };
    const hd = all[0].map(h => bn2en(String(h)).toLowerCase().replace(/\(.*?\)|৳/g, '').trim());
    const find = vs => hd.findIndex(h => h && !/balance|ব্যালেন্স/.test(h) && vs.some(v => h === v || h.includes(v)));
    const ci = { date: find(['date', 'তারিখ']), type: find(['type', 'ধরন', 'ধরণ']), amount: find(['amount', 'পরিমাণ', 'টাকা']), note: find(['note', 'description', 'বিবরণ', 'নোট']) };
    if (ci.date < 0 || ci.amount < 0) return { error: 'Header পাওয়া যায়নি — প্রথম লাইনে Date, Type, Amount, Note কলাম থাকতে হবে' };
    const out = []; let opening = null;
    all.slice(1).forEach((r, i) => {
      const cell = k => (ci[k] >= 0 ? String(r[ci[k]] == null ? '' : r[ci[k]]).trim() : '');
      const tRaw = cell('type'), line = i + 2; let note = cell('note').replace(/^'(?=[=+\-@])/, '');
      let amt = parseAmt(cell('amount')), date = parseDateAny(cell('date'));
      if (/opening|ওপেনিং|শুরুর/i.test(tRaw)) {
        if (isFinite(amt) && amt >= 0) opening = { amount: Math.abs(amt), date: cell('date') ? date : '', line };
        else out.push({ line, date: cell('date'), type: tRaw, amount: cell('amount'), note, bad: 'Opening-এর পরিমাণ ভুল' });
        return;
      }
      let type = '';
      if (tRaw) { if (/credit|জমা|^cr$|^in$|^\+|আয়/i.test(tRaw)) type = 'Credit'; else if (/debit|খরচ|ব্যয়|^dr$|^out$|^-/i.test(tRaw)) type = 'Debit'; }
      else if (isFinite(amt) && amt !== 0) type = amt > 0 ? 'Credit' : 'Debit';
      let bad = '';
      if (!type) bad = tRaw ? 'ধরন বোঝা যায়নি' : 'ধরন নেই';
      else if (!isFinite(amt) || amt === 0) bad = 'পরিমাণ ভুল';
      else if (Math.abs(amt) > 999999999999) bad = 'পরিমাণ অতিরিক্ত বড়';
      else if (!date) bad = 'তারিখ বোঝা যায়নি';
      out.push({ line, date: date || cell('date'), type: type || tRaw, amount: bad && !isFinite(amt) ? cell('amount') : Math.abs(amt), note: note.slice(0, 500), bad });
    });
    return { rows: out, opening };
  }

  // ── Import UI ──
  const IMP = { rows: [], opening: null, running: false, timer: null };
  function impReset() {
    IMP.rows = []; IMP.opening = null;
    ['cf-imp-preview', 'cf-imp-progress', 'cf-imp-result'].forEach(i => { $(i).style.display = 'none'; });
    $('cf-imp-submit').style.display = 'none'; $('cf-imp-submit').disabled = false; $('cf-imp-drop').style.display = 'block'; $('cf-imp-file').value = '';
  }
  function openImport() { clearTimeout(IMP.timer); impReset(); $('modal-cf-import').classList.add('open'); }
  function closeImport() { if (IMP.running) return; clearTimeout(IMP.timer); closeModal('cf-import'); impReset(); }
  function impRead(file) { if (!file) return; const r = new FileReader(); r.onload = e => impParse(e.target.result); r.readAsText(file, 'UTF-8'); }
  function impDrop(e) { e.preventDefault(); $('cf-imp-drop').style.borderColor = 'var(--border)'; if (e.dataTransfer.files[0]) impRead(e.dataTransfer.files[0]); }
  function impParse(text) {
    const a = analyzeCSV(text);
    if (a.error) { toast(a.error, 'error'); return; }
    IMP.rows = a.rows; IMP.opening = a.opening;
    $('cf-imp-drop').style.display = 'none'; $('cf-imp-preview').style.display = 'block'; $('cf-imp-result').style.display = 'none';
    const ow = $('cf-imp-open-wrap');
    if (IMP.opening) {
      ow.style.display = 'flex'; $('cf-imp-useopen').checked = !CF.openingSet;
      $('cf-imp-open-text').textContent = `CSV-র Opening Balance ${money(IMP.opening.amount)} সেট করুন` + (CF.openingSet ? ` (বর্তমান ${money(CF.opening)} বদলে যাবে)` : '');
    } else ow.style.display = 'none';
    impRefresh();
  }
  // কোন row যাবে/বাদ যাবে — বিদ্যমান এন্ট্রির সাথে মিলিয়ে (multiset: একই হুবহু row একাধিকবার থাকলে সংখ্যা মেলানো হয়)
  function impPlan() {
    const skip = $('cf-imp-skipdup').checked, pool = {};
    if (skip) CF.entries.forEach(e => { const k = keyOf(e.date, e.type, e.amount, e.note); pool[k] = (pool[k] || 0) + 1; });
    return IMP.rows.map(r => {
      if (r.bad) return { r, st: 'bad' };
      const k = keyOf(r.date, r.type, r.amount, r.note);
      if (skip && pool[k] > 0) { pool[k]--; return { r, st: 'dup' }; }
      return { r, st: 'new' };
    });
  }
  function impRefresh() {
    const plan = impPlan(), n = plan.filter(p => p.st === 'new').length, d = plan.filter(p => p.st === 'dup').length, b = plan.filter(p => p.st === 'bad').length;
    $('cf-imp-summary').innerHTML = `মোট ${plan.length}টি row · ✅ নতুন ${n} · ⚠️ ডুপ্লিকেট ${d} · ❌ ভুল ${b}`;
    $('cf-imp-tbody').innerHTML = plan.slice(0, 100).map(({ r, st }) => {
      const stx = st === 'new' ? '<span style="color:var(--green)">✅ নতুন</span>' : st === 'dup' ? '<span style="color:var(--gold)">⚠️ ডুপ্লিকেট — বাদ যাবে</span>' : `<span style="color:var(--red)">❌ ${esc(r.bad)} (লাইন ${r.line})</span>`;
      return `<tr style="${st === 'bad' ? 'background:rgba(248,81,73,.06);' : ''}"><td style="padding:5px 10px;border-bottom:1px solid var(--border);white-space:nowrap;">${esc(r.date) || '—'}</td><td style="padding:5px 10px;border-bottom:1px solid var(--border);">${esc(r.type) || '—'}</td><td style="padding:5px 10px;border-bottom:1px solid var(--border);text-align:right;">${esc(r.amount)}</td><td style="padding:5px 10px;border-bottom:1px solid var(--border);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(r.note) || '—'}</td><td style="padding:5px 10px;border-bottom:1px solid var(--border);white-space:nowrap;">${stx}</td></tr>`;
    }).join('') + (plan.length > 100 ? `<tr><td colspan="5" style="padding:6px 10px;color:var(--text3);">… আরও ${plan.length - 100}টি row (প্রথম ১০০টি দেখানো হয়েছে)</td></tr>` : '');
    const btn = $('cf-imp-submit'), total = n + (IMP.opening ? 1 : 0);
    btn.style.display = total ? 'inline-flex' : 'none'; $('cf-imp-submit-text').textContent = n ? `${n}টি এন্ট্রি Import করুন` : 'Opening Balance সেট করুন';
  }
  async function impSubmit() {
    if (IMP.running || CF.busy) return;
    const plan = impPlan().filter(p => p.st === 'new').map(p => ({ date: p.r.date, type: p.r.type, amount: p.r.amount, note: p.r.note }));
    const useOpen = !!(IMP.opening && $('cf-imp-useopen').checked);
    if (!plan.length && !useOpen) { toast('Import করার মতো নতুন কিছু নেই', 'error'); return; }
    IMP.running = CF.busy = true; $('cf-imp-submit').disabled = true;
    $('cf-imp-preview').style.display = 'none'; $('cf-imp-progress').style.display = 'block'; $('cf-imp-result').style.display = 'none';
    const batch = 'imp' + Date.now() + Math.random().toString(36).slice(2, 6);
    // ব্যাচ ভাগ: সর্বোচ্চ ১০০টি row। ফাইল সরাসরি ডিস্ক (file://) থেকে খুললে অ্যাপ ডেটা URL-এ পাঠায় (~৭৫০০ অক্ষর সীমা) — তাই তখন আকার ধরে ছোট ব্যাচ
    const sizeLimit = location.protocol === 'file:' ? 4200 : Infinity, parts = []; let curPart = [], curLen = 0;
    plan.forEach(r => { const l = JSON.stringify(r).length + 1; if (curPart.length && (curPart.length >= 100 || curLen + l > sizeLimit)) { parts.push(curPart); curPart = []; curLen = 0; } curPart.push(r); curLen += l; });
    if (curPart.length || !parts.length) parts.push(curPart);
    const chunks = parts.length;
    let added = 0, dups = 0, invalid = 0, failed = false; const errs = [];
    try {
      for (let c = 0; c < chunks; c++) {
        $('cf-imp-ptext').textContent = `পাঠানো হচ্ছে… ব্যাচ ${c + 1} / ${chunks}`;
        $('cf-imp-pbar').style.width = Math.round((c / chunks) * 90 + 5) + '%';
        const payload = { action: 'cfBulkImport', batch: batch + 'c' + c, rows: parts[c] };
        if (c === 0 && useOpen) payload.opening = { set: true, amount: IMP.opening.amount, date: IMP.opening.date || '' };
        const r = await netPost(payload);
        if (!r) { failed = true; break; }
        added += r.added || 0; dups += r.duplicates || 0; invalid += r.invalid || 0; (r.errors || []).forEach(e => errs.push(e));
      }
      $('cf-imp-pbar').style.width = '100%'; $('cf-imp-progress').style.display = 'none';
      const res = $('cf-imp-result'); res.style.display = 'block';
      if (failed) {
        res.style.cssText = 'display:block;margin-top:14px;padding:12px;border-radius:8px;background:rgba(248,81,73,0.1);border:1px solid rgba(248,81,73,0.3);color:var(--red);font-size:13px;';
        res.innerHTML = `❌ Import মাঝপথে থেমেছে — ${added}টি এন্ট্রি সেভ হয়েছে। একই ফাইল আবার Import করুন: ডুপ্লিকেট বাদ থাকায় সেভ হওয়া এন্ট্রিগুলো দ্বিতীয়বার যাবে না।<br><button class="btn" style="margin-top:8px;" onclick="cfImpReset()">🔄 আবার চেষ্টা করুন</button>`;
        IMP.running = CF.busy = false; $('cf-imp-submit').disabled = false; await load(); return;
      }
      res.style.cssText = 'display:block;margin-top:14px;padding:12px;border-radius:8px;background:rgba(34,201,122,0.1);border:1px solid rgba(34,201,122,0.3);color:var(--green);font-size:13px;font-weight:600;text-align:center;';
      res.textContent = `✅ ${added}টি এন্ট্রি import হয়েছে` + (useOpen ? ' · Opening Balance সেট হয়েছে' : '') + (invalid ? ` · ${invalid}টি ভুল row বাদ` : '');
      try { logAction(`Cash Flow CSV import: ${added}টি এন্ট্রি`); } catch (e) {}
      IMP.running = CF.busy = false; await load();
      toast(`✅ ${added}টি এন্ট্রি import সম্পন্ন`, 'success');
      if (!invalid && !errs.length) IMP.timer = setTimeout(() => { closeImport(); }, 1800);
    } finally { IMP.running = CF.busy = false; }
  }

  // inline onclick-এর জন্য global expose (সব নাম cf-প্রিফিক্স)
  Object.assign(window, { cfLoad: load, cfRender: render, cfOpenEntry: openEntry, cfSetType: setType, cfSubmitEntry: submitEntry, cfDelete: del, cfOpenOpening: openOpening, cfSubmitOpening: submitOpening, cfPreviewOpening: cfPreview, cfKpi: openKpi, cfKpiSet: kpiSet, cfKpiSearch: kpiSearch, cfKpiToMain: kpiToMain, cfKpiCsv: kpiCsv, cfClearFilters: clearFilters, cfRefreshCard: refreshCard, cfRetry: retry, cfDiscard: discard, cfRetryAll: retryAll, __cfCompute: compute, cfExport: exportCSV, cfPrint: printCF, cfSampleCSV: sampleCSV, cfOpenImport: openImport, cfCloseImport: closeImport, cfImpReset: impReset, cfImpRead: impRead, cfImpDrop: impDrop, cfImpRefresh: impRefresh, cfImpSubmit: impSubmit, __cfAnalyze: analyzeCSV, __cfParseCSV: parseCSV });

  // ── বিদ্যমান নেভিগেশনে যুক্ত হওয়া — মূল showPage অপরিবর্তিত, শুধু wrap করা ──
  if (typeof pageTitles === 'object') pageTitles.cashflow = ['Cash Flow', '— আলাদা ক্যাশ ব্যালেন্স'];
  if (typeof window.showPage === 'function') {
    const orig = window.showPage;
    window.showPage = function (id) {
      const r = orig.apply(this, arguments);
      try { if (id === 'cashflow') load(); else if (id === 'dashboard') setTimeout(refreshCard, 700); } catch (e) { console.error('cashflow hook:', e); }
      return r;
    };
  }
  window.addEventListener('load', () => setTimeout(() => { try { refreshCard(); } catch (e) {} }, 2500));
})();

/* ═══════════════════════════════════════════════════════════════
   🧾 PURCHASE TRACKER MODULE (Independent) — v84
   • নিজস্ব state/API/শিট ('Purchase_Tracker'); Sales, Expense, Inventory, Partner, Cash Flow, Dashboard — কিছুই পড়ে/লেখে না
   • সব সারাংশ শুধু Purchase_Tracker-এর ডেটা থেকে; Payment Method/Source কেবল বর্ণনামূলক টেক্সট
   • বিদ্যমান ফাংশন শুধু ব্যবহার করে: fetchFromAPI, postToAPI, showToast, logAction, closeModal, showPage
   ═══════════════════════════════════════════════════════════════ */
(function () {
  'use strict';
  const PT = { rows: [], loaded: false, page: 1, per: 25, editId: null, saving: false, sid: '', n: 0, filtered: [] };
  const $ = id => document.getElementById(id);
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const num = n => { n = Number(n) || 0; return Math.abs(n).toLocaleString('en-BD', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); };
  const money = n => '৳' + num(n);
  const toast = (m, t) => { try { showToast(m, t || 'success'); } catch (e) {} };
  const todayBD = () => { try { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka' }).format(new Date()); } catch (e) { return new Date().toISOString().slice(0, 10); } };
  const fmtDate = d => { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(d || '')); return m ? `${m[3]}-${MONTHS[+m[2] - 1]}-${m[1]}` : esc(d || '—'); };
  const cents = (q, p) => Math.round(Number(q) * Number(p) * 100);
  const rid = () => 'pt' + Date.now() + Math.random().toString(36).slice(2, 8);
  let _last = 0;
  async function spaced(fn) { let n = Date.now(); while (n <= _last) { await new Promise(r => setTimeout(r, 2)); n = Date.now(); } _last = n; return fn(); }
  const netGet = (a, p) => spaced(() => fetchFromAPI(a, p));
  const netPost = pl => spaced(() => postToAPI(pl));
  const PHONE_RE = /^[0-9+\-\s()]{5,30}$/;
  const showErr = (id, msg) => { const e = $(id); if (!e) return; e.textContent = msg || ''; e.style.display = msg ? 'block' : 'none'; };

  // ── Items (একাধিক পণ্য) ──
  function itemRowHTML(k) {
    return `<div class="pt-item" data-k="${k}">
      <input type="text" class="form-input pt-i-name" maxlength="160" placeholder="পণ্যের নাম" oninput="ptCalc()">
      <input type="number" class="form-input pt-i-qty" min="0" step="any" inputmode="decimal" placeholder="Qty" oninput="ptCalc()">
      <input type="number" class="form-input pt-i-price" min="0" step="any" inputmode="decimal" placeholder="Unit Price" oninput="ptCalc()">
      <div class="pt-line">৳0</div>
      <button type="button" class="btn btn-sm pt-i-del" title="আইটেম সরান" onclick="ptRemoveItem(this)">🗑️</button>
    </div>`;
  }
  function addItem(focus) {
    $('pt-items').insertAdjacentHTML('beforeend', itemRowHTML(++PT.n));
    refreshDel(); calc();
    if (focus) { const r = $('pt-items').lastElementChild; try { r.querySelector('.pt-i-name').focus(); } catch (e) {} }
  }
  function removeItem(btn) {
    const rows = $('pt-items').children; if (rows.length <= 1) return;
    btn.closest('.pt-item').remove(); refreshDel(); calc();
  }
  function refreshDel() {
    const rows = $('pt-items').children;
    Array.from(rows).forEach(r => { const b = r.querySelector('.pt-i-del'); b.disabled = rows.length <= 1; b.style.opacity = rows.length <= 1 ? .4 : 1; });
  }
  function calc() {
    let total = 0;
    Array.from($('pt-items').children).forEach(r => {
      const q = Number(r.querySelector('.pt-i-qty').value), p = Number(r.querySelector('.pt-i-price').value);
      const c = (isFinite(q) && isFinite(p) && q > 0 && p >= 0) ? cents(q, p) : 0;
      r.querySelector('.pt-line').textContent = money(c / 100); total += c;
    });
    $('pt-grand').textContent = money(total / 100);
  }
  function resetForm(keepHeader) {
    PT.sid = '';
    if (!keepHeader) { ['pt-supplier', 'pt-phone', 'pt-invoice', 'pt-note'].forEach(i => $(i).value = ''); $('pt-method').value = ''; $('pt-source').value = ''; }
    $('pt-date').value = todayBD(); $('pt-paid').value = '';
    $('pt-items').innerHTML = ''; addItem(false); showErr('pt-err', '');
  }

  // ── Save (এক সাবমিশন = ১..N row; sid দিয়ে retry-নিরাপদ) ──
  async function save() {
    if (PT.saving) return;
    const h = {
      date: $('pt-date').value, supplier: $('pt-supplier').value.trim(), phone: $('pt-phone').value.trim(),
      method: $('pt-method').value, source: $('pt-source').value, invoice: $('pt-invoice').value.trim(), note: $('pt-note').value.trim()
    };
    if (!/^\d{4}-\d{2}-\d{2}$/.test(h.date)) return showErr('pt-err', 'তারিখ বেছে নিন');
    if (!h.supplier) return showErr('pt-err', 'সরবরাহকারীর নাম দিন');
