// ── 🛡️ ডাবল-ক্লিক সুরক্ষা: সেভ চলাকালীন একই বাটন আবার চাপলে কিছু হবে না (Investor ফর্মগুলো) ──
window.addEventListener('load', function(){
  ['submitAddInvestor','submitEditInvestor','submitPayProfit','submitBuyback','submitDistributeProfit'].forEach(function(n){
    const f = window[n]; if (typeof f !== 'function') return;
    let busy = false;
    window[n] = async function(){
      if (busy) return; busy = true;
      const btns = Array.from(document.querySelectorAll('button[onclick^="'+n+'("]')), was = btns.map(b => b.disabled);
      btns.forEach(b => { b.disabled = true; b.style.opacity = '.6'; });
      try { return await f.apply(this, arguments); }
      finally { busy = false; btns.forEach((b,i) => { b.disabled = was[i]; b.style.opacity = ''; }); }
    };
  });
});
