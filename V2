  }).join('');
}

const _expEsc = s => String(s==null?'':s).replace(/[&<>"']/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[x]));
function expClamp(e, field){
  const t = String(e[field]||'').trim(); if(!t) return '—';
  const long = t.length > 70 || /\n/.test(t);
  return long ? `<div class="exp-clamp" title="বিস্তারিত পড়তে ক্লিক করুন" onclick="expRead('${_expEsc(e.id)}')">${_expEsc(t)}</div><a class="exp-readmore" onclick="expRead('${_expEsc(e.id)}')">📖 পুরোটা পড়ুন</a>` : _expEsc(t);
}
// বড় লেখাকে সুন্দর তালিকা/অনুচ্ছেদে সাজায় (1) 2) ... বা নতুন লাইন দেখে)
function _expFormat(text){
  const t = String(text||'').trim(); if(!t) return '<span style="color:var(--text3)">—</span>';
  let parts = t.split(/\n+/).map(s=>s.trim()).filter(Boolean);
  if(parts.length < 2){ const num = t.split(/(?:^|\s)(?=\d{1,2}(?:\)|\.\s)\s*\S)/).map(s=>s.trim()).filter(Boolean); if(num.length >= 2) parts = num; }
  if(parts.length < 2) return `<div class="exp-rtext">${_expEsc(t)}</div>`;
  return '<div class="exp-rlist">'+parts.map((s,i)=>{ const m=/^(\d{1,2})(?:\)|\.\s)\s*(.*)$/.exec(s); return `<div class="exp-ritem"><span class="exp-rno">${m?m[1]:i+1}</span><div>${_expEsc(m?m[2]:s)}</div></div>`; }).join('')+'</div>';
}
