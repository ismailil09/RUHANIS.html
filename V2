      link.click();
      showToast('✅ PNG ডাউনলোড হয়েছে!', 'success');
    }).catch(e => {
      showToast('PNG error: ' + e.message, 'error');
    }).finally(() => {
      document.body.removeChild(wrapper);
    });
    const fontsReady = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
    fontsReady.then(() => setTimeout(capture, 150)); // ফন্ট রেডি হওয়ার পরও একটু বাফার সময়
  };
  if (typeof html2canvas !== 'undefined') { doCapture(); return; }
  const script = document.createElement('script');
  script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
  script.onload = doCapture;
  script.onerror = () => showToast('PNG library load হয়নি — ইন্টারনেট কানেকশন চেক করুন','error');
  document.head.appendChild(script);
}

