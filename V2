// ── ট্র্যাকিং টেবিল রেন্ডার
function renderCourierTable(data) {
  if (!data) data = window._lastCourierData || buildCourierData();
  window._lastCourierData = data;

  const courierF = document.getElementById('ch-courier-filter')?.value || '';
  const statusF  = document.getElementById('ch-status-filter')?.value  || '';
  const tbody    = document.getElementById('courier-tracking-tbody');
  const showing  = document.getElementById('ch-showing');
  const counter  = document.getElementById('ch-table-count');
  if (!tbody) return;

  let rows = [];
  Object.entries(data).forEach(([cName, d]) => {
    d.orders.forEach(o => rows.push({...o, courier: cName}));
  });

  // ফিল্টার
  if (courierF) rows = rows.filter(r => r.courier === courierF);
  if (statusF)  rows = rows.filter(r => r.status  === statusF);
  rows.sort((a,b) => (b.date > a.date ? 1 : -1));

  if (rows.length === 0) {
    tbody.innerHTML = `<tr><td colspan="11" style="text-align:center;color:var(--text3);padding:40px;">কোনো ডেটা পাওয়া যায়নি</td></tr>`;
    if(showing) showing.textContent = 'Showing 0 records';
    if(counter) counter.textContent = '০ রেকর্ড';
    return;
  }

  const statusColor = { Delivered:'var(--green)', 'In Transit':'var(--blue)', Processing:'var(--gold)', Pending:'var(--text3)', Returned:'var(--red)', Cancelled:'var(--red)' };
  const cfg = COURIER_CONFIG;

  // ✅ FIX v40: Fix 2.2 (CN copy btn) + Fix 2.3 (CN# copy fix) + Feature 5 (🚀 Book Courier)
  tbody.innerHTML = rows.slice(0, 200).map((r, i) => {
    const clsKey   = cfg[r.courier]?.cls || '';
    const trackUrl = cfg[r.courier]?.trackUrl || '';
    const trackLink = (r.tracking && trackUrl)
      ? trackUrl.replace('{code}', encodeURIComponent(r.tracking))
      : '';

    // CN# এবং Consignment ID আলাদাভাবে দেখাও
    const rawCN = r.cnCode || r.tracking || '';
    const rawCID = (r.consignmentId && r.consignmentId !== rawCN) ? r.consignmentId : '';

    // Copy button helper
    const copyBtn = (val, label, color) =>
      `<button onclick="(function(){var v=${JSON.stringify(val)};if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(v).then(function(){showToast('✅ ${label} কপি হয়েছে!','success');}).catch(function(){var t=document.createElement('textarea');t.value=v;document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);showToast('✅ কপি!','success');});}else{var t=document.createElement('textarea');t.value=v;document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);showToast('✅ কপি!','success');};})()" title="${label} কপি করুন" style="margin-left:4px;padding:2px 7px;font-size:10px;font-weight:700;background:rgba(${color},.15);color:rgba(${color},1);border:1px solid rgba(${color},.4);border-radius:5px;cursor:pointer;">${label}</button>`;

    // ✅ FIX (সমস্যা ১): ম্যানুয়ালি সেভ করা এক-ক্লিক লিংক থাকলে সেটাই আসল লিংক —
    // না থাকলে জেনেরিক (fallback, সরাসরি পার্সেল খোলে না) ট্র্যাকিং পেজ
    const genericLink = (rawCN && cfg[r.courier]?.trackUrl)
      ? cfg[r.courier].trackUrl.replace('{code}', encodeURIComponent(rawCN))
      : '';
    const trackLink2 = r.manualLink || genericLink;
    const oidEsc = String(r.orderId).replace(/'/g, "\\'");
    const linkEsc = String(r.manualLink||'').replace(/'/g, "\\'");
    const saveLinkBtn = `<button onclick="saveTrackingLink('${oidEsc}','${linkEsc}')" title="${r.manualLink?'কুরিয়ার অ্যাপ থেকে কপি করা লিংক এডিট করুন':'কুরিয়ার অ্যাপ থেকে কপি করা এক-ক্লিক লিংক পেস্ট করে সেভ করুন'}" style="margin-left:4px;padding:2px 6px;font-size:10px;background:rgba(139,92,246,.15);color:#8b5cf6;border:1px solid rgba(139,92,246,.35);border-radius:5px;cursor:pointer;">${r.manualLink?'✏️':'➕🔗'}</button>`;

    let trackCell = '';
    if (rawCID) {
      trackCell += `<div style="margin-bottom:3px;">`;
      trackCell += `<span style="font-size:9px;color:var(--text3);letter-spacing:.4px;">Consignment ID</span><br>`;
      trackCell += `<span style="font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:700;color:var(--gold);">#${rawCID}</span>`;
      trackCell += copyBtn(rawCID, '#CID', '212,160,23');
      trackCell += `</div>`;
    }
    if (rawCN) {
      trackCell += `<div style="margin-top:${rawCID?'2px':'0'};">`;
      trackCell += rawCID ? `<span style="font-size:9px;color:var(--text3);">CN#</span><br>` : '';
      trackCell += `<span style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--blue);letter-spacing:.3px;">${rawCN}</span>`;
      trackCell += copyBtn(rawCN, 'CN', '77,158,255');
      if (trackLink2) trackCell += `<a href="${trackLink2}" target="_blank" title="${r.manualLink?'এক-ক্লিকে সরাসরি পার্সেল ডিটেইলস':'সাধারণ ট্র্যাকিং পেজ (ম্যানুয়ালি CN# বসাতে হবে)'}" style="margin-left:4px;padding:2px 7px;font-size:10px;background:rgba(52,209,116,.15);color:var(--green);border:1px solid rgba(52,209,116,.3);border-radius:5px;text-decoration:none;font-weight:700;">🔗</a>`;
      trackCell += saveLinkBtn;
      trackCell += `</div>`;
    }
    if (!rawCN && !rawCID) {
      trackCell = `<span style="color:var(--text3);font-size:11px;">—</span>`;
    }

    // Feature 5: 🚀 Book Courier বাটন — tracking নেই এমন orders-এ দেখাবে
    const notBooked = !rawCN && (r.courier === 'Steadfast' || r.courier === 'Pathao');
    const oid = String(r.orderId).replace(/'/g, "\\'");
    const statusCell = notBooked
      ? '<button onclick="manualBookCourier(\'' + oid + '\',\'' + r.courier + '\')" title="' + r.courier + '-এ বুক করুন" style="padding:3px 10px;font-size:11px;font-weight:700;background:rgba(212,160,23,.2);color:var(--gold,#f0b429);border:1px solid rgba(212,160,23,.45);border-radius:6px;cursor:pointer;">🚀 Book Courier</button>'
      : '<span style="font-size:11px;font-weight:700;color:' + (statusColor[r.status]||'var(--text3)') + ';">' + r.status + '</span>';

    return '<tr>'
      + '<td style="color:var(--text3);font-size:11px;">' + (i+1) + '</td>'
      + '<td style="font-size:11px;color:var(--text3);">' + r.date + '</td>'
      + '<td style="font-weight:600;">' + r.customer + '</td>'
      + '<td style="font-family:\'IBM Plex Mono\',monospace;font-size:11px;color:var(--blue);">' + r.orderId + '</td>'
      + '<td><span class="courier-badge-pill cb-' + clsKey + '">' + (cfg[r.courier]?.icon||'') + ' ' + r.courier + '</span></td>'
      + '<td>' + trackCell + '</td>'
      + '<td style="font-size:12px;">' + r.location + '</td>'
      + '<td class="delivery-cost-cell">৳' + fmt(r.delivFee) + '</td>'
      + '<td class="cod-cost-cell" style="color:' + (r.codAmt>0?'var(--red)':'var(--text3)') + ';" title="COD চার্জ: ৳' + fmt(r.codAmt) + '">৳' + fmt(r.codAmt) + '</td>'
      + '<td class="net-payable-cell" style="color:var(--green);font-weight:700;">৳' + fmt(r.netPay) + '</td>'
      + '<td>' + statusCell + '</td>'
      + '</tr>';
  }).join('');

  if(showing) showing.textContent = `Showing ${Math.min(rows.length,200)} of ${rows.length} records`;
  if(counter) counter.textContent = `${rows.length} রেকর্ড`;
}

