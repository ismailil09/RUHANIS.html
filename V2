  const s = String(v===null||v===undefined?'':v).replace(/"/g,'""').replace(/\r?\n/g,' ');
  return `"${s}"`;
}
function _downloadCSV(rows, filename){
  const bom = '\uFEFF';
  const csv = bom + rows.map(r=>r.map(_csvCell).join(',')).join('\r\n');
  const blob = new Blob([csv],{type:'text/csv;charset=utf-8;'});
