 * @param {'add'|'edit'} mode
 */
function updateProductSplitPreview(mode) {
  const prefix = mode === 'edit' ? 'eprod' : 'prod';
  // v67 FIX: guard against a non-numeric field value producing undefined/NaN
  // that could reach .toFixed() below and crash the modal.
  const i = Number(parseFloat(document.getElementById(prefix+'-split-ismail')?.value||0)) || 0;
  const a = Number(parseFloat(document.getElementById(prefix+'-split-ashik')?.value||0)) || 0;
  const total = i + a;
  const comp  = Math.max(0, 100 - total);
  const compEl  = document.getElementById(prefix+'-split-company-preview');
  const totalEl = document.getElementById(prefix+'-split-total-preview');
  if(compEl)  compEl.textContent  = comp.toFixed(1)+'%';
  if(totalEl) {
    totalEl.textContent = total.toFixed(1)+'%';
    totalEl.style.color = total > 100 ? 'var(--red)' : total === 100 ? 'var(--green)' : 'var(--text)';
  }
}

