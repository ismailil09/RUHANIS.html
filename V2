  notes:    ['notes','note','মন্তব্য','remarks'],
};

let impRawRows = [];
let impHeaders = [];
let impColMap  = {};
let impParsed  = [];

function impReset() {
  impRawRows=[]; impHeaders=[]; impColMap={}; impParsed=[];
  document.getElementById('imp-preview-wrap').style.display='none';
  document.getElementById('imp-progress-wrap').style.display='none';
