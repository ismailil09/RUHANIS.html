// ─── Helper: 'dd-MMM-yyyy...' বা যেকোনো তারিখ স্ট্রিং কে <input type=date> এর
//     জন্য 'yyyy-MM-dd' ফরম্যাটে বদলায়; না পারলে খালি রাখে ───
function _shToDateInput(dateStr){
  const p = shParseDate(dateStr);
  return p ? `${p.y}-${String(p.m).padStart(2,'0')}-${String(p.d).padStart(2,'0')}` : '';
}
// আজকের তারিখ — বাংলাদেশ সময় (Asia/Dhaka) অনুযায়ী, UTC নয়
function dNowBD_(){
  try{ return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Dhaka',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()); }
  catch(e){ const d=new Date(Date.now()+6*3600*1000); return d.toISOString().slice(0,10); }
}


// ═══ v80: Date helpers, HTML escape, Book-style Reader, id-based Edit/Delete ═══
const SH_MON = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
const SH_BN_MONTHS = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
function shEsc(v){ return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
function shBnNum(n){ return String(n).replace(/\d/g, c=>'০১২৩৪৫৬৭৮৯'[c]); }
// যেকোনো তারিখ ফরম্যাট (yyyy-mm-dd / dd-MMM-yyyy / পুরনো ISO UTC 'T18:00:00.000Z') → {y,m,d} (ঢাকা সময়)
function shParseDate(v){
  if(v==null) return null;
  const t = String(v).trim(); if(!t) return null;
  let m;
  if((m = t.match(/^(\d{4})-(\d{2})-(\d{2})T/))){
    const d = new Date(t);
    if(!isNaN(d.getTime())){ const b = new Date(d.getTime()+6*3600*1000); return {y:b.getUTCFullYear(), m:b.getUTCMonth()+1, d:b.getUTCDate()}; }
  }
  if((m = t.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/))) return {y:+m[1], m:+m[2], d:+m[3]};
  if((m = t.match(/^(\d{1,2})[-\s\/]([A-Za-z]{3})[A-Za-z]*[-\s\/,]*(\d{4})/))){ const mo = SH_MON[m[2].toLowerCase()]; if(mo) return {y:+m[3], m:mo, d:+m[1]}; }
  if((m = t.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/))) return {y:+m[3], m:+m[2], d:+m[1]};
  return null;
}
function shFmtDate(v){
  const p = shParseDate(v);
  if(!p) return v ? shEsc(v) : '—';
  return `${shBnNum(p.d)} ${SH_BN_MONTHS[p.m-1]} ${shBnNum(p.y)}`;
}
function shFindItem(kind,id){
  const arr = kind==='task' ? liveDailyTasksData : kind==='plan' ? liveStrategyPlansData : liveIdeaNotesData;
  return arr.find(x => String(x.id)===String(id));
}
function shEditItem(kind,id){
  const it = shFindItem(kind,id); if(!it) return;
  shCloseReader();
  if(kind==='task') openAddTaskModal(it); else if(kind==='plan') openAddPlanModal(it); else openAddIdeaModal(it);
}
async function shDeleteItem(kind,id){
  const it = shFindItem(kind,id); if(!it) return;
  const label = kind==='task' ? 'Task' : kind==='plan' ? 'Strategy Plan' : 'Idea';
  const name = (kind==='task' ? it.description : it.title) || '';
  const short = name.length>80 ? name.slice(0,80)+'…' : name;
  if(!confirm(`${label} মুছে ফেলতে চান?\n"${short}"\n\n(Recycle Bin-এ পাঠানো হবে — ৩০ দিন পর্যন্ত পুনরুদ্ধার করা যাবে)`)) return;
  const action = kind==='task' ? 'deleteDailyTask' : kind==='plan' ? 'deleteStrategyPlan' : 'deleteIdea';
  const idKey  = kind==='task' ? 'taskId' : kind==='plan' ? 'strategyId' : 'ideaId';
  const payload = { action }; payload[idKey] = String(id);
  const result = await postToAPI(payload);
  if(!result) return;
  // সাথে সাথে স্ক্রিন থেকে সরিয়ে ফেলা
  if(kind==='task'){ liveDailyTasksData = liveDailyTasksData.filter(x=>String(x.id)!==String(id)); renderDailyTasksTable(); }
  else if(kind==='plan'){ liveStrategyPlansData = liveStrategyPlansData.filter(x=>String(x.id)!==String(id)); renderStrategyPlansTable(); }
  else { liveIdeaNotesData = liveIdeaNotesData.filter(x=>String(x.id)!==String(id)); renderIdeaNotesTable(); }
  shCloseReader();
  showToast(`🗑️ ${label} Recycle Bin-এ পাঠানো হয়েছে`, 'success');
  logAction(`${label} #${id} মুছে ফেলেছেন`);
}

