  address:  ['address','ঠিকানা','addr'],
  product:  ['product','পণ্য','item','product name'],
  qty:      ['qty','quantity','পরিমাণ','পিস','pieces','count'],
  price:    ['unit price','price','মূল্য','দাম','rate'],
