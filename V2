function impHandleDrop(e) {
  e.preventDefault();
  document.getElementById('imp-drop-zone').style.borderColor='var(--border)';
  const file = e.dataTransfer.files[0];
  if(file) impReadFile(file);
}

function impReadFile(file) {
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const text = e.target.result;
    impParseCSV(text);
  };
  reader.readAsText(file, 'UTF-8');
}

function impParseCSV(text) {
  // BOM remove
  text = text.replace(/^\uFEFF/,'').replace(/^﻿/,'');
  // Line split
  const lines = text.replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n').filter(l=>l.trim());
  if(lines.length < 2){ showToast('CSV-এ কোনো data নেই','error'); return; }

  // Parse function — handles quoted fields properly
  function parseLine(line){return igxSafe.parseLine(line);}
  function __legacyParseLine(line) {
    const result = [];
    let cur = '', inQ = false;
    for(let i=0;i<line.length;i++){
      const ch = line[i];
      if(ch==='"'){ inQ=!inQ; continue; }
      if(ch===','&&!inQ){ result.push(cur.trim()); cur=''; continue; }
      cur += ch;
    }
    result.push(cur.trim());
    return result;
  }

  // FIX v24: header cleanup — শুধু leading/trailing whitespace ও quotes বাদ দাও
  // আগের regex /[^a-zA-Z0-9ঀ-৿ ]/g # চিহ্ন সহ অনেক কিছু বাদ দিত — ঠিক করা হয়েছে
  impHeaders = parseLine(lines[0]).map(h => h.replace(/^["'\s]+|["'\s]+$/g,'').trim());
  impRawRows = lines.slice(1).map(l=>parseLine(l));

  // FIX v24: Improved column matching — false positive বন্ধ করা হয়েছে
  // Priority: exact match > startsWith > word-boundary contains
  // 'unit' যেন 'unit price' এর সাথে match না করে ভুলে
  impColMap = {};
  Object.entries(IMP_FIELDS).forEach(([field, variants])=>{
    let found = -1;
    const headers = impHeaders.map(h => h.toLowerCase().trim());

    // Pass 1: exact match
    if(found < 0){
      for(let i=0;i<headers.length;i++){
        if(variants.some(v => v === headers[i])){ found=i; break; }
      }
    }
    // Pass 2: header starts with variant (e.g. "unit price" starts with "unit price")
    if(found < 0){
      for(let i=0;i<headers.length;i++){
        if(variants.some(v => headers[i].startsWith(v) || v.startsWith(headers[i]))){ found=i; break; }
      }
    }
    // Pass 3: variant is a substring of header (only if variant >= 5 chars to avoid short false matches)
    if(found < 0){
      for(let i=0;i<headers.length;i++){
        if(variants.some(v => v.length >= 5 && headers[i].includes(v))){ found=i; break; }
      }
    }
    if(found >= 0) impColMap[field] = found;
  });

  impShowPreview();
}

function impCleanNum(v) {
  // FIX v24: Bengali numeral support — ০১২৩ → 0123
  let s = String(v||'')
    .replace(/[০১২৩৪৫৬৭৮৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d))
    .replace(/[৳,\s]/g,'')
    .replace(/[^0-9.-]/g,'');
  const n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}

