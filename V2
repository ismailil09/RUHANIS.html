function updatePendingBadge(rows=[]){ rows = rows || [];
  // Filter empty rows first, then count pending/processing from real data only
  const validRows = rows.filter(r => r.customer && String(r.customer).trim());
  const pendingCount = validRows.filter(r=>{
    const s=String(r.status||'').toLowerCase().trim();
    return s==='pending'||s==='processing'||s==='in transit'||s==='intransit';
  }).length;
  // Update sidebar badge
  const badge=document.getElementById('sales-badge');
  if(badge){ badge.textContent=pendingCount; }
  // Update dashboard alert box elements
  const alertCount=document.getElementById('pending-alert-count');
  const alertTime=document.getElementById('pending-alert-time');
  if(alertCount) alertCount.textContent=pendingCount;
  if(alertTime){
    const now=new Intl.DateTimeFormat('en-BD',{timeZone:'Asia/Dhaka',hour:'2-digit',minute:'2-digit',hour12:true}).format(new Date());
    alertTime.textContent=now;
  }
  // Fallback: also update any .alert-box.warn that still has hardcoded text
  const alertBoxes = document.querySelectorAll('.alert-box.warn');
  alertBoxes.forEach(b=>{
    if(!b.id && (b.textContent.includes('pending processing')||b.textContent.includes('orders'))){
      const now=new Intl.DateTimeFormat('en-BD',{timeZone:'Asia/Dhaka',hour:'2-digit',minute:'2-digit',hour12:true}).format(new Date());
      b.innerHTML='📋 <strong>'+pendingCount+' orders</strong> are pending processing. Last update: '+now;
    }
  });
  // Update KPI pending card
  const kpiPending=document.getElementById('kpi-pending');
  if(kpiPending) kpiPending.textContent=pendingCount;
}



// OPT-3: filterSales debounce — 300ms পরে চালাও, keystroke-এ প্রতিবার না
let _filterSalesTimer=null;
function filterSales(){
  clearTimeout(_filterSalesTimer);
  _filterSalesTimer=setTimeout(_filterSalesNow, 300);
}
function _filterSalesNow(){
  const statusF=(document.getElementById('sales-status-filter')?.value)||'';
  const divF   =(document.getElementById('sales-div-filter')?.value)||'';
  const prodF  =(document.getElementById('sales-prod-filter')?.value)||'';
  const searchF=(document.getElementById('sales-search-input')?.value||document.querySelector('#page-sales .filter-bar .filter-input')?.value||'').toLowerCase().trim();
  const dateF  =(document.getElementById('sales-date-filter')?.value||document.querySelector('#page-sales .filter-bar input[type="date"]')?.value)||'';
  // Use live data if connected, otherwise sample data
  const data=liveSalesData;
  const filtered=data.filter(r=>{
    // SAFE: always stringify before comparison — Google Sheets may send numbers
    const rStatus=String(r.status||'');
    const rDiv=String(r.div||'');
    const rProd=String(r.product||'');
    const rCust=String(r.customer||'').toLowerCase();
    const rPhone=String(r.phone||'');
    const statusMatch=!statusF||statusF==='All Status'||rStatus===statusF;
    const divMatch=!divF||divF==='All Division'||rDiv===divF;
    const prodMatch=!prodF||prodF==='All Products'||rProd===prodF;
    const searchMatch=!searchF||rCust.includes(searchF)||rPhone.includes(searchF)||rProd.toLowerCase().includes(searchF);
    let dateMatch=true;
    if(dateF){
      // Build short month string from yyyy-mm-dd input
      const dParts=dateF.split('-');
      const monthNames=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const dStr=dParts[2]+'-'+monthNames[parseInt(dParts[1])-1]+'-'+dParts[0];
      // Also try ISO prefix match (2026-05-24)
      const isoPrefix=dateF;
      const rawISO=String(r.rawDateISO||r.rawDate||'');
      dateMatch=String(r.date||'').includes(dStr)||rawISO.startsWith(isoPrefix)||rawISO===dateF;
    }
    return statusMatch&&divMatch&&prodMatch&&searchMatch&&dateMatch;
  });
  renderSalesRows(filtered);
  document.getElementById('sales-count').textContent=filtered.length+' records';
}

