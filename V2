function isInLockout() {
  const lockoutUntil = parseInt(sessionStorage.getItem('innogix_lockout_until') || 0);
  return Date.now() < lockoutUntil;
}
function startLockout() {
  const until = Date.now() + LOCKOUT_DURATION * 1000;
  sessionStorage.setItem('innogix_lockout_until', until);
  failedAttempts = 0;
  runLockoutCountdown();
}
function runLockoutCountdown() {
  const errEl = document.getElementById('pin-error');
  // keypad disable করো
  document.querySelectorAll('.pin-key').forEach(k => k.disabled = true);
  lockoutTimer = setInterval(() => {
    const lockoutUntil = parseInt(sessionStorage.getItem('innogix_lockout_until') || 0);
    const remaining = Math.ceil((lockoutUntil - Date.now()) / 1000);
    if (remaining <= 0) {
      clearInterval(lockoutTimer);
      sessionStorage.removeItem('innogix_lockout_until');
      document.querySelectorAll('.pin-key').forEach(k => k.disabled = false);
      if (errEl) errEl.textContent = '';
      pinBuffer = ''; updatePinDots();
    } else {
      if (errEl) errEl.innerHTML = `🔒 অনেকবার ভুল চেষ্টা! <b>${remaining}s</b> অপেক্ষা করুন`;
    }
  }, 500);
}

// ── SessionStorage helpers (ট্যাব/রিফ্রেশে সেশন রিসেট হবে) ──
function lsGet(key) {
  // activity log এর মতো persistent data localStorage থেকে পড়ো
  if (key === 'innogix_activity_log') {
    try { return localStorage.getItem(key); } catch(e) { return null; }
  }
  try { return sessionStorage.getItem(key); } catch(e) { return null; }
}
function lsSet(key, val) {
  // activity log localStorage-এ সেভ করো (persistent)
  if (key === 'innogix_activity_log') {
    try { localStorage.setItem(key, val); } catch(e) {}
    return;
  }
  try { sessionStorage.setItem(key, val); } catch(e) {}
}
function lsRemove(key) {
  if (key === 'innogix_activity_log') {
    try { localStorage.removeItem(key); } catch(e) {}
    return;
  }
  try { sessionStorage.removeItem(key); } catch(e) {}
}

// ── Activity Log ──────────────────────────────────────────────
function getBDNow() {
  const d = new Date();
  const opts = { timeZone: 'Asia/Dhaka' };
  const bn = new Intl.DateTimeFormat('bn-BD', {
    ...opts, year:'numeric', month:'long', day:'numeric',
    hour:'2-digit', minute:'2-digit', second:'2-digit', hour12: true
  });
  return bn.format(d);
}

function logAction(description) {
  if (!currentPartner) return;
  const logs = getActivityLogs();
  logs.unshift({
    partner: currentPartner,
    action: description,
    time: getBDNow(),
    ts: Date.now(),
  });
  // সর্বোচ্চ ৫০০ রেকর্ড রাখো
  if (logs.length > 500) logs.splice(500);
  lsSet('innogix_activity_log', JSON.stringify(logs));
}

function getActivityLogs() {
  try {
    const raw = lsGet('innogix_activity_log');
    return raw ? JSON.parse(raw) : [];
  } catch(e) { return []; }
}

function renderActivityLog() {
  const filter = document.getElementById('log-partner-filter')?.value || '';
  let logs = getActivityLogs();
  if (filter) logs = logs.filter(l => l.partner === filter);
  const tbody = document.getElementById('activity-log-body');
  const countEl = document.getElementById('log-count');
  if (countEl) countEl.textContent = logs.length + ' records';
  if (!tbody) return;
  if (!logs.length) {
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:40px;color:var(--text3);">কোনো অ্যাক্টিভিটি লগ নেই</td></tr>';
    return;
  }
  tbody.innerHTML = logs.map((l, i) => {
    const col = PARTNER_COLORS[l.partner] || 'var(--gold)';
    return `<tr>
      <td style="font-family:'IBM Plex Mono',monospace;color:var(--text3);">${i+1}</td>
      <td style="font-size:12px;color:var(--text3);white-space:nowrap;">${l.time}</td>
      <td><span style="background:${col};color:#000;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;">${l.partner==='Ashik'?'Rabbi':l.partner}</span></td>
      <td style="font-size:13px;">${l.action}</td>
    </tr>`;
  }).join('');
}

function clearActivityLog() {
  if (!confirm('⚠️ সব অ্যাক্টিভিটি লগ মুছে ফেলবেন?')) return;
  lsRemove('innogix_activity_log');
  renderActivityLog();
  showToast('✅ অ্যাক্টিভিটি লগ পরিষ্কার হয়েছে', 'success');
  logAction('অ্যাক্টিভিটি লগ পরিষ্কার করা হয়েছে');
}

function exportActivityLog() {
  const logs = getActivityLogs();
  if (!logs.length) { showToast('কোনো লগ নেই', 'error'); return; }
  let csv = '"#","তারিখ ও সময়","পার্টনার","কার্যক্রম"\n';
  logs.forEach((l, i) => {
    csv += `"${i+1}","${l.time}","${l.partner==='Ashik'?'Rabbi':l.partner}","${l.action.replace(/"/g,'""')}"\n`;
  });
  const blob = new Blob(['\uFEFF'+csv], {type:'text/csv;charset=utf-8;'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'ActivityLog_' + new Date().toISOString().slice(0,10) + '.csv';
  a.click();
  showToast('✅ Activity Log exported', 'success');
}

