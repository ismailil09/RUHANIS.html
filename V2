function _renderSalesPagination() {
  const total = _salesFilteredRows.length;
  const pages = Math.ceil(total / SALES_PAGE_SIZE);
  const container = document.getElementById('sales-pagination') || (() => {
    const d = document.createElement('div');
    d.id = 'sales-pagination';
    d.style.cssText = 'display:flex;gap:8px;align-items:center;padding:12px 0;flex-wrap:wrap;';
    const tbody = document.getElementById('sales-body');
    if (tbody && tbody.closest('table')) {
      tbody.closest('table').after(d);
    }
    return d;
  })();
  if (pages <= 1) { container.innerHTML = `<span style="color:var(--text3);font-size:12px;">${total} records</span>`; return; }
  let html = `<span style="color:var(--text3);font-size:12px;">${total} records · Page ${_salesPage}/${pages}</span>`;
  if (_salesPage > 1) html += `<button class="btn" style="padding:3px 10px;font-size:12px;" onclick="_goSalesPage(${_salesPage-1})">← Prev</button>`;
  const start = Math.max(1, _salesPage - 2), end = Math.min(pages, _salesPage + 2);
  for (let p = start; p <= end; p++) {
    html += `<button class="btn" style="padding:3px 10px;font-size:12px;${p===_salesPage?'background:var(--gold);color:#000;border-color:var(--gold);font-weight:700;':''}" onclick="_goSalesPage(${p})">${p}</button>`;
  }
  if (_salesPage < pages) html += `<button class="btn" style="padding:3px 10px;font-size:12px;" onclick="_goSalesPage(${_salesPage+1})">Next →</button>`;
  container.innerHTML = html;
}

function _goSalesPage(p) {
  _salesPage = p;
  _renderSalesPage();
  _renderSalesPagination();
  // Smooth scroll to top of table
  const tbl = document.getElementById('sales-body');
  if (tbl) tbl.closest('.table-wrap')?.scrollTo({ top: 0, behavior: 'smooth' });
}


function renderInventoryData(rows){
