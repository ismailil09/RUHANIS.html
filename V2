  // ── Update FA filter UI state ──
  function _updateFaFilterUI(){
    var allBtn=document.getElementById('fa-alltime-btn');
    var yearSel=document.getElementById('fa-year-sel');
    var monthSel=document.getElementById('fa-month-sel');
    if(allBtn) allBtn.classList.toggle('active',_allTime);
    if(yearSel){ yearSel.disabled=_allTime; yearSel.style.opacity=_allTime?'0.4':'1'; }
    if(monthSel){ monthSel.disabled=_allTime; monthSel.style.opacity=_allTime?'0.4':'1'; }
