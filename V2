/**
 * GAS এ bookCourier action পাঠাও এবং tracking_code সহ full response ফিরে নাও।
 * postToAPI() শুধু true/false দেয়, তাই এখানে raw response পড়া হয়।
 */
async function _gasBookCourier(payload) {
  if (!API_URL || !API_URL.includes('script.google.com')) return null;
  // postToAPI-এর মতো same base64 encoding — GAS এর p.data path
  const jsonStr = JSON.stringify(payload);
  const encoded = encodeURIComponent(btoa(unescape(encodeURIComponent(jsonStr))));
  const url     = `${API_URL}?action=${encodeURIComponent(payload.action||'bookCourier')}&data=${encoded}`;
  try {
    const ctrl  = new AbortController();
    const timer = setTimeout(()=>ctrl.abort(), 30000); // 30s timeout
    const res   = await fetch(url, { method:'GET', redirect:'follow', signal:ctrl.signal });
    clearTimeout(timer);
    if (!res.ok) return null;
    const data = safeJSONParse(await res.text());
    if (!data) return null;
    if (data.status === 'success' && data.tracking_code) {
      return { tracking_code: data.tracking_code, status: data.order_status || 'Pending' };
    }
    if (data.message) showToast('⚠️ ' + data.message, 'error');
    return null;
  } catch(e) {
    if (e.name !== 'AbortError') showToast('❌ Courier API error: ' + e.message, 'error');
    return null;
  }
}

