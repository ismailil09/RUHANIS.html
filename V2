// AI SMART PASTE — WhatsApp/Facebook message → Order form
// ═══════════════════════════════════════════════════════════
function openSmartPaste(){
  const panel = document.getElementById('smart-paste-panel');
  if(panel) panel.style.display = 'block';
  setTimeout(()=>document.getElementById('smart-paste-input')?.focus(), 100);
}
function closeSmartPaste(){
  const panel = document.getElementById('smart-paste-panel');
  if(panel) panel.style.display = 'none';
}
function clearSmartPaste(){
  const inp = document.getElementById('smart-paste-input');
  if(inp) inp.value = '';
  const st = document.getElementById('smart-paste-status');
  if(st) st.textContent = '';
}

async function runSmartPaste(){
  const text = (document.getElementById('smart-paste-input')?.value||'').trim();
  if(!text){ showToast('কিছু পেস্ট করুন আগে','warning'); return; }

  const btn    = document.getElementById('smart-paste-btn');
  const status = document.getElementById('smart-paste-status');
  btn.disabled = true;
  btn.textContent = '⏳ AI বিশ্লেষণ করছে...';
  if(status) status.textContent = '';

  try {
    let res = null;

    // ── GS-এর মাধ্যমে parse (CORS নেই, BD_LOCATIONS সম্পূর্ণ) ──
    if(API_URL && API_URL.includes('script.google.com')){
      res = await fetchFromAPI('smartParse&text='+encodeURIComponent(text));
    }

    // ── GS নেই বা fail — local regex ──
    if(!res || res.status !== 'ok'){
      const fb = parseOrderRegex(text);
      if(status) status.innerHTML = `<span style="color:var(--gold);">⚡ Local: ${fb.filled}টি field</span>`;
      showToast(`⚡ ${fb.filled}টি field পূরণ হয়েছে`,'info');
      closeSmartPaste();
      return;
    }

    const p = res.data;
    const mode = res.mode || 'offline';
    let filled = 0;

    // ── Basic fields ──
    if(p.name)    { setField('order-customer', p.name);  filled++; }
    if(p.phone)   { setField('order-phone', String(p.phone).replace(/[^0-9]/g,'').slice(0,11)); filled++; }
    if(p.address) { setField('order-address', p.address); filled++; }
    if(p.note)    { const nEl=document.getElementById('order-notes'); if(nEl){ nEl.value=p.note; filled++; } }
    if(parseInt(p.qty)>1) { setField('order-qty', String(p.qty)); setTimeout(calcTotal,150); filled++; }
    if(parseFloat(p.price)>0) { setField('unit-price', String(p.price)); setTimeout(calcTotal,100); filled++; }
    if(parseFloat(p.paid)>0)  { setField('order-paid',  String(p.paid));  setTimeout(calcDue,200);  filled++; }

    // ── Delivery charge ──
    if(parseFloat(p.delivery)>0) {
      setField('order-delivery', String(p.delivery));
      setTimeout(calcDue, 300);
      filled++;
    }

    // ── Courier ──
    if(p.courier) {
      const courierSel = document.getElementById('order-courier');
      if(courierSel) {
        const cOpt = Array.from(courierSel.options).find(o=>
          o.text.toLowerCase().includes(p.courier.toLowerCase()) ||
          p.courier.toLowerCase().includes(o.text.toLowerCase())
        );
        if(cOpt) { courierSel.value = cOpt.value || cOpt.text; filled++; }
      }
    }

    // ── Payment method ──
    if(p.payment) {
      const paymentSel = document.getElementById('order-payment');
      if(paymentSel) {
        const pOpt = Array.from(paymentSel.options).find(o=>
          o.text.toLowerCase().includes(p.payment.toLowerCase()) ||
          p.payment.toLowerCase().includes(o.text.toLowerCase())
        );
        if(pOpt) { paymentSel.value = pOpt.value || pOpt.text; filled++; }
      }
    }

    // ── Product ── ✅ FIX (Multi-product order): প্রথম আইটেম-লাইনে বসাও
    if(p.product){
      const names = window._orderProductNames || [];
      const pMatch = names.find(name =>
        name.toLowerCase().includes(p.product.toLowerCase()) ||
        p.product.toLowerCase().includes(name.toLowerCase().replace('amanah ',''))
      );
      if(pMatch && Array.isArray(window._orderItems) && window._orderItems.length){
        window._orderItems[0].product = pMatch;
        onOrderProductChange(pMatch);
        _renderOrderItems();
        filled++;
      }
    }

    // ── Division → District → Thana (async cascade) ──
    if(p.division){
      const divSel = document.getElementById('order-division');
      if(divSel){
        const divOpt = Array.from(divSel.options).find(o=>
          o.text.toLowerCase().trim()===String(p.division).toLowerCase().trim()
        );
        if(divOpt){
          divSel.value = divOpt.value || divOpt.text;
          divSel.dispatchEvent(new Event('change', {bubbles:true})); // ✅ ensures any listener also fires
          updateDistricts(divSel);
          filled++;
          await new Promise(r=>setTimeout(r,400));

          if(p.district){
            const distSel = document.getElementById('district-select');
            if(distSel){
              const distOpt = Array.from(distSel.options).find(o=>
                o.text.toLowerCase().trim()===String(p.district).toLowerCase().trim()
              ) || Array.from(distSel.options).find(o=>
                o.text.toLowerCase().includes(String(p.district).toLowerCase()) || String(p.district).toLowerCase().includes(o.text.toLowerCase())
              );
              if(distOpt){
                distSel.value = distOpt.value || distOpt.text;
                distSel.dispatchEvent(new Event('change', {bubbles:true}));
                updateThanas(distSel);
                filled++;
                await new Promise(r=>setTimeout(r,400));

                if(p.thana){
                  const thanaSel = document.getElementById('thana-select');
                  if(thanaSel){
                    const thanaOpt = Array.from(thanaSel.options).find(o=>
                      o.text.toLowerCase().trim()===String(p.thana).toLowerCase().trim()
                    ) || Array.from(thanaSel.options).find(o=>
                      o.text.toLowerCase().includes(String(p.thana).toLowerCase())
                    );
                    if(thanaOpt){
                      thanaSel.value = thanaOpt.value || thanaOpt.text;
                      thanaSel.dispatchEvent(new Event('change', {bubbles:true}));
                      filled++;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    const modeLabel = mode==='ai' ? '🤖 AI' : '⚡ Smart';
    if(status) status.innerHTML = `<span style="color:var(--green);">✅ ${modeLabel}: ${filled}টি field পূরণ হয়েছে</span>`;
    showToast(`✅ ${filled}টি field পূরণ হয়েছে!`,'success');
    closeSmartPaste();

  } catch(err){
    console.error('SmartPaste:', err);
    const fb = parseOrderRegex(text);
    if(status) status.innerHTML = `<span style="color:var(--gold);">⚡ Local: ${fb.filled}টি field</span>`;
    showToast(`⚡ ${fb.filled}টি field পূরণ হয়েছে`,'info');
    closeSmartPaste();
  } finally {
    btn.disabled = false;
    btn.textContent = '✨ AI বিশ্লেষণ করো';
  }
}

function setField(id, val){
  const el = document.getElementById(id);
  if(el && val) el.value = val;
}

// Regex-based offline fallback (works without API)
function parseOrderRegex(text){
  let filled = 0;

  // Convert Bengali digits to English
  const toEn = s => s.replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d));
  const t = toEn(text);
  const tl = t.toLowerCase();

  // ── Name ──
  const nameMatch = t.match(/(?:নাম|name)[:\s]+([^\n,।]+)/i);
  if(nameMatch){ setField('order-customer', nameMatch[1].trim()); filled++; }
  else {
    const firstLine = text.split(/\n/).map(l=>l.trim()).find(l=>
      l.length>2 && !/\d{5,}/.test(l) &&
      !/ঠিকানা|অ্যাড|addr|note|দাম|price|ডেলি|deliv|courier|pay|cash|bkash|nagad|steadfast|pathao|fit tar|fit\b/i.test(l)
    );
    if(firstLine){ setField('order-customer', firstLine); filled++; }
  }

  // ── Phone (01XXXXXXXXX) ──
  const phoneMatch = t.match(/01[3-9]\d{8}/);
  if(phoneMatch){ setField('order-phone', phoneMatch[0]); filled++; }

  // ── Price (product price, not delivery) ──
  const priceMatch =
    t.match(/(?:দাম|price|মূল্য|unit)[:\s৳]*(\d[\d,]+)/i) ||
    t.match(/(\d{3,6})\s*(?:টাকা|taka|tk|৳)\s*(?:প্রতি|each|unit|পিস)/i) ||
    t.match(/(?:^|\n)\s*(\d{3,6})\s*(?:$|\n)/m);
  if(priceMatch){
    const p = priceMatch[1].replace(/,/g,'');
    if(parseInt(p)>0){ setField('unit-price', p); setTimeout(calcTotal,100); filled++; }
  }

  // ── Paid amount (actual advance only — NOT "FIT TAR LAGBO") ──
  const paidMatch =
    t.match(/(?:paid|পেমেন্ট|পরিশোধ|অগ্রিম|advance|বায়না|deposit)[:\s৳]*(\d+)/i);
  if(paidMatch){
    const pv = parseInt(paidMatch[1])||0;
    if(pv>0){ setField('order-paid', String(pv)); setTimeout(calcDue,200); filled++; }
  }

  // ── Delivery charge ──
  const deliveryMatch =
    t.match(/(?:ডেলিভারি|delivery|deliv)[^\d]*(\d+)/i) ||
    t.match(/(?:courier charge|কুরিয়ার চার্জ)[:\s]*(\d+)/i) ||
    t.match(/(?:charge)[:\s]*(\d+)/i);
  if(deliveryMatch){
    const dv = parseInt(deliveryMatch[1])||0;
    if(dv>0){ setField('order-delivery', String(dv)); setTimeout(calcDue,300); filled++; }
  }

  // ── Courier ──
  const courierSel = document.getElementById('order-courier');
  if(courierSel){
    let courier = '';
    if(/steadfast|স্টেডফাস্ট/.test(tl)) courier='Steadfast';
    else if(/pathao|পাঠাও/.test(tl)) courier='Pathao';
    else if(/redx|রেডএক্স/.test(tl)) courier='RedX';
    else if(/sundarban|সুন্দরবন/.test(tl)) courier='Sundarban';
    else if(/ecourier/.test(tl)) courier='eCourier';
    if(courier){
      const cOpt = Array.from(courierSel.options).find(o=>o.text.toLowerCase().includes(courier.toLowerCase()));
      if(cOpt){ courierSel.value=cOpt.value||cOpt.text; filled++; }
    }
  }

  // ── Payment method ──
  const paymentSel = document.getElementById('order-payment');
  if(paymentSel){
    let payment = '';
    if(/bkash|বিকাশ/.test(tl)) payment='Bkash';
    else if(/nagad|নগদ/.test(tl)) payment='Nagad';
    else if(/rocket|রকেট/.test(tl)) payment='Rocket';
    else if(/\bcod\b|ক্যাশ অন/.test(tl)) payment='COD';
    else if(/bank|transfer|ট্রান্সফার/.test(tl)) payment='Bank Transfer';
    if(payment){
      const pOpt = Array.from(paymentSel.options).find(o=>o.text.toLowerCase().includes(payment.toLowerCase()));
      if(pOpt){ paymentSel.value=pOpt.value||pOpt.text; filled++; }
    }
  }

  // ── Location: Bengali aliases + district + thana cascade ──
  // Bengali word → English name as stored in BD_LOCATIONS (loaded from GAS)
  const BN_ALIAS = {
    // Thanas
    'কালিহাতী':'Kalihati','কালিহাতি':'Kalihati',
    'ঘাটাইল':'Ghatail','মধুপুর':'Madhupur','মির্জাপুর':'Mirzapur',
    'ভূয়াপুর':'Bhuapur','গোপালপুর':'Gopalpur','সখিপুর':'Sakhipur',
    'বাসাইল':'Basail','দেলদুয়ার':'Delduar','নাগরপুর':'Nagarpur','ধনবাড়ী':'Dhanbari',
    'কালিয়াকৈর':'Kaliakair','কাপাসিয়া':'Kapasia','শ্রীপুর':'Sreepur',
    'গাজীপুর সদর':'Gazipur Sadar','কালীগঞ্জ':'Kaliganj',
    'নরসিংদী সদর':'Narsingdi Sadar','পলাশ':'Palash','শিবপুর':'Shibpur',
    'বেলকুচি':'Belkuchi','শাহজাদপুর':'Shahjadpur','উল্লাপাড়া':'Ullahpara',
    'ঈশ্বরদী':'Ishwardi','সাঁথিয়া':'Santhia',
    'টঙ্গীবাড়ী':'Tongibari','মুন্সিগঞ্জ সদর':'Munshiganj Sadar',
    'ভালুকা':'Bhaluka','ত্রিশাল':'Trishal','মুক্তাগাছা':'Muktagacha',
    'ফুলবাড়িয়া':'Fulbaria','গফরগাঁও':'Gaffargaon','ফুলপুর':'Phulpur',
    'সরিষাবাড়ী':'Sarishabari','দেওয়ানগঞ্জ':'Dewanganj','ইসলামপুর':'Islampur',
    'বকশিগঞ্জ':'Bakshiganj','মেলান্দহ':'Melandaha','মাদারগঞ্জ':'Madarganj',
    'কলমাকান্দা':'Kalmakanda','কেন্দুয়া':'Kendua','আটপাড়া':'Atpara',
    'বারহাট্টা':'Barhatta','দুর্গাপুর':'Durgapur','পূর্বধলা':'Purbadhala',
    'মোহনগঞ্জ':'Mohanganj','খালিয়াজুরী':'Khaliajuri','মদন':'Madan',
    // Districts
    'টাঙ্গাইল':'Tangail','গাজীপুর':'Gazipur','নারায়ণগঞ্জ':'Narayanganj',
    'নরসিংদী':'Narsingdi','মানিকগঞ্জ':'Manikganj','মুন্সিগঞ্জ':'Munshiganj',
    'কিশোরগঞ্জ':'Kishoreganj','ফরিদপুর':'Faridpur','মাদারীপুর':'Madaripur',
    'গোপালগঞ্জ':'Gopalganj','শরীয়তপুর':'Shariatpur','রাজবাড়ী':'Rajbari',
    'সিরাজগঞ্জ':'Sirajganj','পাবনা':'Pabna','বগুড়া':'Bogra','নাটোর':'Natore',
    'জয়পুরহাট':'Joypurhat','নওগাঁ':'Naogaon','চাঁপাইনবাবগঞ্জ':'Chapai Nawabganj',
    'কুমিল্লা':'Comilla','নোয়াখালী':'Noakhali','ফেনী':'Feni',
    'লক্ষ্মীপুর':'Lakshmipur','চাঁদপুর':'Chandpur','ব্রাহ্মণবাড়িয়া':'Brahmanbaria',
    'রাঙামাটি':'Rangamati','খাগড়াছড়ি':'Khagrachhari','বান্দরবান':'Bandarban',
    'কক্সবাজার':"Cox's Bazar",
    'যশোর':'Jessore','সাতক্ষীরা':'Satkhira','নড়াইল':'Narail',
    'চুয়াডাঙ্গা':'Chuadanga','মেহেরপুর':'Meherpur','মাগুরা':'Magura',
    'ঝিনাইদহ':'Jhenaidah','কুষ্টিয়া':'Kushtia','বাগেরহাট':'Bagerhat',
    'ময়মনসিংহ':'Mymensingh','জামালপুর':'Jamalpur','নেত্রকোণা':'Netrokona','শেরপুর':'Sherpur',
    'সিলেট':'Sylhet','সুনামগঞ্জ':'Sunamganj','হবিগঞ্জ':'Habiganj','মৌলভীবাজার':'Moulvibazar',
    'রংপুর':'Rangpur','দিনাজপুর':'Dinajpur','কুড়িগ্রাম':'Kurigram',
    'গাইবান্ধা':'Gaibandha','লালমনিরহাট':'Lalmonirhat','নীলফামারী':'Nilphamari',
    'পঞ্চগড়':'Panchagarh','ঠাকুরগাঁও':'Thakurgaon',
    'বরিশাল':'Barisal','ভোলা':'Bhola','পটুয়াখালী':'Patuakhali',
    'বরগুনা':'Barguna','পিরোজপুর':'Pirojpur','ঝালকাঠি':'Jhalokati',
    // Divisions (already covered above for Sylhet/Rangpur/Barisal/Mymensingh — new BD_LOCATIONS
    // uses the SAME name for division and its headquarters district, so no duplicate keys needed)
    'ঢাকা':'Dhaka','চট্টগ্রাম':'Chittagong','রাজশাহী':'Rajshahi','খুলনা':'Khulna',
  };

  // Try to get BD_LOCATIONS from window (loaded from GAS)
  const BD = (typeof BD_LOCATIONS !== 'undefined' && Object.keys(BD_LOCATIONS).length > 0) ? BD_LOCATIONS : null;
  let foundLoc = false;

  // Helper: set division→district→thana dropdowns
  const setLocation = (divName, distName, thanaName) => {
    const divSel = document.getElementById('order-division');
    if(!divSel) return;
    // Set division
    let divOpt = Array.from(divSel.options).find(o=>
      o.text===divName || o.value===divName ||
      o.text.toLowerCase()===divName.toLowerCase()
    );
    if(divOpt){
      divSel.value = divOpt.value || divOpt.text;
      if(typeof updateDistricts==='function') updateDistricts(divSel);
      filled++;
      // Set district after short delay for cascade
      setTimeout(()=>{
        if(distName){
          const distSel = document.getElementById('order-district');
          if(distSel){
            const distOpt = Array.from(distSel.options).find(o=>
              o.text===distName||o.text.toLowerCase()===distName.toLowerCase()
            );
            if(distOpt){
              distSel.value = distOpt.value||distOpt.text;
              if(typeof updateThanas==='function') updateThanas(distSel);
              filled++;
              // Set thana after another delay
              if(thanaName) setTimeout(()=>{
                const thanaSel = document.getElementById('order-thana');
                if(thanaSel){
                  const thanaOpt = Array.from(thanaSel.options).find(o=>
                    o.text===thanaName||o.text.toLowerCase()===thanaName.toLowerCase()
                  );
                  if(thanaOpt){ thanaSel.value=thanaOpt.value||thanaOpt.text; filled++; }
                }
              },300);
            }
          }
        }
      },200);
    }
    foundLoc = true;
  };

  // Step 1: scan Bengali aliases
  for(const [bn, en] of Object.entries(BN_ALIAS)){
    if(text.includes(bn)){
      if(BD){
        // Find en in BD_LOCATIONS as division, district, or thana
        for(const [div, districts] of Object.entries(BD)){
          if(div===en){ setLocation(div,'',''); break; }
          for(const [dist, thanas] of Object.entries(districts)){
            if(dist===en){ setLocation(div,dist,''); break; }
            const thanaMatch = thanas.find(th=>th===en);
            if(thanaMatch){ setLocation(div,dist,thanaMatch); break; }
          }
          if(foundLoc) break;
        }
      } else {
        // No BD cache — just set division by known mapping
        const divisionOf = {
          'Tangail':'Dhaka','Gazipur':'Dhaka','Narayanganj':'Dhaka','Narsingdi':'Dhaka',
          'Manikganj':'Dhaka','Munshiganj':'Dhaka','Kishoreganj':'Dhaka','Faridpur':'Dhaka',
          'Sirajganj':'Rajshahi','Pabna':'Rajshahi','Bogra':'Rajshahi','Natore':'Rajshahi',
          'Comilla':'Chittagong','Noakhali':'Chittagong','Feni':'Chittagong',
          'Brahmanbaria':'Chittagong','Chandpur':'Chittagong','Lakshmipur':'Chittagong',
          "Cox's Bazar":'Chittagong',
          'Netrokona':'Mymensingh','Jamalpur':'Mymensingh','Sherpur':'Mymensingh',
          'Sunamganj':'Sylhet','Habiganj':'Sylhet','Moulvibazar':'Sylhet',
          'Dinajpur':'Rangpur','Kurigram':'Rangpur','Gaibandha':'Rangpur',
          'Bhola':'Barisal','Patuakhali':'Barisal',
          'Jessore':'Khulna','Satkhira':'Khulna','Kushtia':'Khulna',
        };
        const divName = divisionOf[en] || (
          ['Dhaka','Chittagong','Rajshahi','Khulna','Sylhet','Barisal','Rangpur','Mymensingh'].includes(en) ? en : ''
        );
        if(divName) setLocation(divName, '', '');
      }
      if(foundLoc) break;
    }
  }

  // Step 2: English thana/district scan (if BD cache available)
  if(!foundLoc && BD){
    for(const [div, districts] of Object.entries(BD)){
      for(const [dist, thanas] of Object.entries(districts)){
        if(text.includes(dist) || tl.includes(dist.toLowerCase())){
          const thana = thanas.find(th=>text.includes(th)) || '';
          setLocation(div, dist, thana);
          break;
        }
        const thana = thanas.find(th=>text.includes(th));
        if(thana){ setLocation(div, dist, thana); break; }
      }
      if(foundLoc) break;
    }
  }

  // ── Address — label, গ্রাম/বাজার/পাড়া/রোড keyword lines, or all non-system lines joined ──
  {
    const addrLabeled = text.match(/(?:ঠিকানা|অ্যাড্রেস|address|addr)[:\s]+([^\n]+)/i);
    if(addrLabeled){
      setField('order-address', addrLabeled[1].trim()); filled++;
    } else {
      // Collect lines that look like address parts:
      // গ্রাম/বাজার/পাড়া/রোড/মোড়/ওয়ার্ড/ব্লক/সেক্টর/উপজেলা/থানা or known location words
      const locationKeywords = /গ্রাম|বাজার|পাড়া|মহল্লা|রোড|মোড়|ওয়ার্ড|ব্লক|সেক্টর|উপজেলা|থানা|নগর|সিটি|এলাকা|হাট|চর|কান্দি|village|road|bazar|para|sector|block|union|ward|dist|thana|upazila/i;
      const skipLine = /01[3-9]\d{8}|\d{4,6}\s*(taka|tk|৳|টাকা)|^(steadfast|pathao|redx|sundarban|ecourier|bkash|nagad|rocket|cod|cash)$|fit tar lagbo|delivery|charge|পিস|piece|qty|quantity|পরিশোধ|advance|paid/i;
      const lines = text.split(/\n/).map(l=>l.trim()).filter(l=>l.length>2);
      const addrParts = [];
      for(const line of lines){
        if(skipLine.test(line)) continue;
        if(/^[A-Z\s]{3,}$/.test(line) && lines.indexOf(line)===0) continue; // skip name (all caps first line)
        if(/^01[3-9]\d{8}$/.test(line)) continue; // phone
        if(locationKeywords.test(line)){
          addrParts.push(line);
        }
      }
      // Also grab lines containing comma-separated location parts (like "Tangail, Dhaka")
      const commaLocLine = text.split(/\n/).find(l=>/,/.test(l) && !/\d{5,}/.test(l) && !/steadfast|pathao|delivery|charge|paid|fit tar/i.test(l) && l.trim().split(',').length>=2);
      if(commaLocLine && !addrParts.includes(commaLocLine.trim())) addrParts.push(commaLocLine.trim());

      if(addrParts.length>0){
        setField('order-address', addrParts.join(', ')); filled++;
      }
    }
  }

  // ── Quantity — "২ পিস", "2 piece", "দুইটা", "3টা" ──
  {
    const wordNum = {'এক':1,'দুই':2,'তিন':3,'চার':4,'পাঁচ':5,'ছয়':6,'সাত':7,'আট':8,'নয়':9,'দশ':10,'one':1,'two':2,'three':3,'four':4,'five':5};
    const qtyMatch =
      t.match(/(\d+)\s*(?:পিস|piece|পিছ|টি|টা|পিক্স|pcs|nos)/i) ||
      t.match(/(?:qty|quantity|পরিমাণ)[:\s]*(\d+)/i);
    if(qtyMatch){
      const qv = parseInt(qtyMatch[1]);
      if(qv>1){ setField('order-qty', String(qv)); filled++; }
    } else {
      // Word-form: "দুই পিস", "তিনটা"
      for(const [word, num] of Object.entries(wordNum)){
        if(num>1 && new RegExp(word+'\\s*(?:পিস|পিক্স|টি|টা|piece|pcs)','i').test(text)){
          setField('order-qty', String(num)); filled++; break;
        }
      }
    }
  }

  // ── Product match ── ✅ FIX (Multi-product order): প্রথম আইটেম-লাইনে বসাও
  {
    const names = window._orderProductNames || [];
    const matched = names.find(name=>{
      const nl = name.toLowerCase();
      const words = nl.split(' ');
      return words.some(w=>w.length>3 && tl.includes(w)) ||
             (tl.includes('cctv') && nl.includes('cctv')) ||
             (tl.includes('door lock') && nl.includes('door')) ||
             (tl.includes('alarm') && nl.includes('alarm')) ||
             tl.includes('সিকিউরিটি') || tl.includes('security');
    });
    if(matched && Array.isArray(window._orderItems) && window._orderItems.length){
      window._orderItems[0].product = matched;
      onOrderProductChange(matched);
      _renderOrderItems();
      filled++;
    }
  }

  // ── Smart Notes — collect special instructions AI should write down ──
  {
    const noteEl = document.getElementById('order-notes');
    const noteParts = [];

    // Explicit note label
    const noteLabeled = text.match(/(?:note|নোট|বিশেষ নির্দেশ|মন্তব্য)[:\s]+([^\n]+)/i);
    if(noteLabeled) noteParts.push(noteLabeled[1].trim());

    // "X FIT TAR LAGBO" / "X ফুট/মিটার তার" → wire instruction
    const wireFit = text.match(/(\d+)\s*(?:FIT TAR LAGBO|ফিট তার লাগবো?|fit tar lagbo)/i);
    if(wireFit) noteParts.push(`তার: ${wireFit[1]} ফিট লাগবে`);

    const wireLen = t.match(/(\d+)\s*(?:ফুট|futt?|feet?|মিটার|meter|metre)\s*(?:তার|wire|cable)/i) ||
                    t.match(/(?:তার|wire|cable)\s*(\d+)\s*(?:ফুট|futt?|feet?|মিটার|meter)/i);
    if(wireLen && !wireFit) noteParts.push(`তার: ${wireLen[1]} ${wireLen[0].match(/মিটার|meter/i)?'মিটার':'ফুট'}`);

    // Multiple doors/rooms — "২টা দরজা", "3 room", "দুই দরজা"
    const doorMatch = text.match(/(\d+|এক|দুই|তিন|চার|পাঁচ)\s*(?:টা|টি)?\s*(?:দরজা|door)/i);
    if(doorMatch) noteParts.push(`দরজা: ${doorMatch[1]}টি`);

    const roomMatch = text.match(/(\d+|এক|দুই|তিন|চার|পাঁচ)\s*(?:টা|টি)?\s*(?:রুম|room|কক্ষ)/i);
    if(roomMatch) noteParts.push(`রুম: ${roomMatch[1]}টি`);

    // Color preference
    const colorMatch = text.match(/(?:রং|color|colour)[:\s]*([^\n,।]+)/i);
    if(colorMatch) noteParts.push(`রং: ${colorMatch[1].trim()}`);

    // Installation request
    if(/ইন্সটল|install|লাগিয়ে|সেটআপ|setup/i.test(text)) noteParts.push('ইন্সটলেশন সহ দিতে হবে');

    // Urgent/fast delivery
    if(/জরুরি|urgent|asap|দ্রুত|তাড়াতাড়ি/i.test(text)) noteParts.push('জরুরি ডেলিভারি');

    if(noteParts.length>0 && noteEl){
      noteEl.value = noteParts.join(' | ');
      filled++;
    }
  }

  return { filled };
}

