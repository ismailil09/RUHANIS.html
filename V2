(function _hookSubmitOrder() {
  const _original = window.submitOrder;
  if (typeof _original !== "function") return;

  window.submitOrder = async function () {
    // ── অর্ডার সাবমিটের আগেই payload ধরে রাখো
    const m = document.getElementById("modal-add-order");
    if (!m) { await _original(); return; }

    // ── সব field আগেই পড়ে রাখো
    // ✅ FIX (Multi-product order, Sept 2026): একাধিক প্রোডাক্ট-লাইনের সমষ্টি ব্যবহার করো
    const _items    = (Array.isArray(window._orderItems) ? window._orderItems.filter(it=>it.product) : []);
    const _qty      = _items.length ? _items.reduce((s,it)=>s+(Number(it.qty)||0),0) : (parseFloat(m.querySelector("#order-qty")?.value || "1") || 1);
    const _price    = parseFloat(document.getElementById("unit-price")?.value || "0") || 0;
    const _delivery = parseFloat(m.querySelector("#order-delivery")?.value || "0") || 0;
    const _codPct   = parseFloat(document.getElementById("order-cod-pct")?.value || "0") || 0;
    const _total    = _items.length ? _items.reduce((s,it)=>s+((Number(it.qty)||0)*(Number(it.price)||0)),0) : (_qty * _price);
    // ✅ BUG #2 FIX: COD % applies to customerPayable (product total + delivery)
    // COD fee is OUR expense — deducted from our net, NOT from what customer pays.
    const _customerPayable = _total + _delivery;
    const _codAmt   = Math.round(_customerPayable * _codPct / 100);
    // _netPay = what we receive after courier deducts COD fee
    const _netPay   = Math.max(0, _customerPayable - _codAmt);

    const orderSnapshot = {
      orderId:     `#${String(Date.now()).slice(-6)}`,  // temp; overridden below after sheet save
      customer:    m.querySelector("#order-customer")?.value || "",
      phone:       m.querySelector("#order-phone")?.value || "",
      division:    m.querySelector("#order-division")?.value || "",
      district:    document.getElementById("district-select")?.value || "",
      thana:       document.getElementById("thana-select")?.value || "",
      address:     m.querySelector("#order-address")?.value || "",
      // ✅ FIX (Multi-product order, Sept 2026): একাধিক প্রোডাক্ট থাকলে সবগুলো নাম একসাথে দেখাও
      product:     (Array.isArray(window._orderItems) && window._orderItems.length
                      ? window._orderItems.filter(it=>it.product).map(it=>`${it.product} x${it.qty}`).join(', ')
                      : (m.querySelector("#order-product")?.value || "")),
      qty:         _qty,
      price:       _price,
      total:       _total,
      delivery:    _delivery,
      paid:        parseFloat(document.getElementById("order-paid")?.value || "0") || 0,
      codPct:      _codPct,
      codCharge:   _codAmt,
      netPayable:  _netPay,
      notes:       m.querySelector("#order-notes")?.value || "",
      courier:     m.querySelector("#order-courier")?.value || "",
      status:      m.querySelector("#order-status")?.value || "Pending",
    };

    // ── মূল OS submitOrder চালাও (Google Sheet save)
    await _original();

    // ✅ BUG 1 FIX: After save, replace temp orderId with the real SL# from Google Sheet.
    // _original() (submitOrder) stores ok.row in window._lastAddedOrderId.
    // updateTracking GAS looks up Col A (SL#) with this ID.
    if (window._lastAddedOrderId) {
      orderSnapshot.orderId = String(window._lastAddedOrderId);
      window._lastAddedOrderId = null; // clear after use
    }

    // ✅ Feature 5 (v40): Auto-booking DISABLED — courier আলাদাভাবে বুক হবে।
    // Order save হওয়ার পর Courier Manager-এ গিয়ে "🚀 Book Courier" বাটনে ক্লিক করুন।
    // if (orderSnapshot.courier) {
    //   setTimeout(() => dispatchCourierBooking(orderSnapshot), 800);
    // }
    if (orderSnapshot.courier) {
      showToast('✅ অর্ডার সেভ হয়েছে। Courier Manager থেকে "🚀 Book Courier" ক্লিক করে বুক করুন।', 'info');
    }
  };
})();


/* ───────────────────────────────────────────────────────────────────
   SECTION 5 — BULK TRACKING REFRESH
   কুরিয়ার ম্যানেজার পেজের Sync বাটন চাপলে
   Steadfast ও Pathao-এর সব pending অর্ডারের স্ট্যাটাস live update হবে।
─────────────────────────────────────────────────────────────────── */

async function liveRefreshAllTracking() {
  const _liveArr = (typeof liveSalesData !== "undefined" && liveSalesData.length) ? liveSalesData : [];
  if (!_liveArr.length) return;

  const pending = _liveArr.filter(o => {
    const s = o.status || "";
    return s !== "Delivered" && s !== "Cancelled" && s !== "Returned";
  });

  if (!pending.length) {
    showToast("✅ সব অর্ডার ইতিমধ্যে চূড়ান্ত অবস্থায় আছে", "info");
    return;
  }

  showToast(`⏳ ${pending.length}টি অর্ডারের লাইভ স্ট্যাটাস চেক হচ্ছে...`, "info");

  let updated = 0;
  for (const o of pending) {
    const courier  = o.courier || o.Courier || "";
    const tracking = o.tracking || o.Tracking || "";
    if (!tracking || tracking === "—") continue;

    let info = null;
    if (courier === "Steadfast") {
      // ✅ v40 FIX: Steadfast status API আসল tracking_code চায় — orderId নয়
      info = await trackWithSteadfast(tracking);
      if (info) {
        const newStatus = _mapCourierStatus(info.delivery_status, "Steadfast");
        _updateOSTracking(o.orderId, info.tracking_code || tracking, newStatus, "Steadfast", false, info.consignment_id || "", info.live_cod_charge || 0);
        updated++;
      }
    } else if (courier === "Pathao") {
      info = await trackWithPathao(tracking);
      if (info) {
        const newStatus = _mapCourierStatus(info.order_status, "Pathao");
        _updateOSTracking(o.orderId, info.consignment_id || tracking, newStatus, "Pathao", false, info.consignment_id || "", info.live_cod_charge || 0);
        updated++;
      }
    }
