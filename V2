      .createTextOutput(JSON.stringify({ status: <span class="st">'success'</span> }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

<span class="cm">// Auto Timestamp on Edit</span>
<span class="kw">function</span> <span class="fn">onEdit</span>(e) {
