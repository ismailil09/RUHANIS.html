/**
 * কুরিয়ারের সার্ভার থেকে আসা tracking_code ও status
 * OS-এর কুরিয়ার ম্যানেজার টেবিলে এবং Google Sheet-এ আপডেট করো।
 */
function _updateOSTracking(orderId, trackingCode, liveStatus, courierName, skipSheetWrite, consignmentId, liveCodCharge) {
  // ── ১. salesData array আপডেট (in-memory)
  const _sArr = (typeof liveSalesData !== "undefined" && liveSalesData.length) ? liveSalesData
               : (typeof salesData !== "undefined" ? salesData : []);
  if (_sArr.length) {
    const idx = _sArr.findIndex(
      o => String(o.id || o.orderId || o.OrderID || "") === String(orderId)
    );
    if (idx > -1) {
      _sArr[idx].tracking  = trackingCode;
      _sArr[idx].delStatus = "Sent";
      _sArr[idx].status    = _mapCourierStatus(liveStatus, courierName);
      // Consignment ID — Notes-এ [CID:XXX] tag update
      if (consignmentId) {
        const cidTag = `[CID:${consignmentId}]`;
        const oldNotes = String(_sArr[idx].notes || '');
        if (!oldNotes.includes(cidTag)) {
          _sArr[idx].notes = (oldNotes.replace(/\[CID:[^\]]+\]/g,'').trim() + ' ' + cidTag).trim();
        }
      }
    }
  }

  // ── ২. কুরিয়ার ম্যানেজার টেবিল live রিফ্রেশ (পেজ খোলা থাকলে)
  if (document.getElementById("page-courier-hub")?.classList.contains("active")) {
    renderCourierHub();
  }

  // ── ৩. Google Sheet-এ tracking update পাঠাও (যদি আগে থেকেই সেভ না হয়ে থাকে)
  if (skipSheetWrite) return;
  postToAPI({
    action:      "updateTracking",
    orderId:     String(orderId),
    tracking:    trackingCode,
    status:      _mapCourierStatus(liveStatus, courierName),
    courier:     courierName,
    // ✅ v40 FIX (সমস্যা ১): courier API থেকে সরাসরি live COD amount পাওয়া গেলে
    // সেটাও পাঠাও, যাতে GAS ব্যাকএন্ড সবচেয়ে accurate মান সেভ করতে পারে।
    codCharge:   liveCodCharge || 0,
  }).catch(() => {}); // silent — main order already saved
}

/**
 * কুরিয়ার কোম্পানির নিজস্ব status শব্দকে RUHANIS OS-এর
 * স্ট্যান্ডার্ড status-এ convert করো।
 */
function _mapCourierStatus(rawStatus, courierName) {
  const sf = {
    "In Review":   "Processing",
    "Pending":     "Pending",
    "Delivered_By_Courier": "Delivered",
    "Partial_Delivered": "Delivered",
    "Cancelled":   "Cancelled",
    "Hold":        "Processing",
    "In Transit":  "In Transit",
    "Returned":    "Returned",
  };
  const pa = {
    "Pending":   "Pending",
    "Pickup_Requested": "Processing",
    "Picked_Up": "In Transit",
    "In_Transit": "In Transit",
    "Delivered": "Delivered",
    "Return_Requested": "Returned",
    "Returned":  "Returned",
    "Cancelled": "Cancelled",
  };
  const map = courierName === "Steadfast" ? sf : pa;
  return map[rawStatus] || rawStatus || "Processing";
}


/* ───────────────────────────────────────────────────────────────────
   SECTION 4 — submitOrder() HOOK
   বিদ্যমান submitOrder ফাংশনটিকে wrap করে
   dispatchCourierBooking() কে স্বয়ংক্রিয়ভাবে call করা হচ্ছে।
