    : `<div style="text-align:center;color:var(--text3);padding:30px;">এই ক্যাটাগরিতে এখনো কোনো খরচ নেই</div>`}`;
  const fb = document.getElementById('exp-catd-filter'); fb.textContent = filt ? '✕ ফিল্টার সরান' : '🔎 এই ক্যাটাগরিতে ফিল্টার করুন'; fb.onclick = ()=>expCatFilter(filt?'':c.key);
  openModal('exp-catd');
}
