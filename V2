// ═══════════════════════════════════════════════════════════════════
// TOP REGION MODAL — 3-LEVEL DRILL-DOWN (Division → District → Thana)
// Functions:  openTopRegionModal()  rgnBuildData()
//             rgnRenderList()       rgnRenderChart()
//             rgnRenderDivisionView()
//             rgnRenderDistrictView(divName)
//             rgnRenderThanaView(divName, distName)
//             rgnDrillToDist(distName)
//             rgnDrillToThana(thanaName)  [leaf — no further drill]
//             rgnDrillUp()               [one level at a time]
//             rgnGoToLevel(n)            [breadcrumb jump: 0=div,1=dist]
//
// Data flow: reads liveSalesData exclusively (live mode only)
// Field mapping:
//   r.div   → Division string  (e.g. "Dhaka")
//   r.dist  → District string  (e.g. "Gazipur")
//   r.thana → Thana string     (e.g. "Gazipur Sadar")
// Fallback: "Not Specified" for any blank/missing value
// ═══════════════════════════════════════════════════════════════════

// ─── Module state ────────────────────────────────────────────────
const _rgn = {
  // Navigation stack — tracks where we are in the 3 levels
  currentDiv:  null,   // null  = Division view (Level 1)
  currentDist: null,   // null  = not yet in District drill (Level 2)
                       // string = drilling into that district's thanas (Level 3)

  // Hierarchical data store built from sales rows:
  // divData[div] = {
  //   orders: N, revenue: N,
  //   districts: {
  //     [dist]: {
  //       orders: N, revenue: N,
  //       thanas: { [thana]: { orders: N, revenue: N } }
  //     }
  //   }
  // }
  divData: {},

  PALETTE: [
    'var(--blue)', 'var(--green)', 'var(--gold)',   'var(--purple)',
    'var(--red)',  'var(--orange)','#39D353',        '#58A6FF',
    '#F0883E',     '#A371F7',      '#79C0FF',        '#56D364'
  ]
};

// ─── Data builder ────────────────────────────────────────────────
function rgnBuildData() {
  const rows = (apiConnected && liveSalesData && liveSalesData.length > 0)
    ? liveSalesData : [];


  const result = {};

  rows.forEach(r => {
    // Graceful fallback — never let a missing field throw
    const div   = String(r.div   || r[5]  || '').trim() || 'Not Specified';
    const dist  = String(r.dist  || r[6]  || '').trim() || 'Not Specified';
    const thana = String(r.thana || r[7]  || '').trim() || 'Not Specified';
    const total = Number(r.total) || 0;

    // Division level
    if (!result[div]) result[div] = { orders: 0, revenue: 0, districts: {} };
    result[div].orders++;
    result[div].revenue += total;

    // District level
    if (!result[div].districts[dist])
      result[div].districts[dist] = { orders: 0, revenue: 0, thanas: {} };
    result[div].districts[dist].orders++;
    result[div].districts[dist].revenue += total;

    // Thana level
    if (!result[div].districts[dist].thanas[thana])
      result[div].districts[dist].thanas[thana] = { orders: 0, revenue: 0 };
    result[div].districts[dist].thanas[thana].orders++;
    result[div].districts[dist].thanas[thana].revenue += total;
  });

  _rgn.divData = result;
  return result;
}

// ─── Open modal entry point ──────────────────────────────────────
function openTopRegionModal() {
  _rgn.currentDiv  = null;
  _rgn.currentDist = null;
  rgnBuildData();
  document.getElementById('modal-top-region').classList.add('open');
  rgnRenderDivisionView();
}

// ─── Level 1 — Division view ─────────────────────────────────────
function rgnRenderDivisionView() {
  _rgn.currentDiv  = null;
  _rgn.currentDist = null;

  const sorted = Object.entries(_rgn.divData)
    .map(([name, d]) => ({ name, orders: d.orders, revenue: d.revenue }))
    .sort((a, b) => b.orders - a.orders);

  const maxOrders   = sorted.length ? sorted[0].orders : 1;
  const totalOrders = sorted.reduce((s, d) => s + d.orders, 0);

  // Modal chrome
  _rgnSetChrome({
    title:    'Sales by Division',
    sub:      'Click any bar or row to see districts',
    heading:  'Division Rankings',
    backText: null,             // hide back button
    footerNote: totalOrders + ' total orders across ' + sorted.length + ' division(s)',
    breadcrumb: null            // hide breadcrumb entirely
  });

  rgnRenderList(sorted,  maxOrders, 'division');
  rgnRenderChart(sorted, maxOrders, 'division');
}

// ─── Level 2 — District view ─────────────────────────────────────
function rgnRenderDistrictView(divName) {
  _rgn.currentDiv  = divName;
  _rgn.currentDist = null;

  const divEntry = _rgn.divData[divName];
  if (!divEntry) { rgnRenderDivisionView(); return; }

  const sorted = Object.entries(divEntry.districts)
    .map(([name, d]) => ({ name, orders: d.orders, revenue: d.revenue }))
    .sort((a, b) => b.orders - a.orders);

  const maxOrders = sorted.length ? sorted[0].orders : 1;

  _rgnSetChrome({
    title:    divName + ' — Districts',
    sub:      sorted.length + ' district(s) · Click to see thanas',
    heading:  'District Rankings',
    backText: '← All Divisions',
    footerNote: divEntry.orders + ' orders · ৳' + Number(divEntry.revenue).toLocaleString('en-BD') + ' revenue',
    breadcrumb: { div: divName, dist: null, thana: null }
  });

  rgnRenderList(sorted,  maxOrders, 'district');
  rgnRenderChart(sorted, maxOrders, 'district');
}

// ─── Level 3 — Thana view (leaf) ────────────────────────────────
function rgnRenderThanaView(divName, distName) {
  _rgn.currentDiv  = divName;
  _rgn.currentDist = distName;

  const distEntry = (_rgn.divData[divName] || {}).districts?.[distName];
  if (!distEntry) { rgnRenderDistrictView(divName); return; }

  const sorted = Object.entries(distEntry.thanas)
    .map(([name, d]) => ({ name, orders: d.orders, revenue: d.revenue }))
    .sort((a, b) => b.orders - a.orders);

  const maxOrders = sorted.length ? sorted[0].orders : 1;

  _rgnSetChrome({
    title:    distName + ' — Thanas',
    sub:      sorted.length + ' thana(s) with orders',
    heading:  'Thana Rankings',
    backText: '← ' + divName + ' Districts',
    footerNote: distEntry.orders + ' orders · ৳' + Number(distEntry.revenue).toLocaleString('en-BD') + ' in ' + distName,
    breadcrumb: { div: divName, dist: distName, thana: null }
  });

  // Thana is the leaf — bars and list rows are NOT clickable further
  rgnRenderList(sorted,  maxOrders, 'thana');
  rgnRenderChart(sorted, maxOrders, 'thana');
}

// ─── Chrome helper (titles, back button, breadcrumb) ────────────
function _rgnSetChrome({ title, sub, heading, backText, footerNote, breadcrumb }) {
  document.getElementById('rgn-chart-title').textContent  = title;
  document.getElementById('rgn-chart-sub').textContent    = sub;
  document.getElementById('rgn-list-heading').textContent = heading;
  document.getElementById('rgn-footer-note').textContent  = footerNote || '';

  // Back button
  const backBtn = document.getElementById('rgn-back-btn');
  if (backText) {
    backBtn.style.display   = 'flex';
    backBtn.textContent     = backText;
  } else {
    backBtn.style.display   = 'none';
  }

  // Breadcrumb
  const bc = document.getElementById('rgn-breadcrumb');
  if (!breadcrumb) {
    bc.style.display = 'none';
    return;
  }
  bc.style.display = 'flex';

  // Division segment — always clickable back to Level 1 when visible
  const bcDiv = document.getElementById('rgn-breadcrumb-div');
  bcDiv.textContent = breadcrumb.div || '';
  // If we're at Level 3, division is clickable back to Level 2
  if (breadcrumb.dist) {
    bcDiv.style.cursor = 'pointer';
    bcDiv.style.color  = 'var(--blue)';
    bcDiv.onclick      = () => rgnRenderDistrictView(breadcrumb.div);
  } else {
    // At Level 2 — division is current, not clickable
    bcDiv.style.cursor = 'default';
    bcDiv.style.color  = 'var(--text)';
    bcDiv.onclick      = null;
  }

  // District segment (Level 3 only)
  const sep2  = document.getElementById('rgn-breadcrumb-sep2');
  const bcDist = document.getElementById('rgn-breadcrumb-dist');
  const sep3  = document.getElementById('rgn-breadcrumb-sep3');
  const bcThana = document.getElementById('rgn-breadcrumb-thana');

  if (breadcrumb.dist) {
    sep2.style.display   = 'inline';
    bcDist.style.display = 'inline';
    bcDist.textContent   = breadcrumb.dist;
    bcDist.style.cursor  = 'default';
    bcDist.style.color   = 'var(--text)';
    bcDist.onclick       = null;
    // Thana segment (unused at Level 3 for now — leaf shows district as final)
    sep3.style.display   = 'none';
    bcThana.style.display = 'none';
  } else {
    sep2.style.display    = 'none';
    bcDist.style.display  = 'none';
    sep3.style.display    = 'none';
    bcThana.style.display = 'none';
  }
}

// ─── Shared list renderer ────────────────────────────────────────
// level: 'division' | 'district' | 'thana'
function rgnRenderList(items, maxVal, level) {
  const container = document.getElementById('rgn-rank-list');
  if (!items.length) {
    container.innerHTML = '<div style="color:var(--text3);font-size:12px;padding:12px 0;">কোনো ডেটা নেই</div>';
    return;
  }

  const isLeaf     = (level === 'thana');
  const isDivLevel = (level === 'division');

  container.innerHTML = items.map((item, i) => {
    const rankClass  = i === 0 ? 'r1' : i === 1 ? 'r2' : i === 2 ? 'r3' : 'rn';
    const pct        = maxVal > 0 ? Math.round((item.orders / maxVal) * 100) : 0;
    const color      = _rgn.PALETTE[i % _rgn.PALETTE.length];
    const drillHint  = isLeaf ? '' : '<span class="rri-drill-hint">›</span>';
    const revLabel   = item.revenue > 0
      ? `<span style="font-size:9px;color:var(--text3);display:block;margin-top:2px;">৳${Number(item.revenue).toLocaleString('en-BD')}</span>`
      : '';

    // Click handler depends on current level
    let clickAttr = '';
    if (!isLeaf) {
      const safeName = item.name.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
      if (isDivLevel) {
        clickAttr = `onclick="rgnDrillToDist('${safeName}')"`;
      } else {
        // district level → drill to thana
        clickAttr = `onclick="rgnDrillToThana('${safeName}')"`;
      }
    }

    return `
      <div class="region-rank-item" ${clickAttr} data-name="${item.name}">
        <div class="rri-rank ${rankClass}">${i + 1}</div>
        <div class="rri-name" style="display:flex;flex-direction:column;">
          <span>${item.name}${drillHint}</span>
          ${revLabel}
        </div>
        <div class="rri-bar-wrap">
          <div class="rri-bar-fill" style="width:${pct}%;background:${color};"></div>
        </div>
        <div class="rri-count">${item.orders}<span style="font-size:9px;font-weight:400;color:var(--text3);display:block;">orders</span></div>
      </div>`;
  }).join('');
}

// ─── Shared chart renderer ───────────────────────────────────────
// level: 'division' | 'district' | 'thana'
function rgnRenderChart(items, maxVal, level) {
  const wrap   = document.getElementById('rgn-bars-wrap');
  const isLeaf = (level === 'thana');
  const isDivLevel = (level === 'division');

  if (!items.length) {
    wrap.innerHTML = '<div class="rgn-chart-empty">কোনো ডেটা নেই</div>';
    return;
  }

  // Cap bars at 18 so the chart stays readable; horizontal scroll handles rest
  const display = items.slice(0, 18);

  wrap.innerHTML = display.map((item, i) => {
    const pct       = maxVal > 0 ? Math.max(4, Math.round((item.orders / maxVal) * 100)) : 4;
    const color     = _rgn.PALETTE[i % _rgn.PALETTE.length];
    const shortName = item.name.length > 13 ? item.name.slice(0, 12) + '…' : item.name;

    let clickAttr   = '';
    let cursorStyle = '';
    if (!isLeaf) {
      const safeName = item.name.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
      cursorStyle = 'cursor:pointer;';
      if (isDivLevel) {
        clickAttr = `onclick="rgnDrillToDist('${safeName}')"`;
      } else {
        clickAttr = `onclick="rgnDrillToThana('${safeName}')"`;
      }
    }

    return `
      <div class="rgn-bar-col" ${clickAttr} style="${cursorStyle}"
           title="${item.name}: ${item.orders} orders · ৳${Number(item.revenue).toLocaleString('en-BD')}">
        <div class="rgn-bar-inner" style="height:${pct}%;background:${color};">
          <span class="rgn-bar-val">${item.orders}</span>
        </div>
        <span class="rgn-bar-lbl">${shortName}</span>
      </div>`;
  }).join('');
}

// ─── Navigation actions ──────────────────────────────────────────

// From Division bars/list → into Districts
function rgnDrillToDist(divName) {
  if (!_rgn.divData[divName]) return;
  // Highlight selected row
  document.querySelectorAll('.region-rank-item').forEach(el =>
    el.classList.toggle('rri-selected', el.dataset.name === divName));
  rgnRenderDistrictView(divName);
  showToast('📍 ' + divName + ' — জেলা দেখাচ্ছে', 'info');
}

// From District bars/list → into Thanas
function rgnDrillToThana(distName) {
  if (!_rgn.currentDiv) return;
  document.querySelectorAll('.region-rank-item').forEach(el =>
    el.classList.toggle('rri-selected', el.dataset.name === distName));
  rgnRenderThanaView(_rgn.currentDiv, distName);
  showToast('🏘️ ' + distName + ' — থানা দেখাচ্ছে', 'info');
}

// Step-wise back: Thana→District→Division
function rgnDrillUp() {
  if (_rgn.currentDist !== null) {
    // At Level 3 → go back to Level 2 (districts of same div)
    rgnRenderDistrictView(_rgn.currentDiv);
  } else if (_rgn.currentDiv !== null) {
    // At Level 2 → go back to Level 1 (all divisions)
    rgnRenderDivisionView();
  }
  // At Level 1 → nothing to do (back button is hidden)
}

// Breadcrumb jump: level 0 = Divisions, 1 = Districts of currentDiv
function rgnGoToLevel(level) {
  if (level === 0) {
    rgnRenderDivisionView();
  } else if (level === 1 && _rgn.currentDiv) {
    rgnRenderDistrictView(_rgn.currentDiv);
  }
}


