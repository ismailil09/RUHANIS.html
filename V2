          <button class="copy-code-btn" onclick="copyBlock(this,'dropdown')">📋 Copy</button>
        </div>
        <pre id="dropdown"><span class="kw">function</span> <span class="fn">onEdit</span>(e) {
  <span class="kw">var</span> sheet = e.source.getActiveSheet();
  <span class="kw">var</span> col = e.range.getColumn();
  <span class="kw">var</span> row = e.range.getRow();
  <span class="kw">var</span> settings = e.source.getSheetByName(<span class="st">'Settings'</span>);

  <span class="cm">// When Division selected (col F = column 6), update District dropdown</span>
  <span class="kw">if</span> (sheet.getName() === <span class="st">'Sales_Tracker'</span> && col === 6 && row > 1) {
    <span class="kw">var</span> division = e.range.getValue();
    <span class="kw">var</span> districtCol = <span class="fn">getDistrictsByDivision</span>(settings, division);
    <span class="kw">var</span> rule = SpreadsheetApp.newDataValidation()
      .requireValueInList(districtCol).build();
    sheet.getRange(row, 7).setDataValidation(rule); <span class="cm">// col G = District</span>
    sheet.getRange(row, 7).clearContent();
    sheet.getRange(row, 8).clearContent(); <span class="cm">// clear Thana</span>
  }

  <span class="cm">// When District selected (col G = 7), update Thana dropdown</span>
  <span class="kw">if</span> (sheet.getName() === <span class="st">'Sales_Tracker'</span> && col === 7 && row > 1) {
    <span class="kw">var</span> district = e.range.getValue();
    <span class="kw">var</span> thanaList = <span class="fn">getThanasByDistrict</span>(settings, district);
    <span class="kw">var</span> rule = SpreadsheetApp.newDataValidation()
      .requireValueInList(thanaList).build();
    sheet.getRange(row, 8).setDataValidation(rule); <span class="cm">// col H = Thana</span>
    sheet.getRange(row, 8).clearContent();
  }
}

<span class="kw">function</span> <span class="fn">getDistrictsByDivision</span>(settings, division) {
  <span class="cm">// Settings Sheet-এ Division-District mapping table থাকবে</span>
  <span class="kw">var</span> data = settings.getRange(<span class="st">'A:B'</span>).getValues();
  <span class="kw">var</span> districts = [];
  data.forEach(<span class="kw">function</span>(row) {
    <span class="kw">if</span> (row[0] === division && row[1]) districts.push(row[1]);
  });
  <span class="kw">return</span> districts;
}</pre>
      </div>
    </div>

