            try{
              const [hh,mm]=rawTime.split(':');
              const h=parseInt(hh,10), m=parseInt(mm,10);
              const ampm=h>=12?'PM':'AM';
              const h12=h%12||12;
              timeStr=`${String(h12).padStart(2,'0')}:${String(m).padStart(2,'0')} ${ampm}`;
            } catch(te){ timeStr=rawTime; }
          } else { timeStr=''; }
        }
      } catch(e){ dateStr=String(rawDT); timeStr=rawTime; }
    } else { dateStr=''; timeStr=rawTime; }
    return {
      id:String(r[0]||String(i+1).padStart(3,'0')), date:dateStr, time:timeStr,
      rawDate:rawDT, rawDateISO:String(rawDT||''),
      customer:String(r[3]||''), phone:_fixPhone(r[4]),
