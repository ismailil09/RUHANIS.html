// ── Partner Export ────────────────────────────────────────────
async function exportPartnerDataToCSV(){
  const data = window.livePartnerData || livePartnerData || [];
  if(!data.length){ showToast('কোনো Partner data নেই — আগে load করুন','error'); return; }
  const pk = await igxPickPeriod({title:'Partner Transactions', rows:data, getDate:r=>r.date}); if(!pk) return;

  // renderPartnerTxns-এর মতো same running balance calculate করো
  const chronoRows = [...data].reverse();
  const runMap = {};
  const runningTotals = {};
  chronoRows.forEach(t=>{
    const k = t.partner;
    if(!runMap[k]) runMap[k] = 0;
    if(t.type==='Investment') runMap[k] += Number(t.amount||0);   // Profit Share ব্যালেন্সে যোগ হয় না
    else if(t.type==='Drawings') runMap[k] -= Number(t.amount||0);
    runningTotals[t.id] = runMap[k];
  });

  const header = ['#','Date','Partner','Type','Amount','Payment Method','Description','Balance After'];
  const rows = [header, ...pk.rows.map(r=>[
    r.id, r.date, r.partner, r.type, r.amount, r.method, r.desc||'',
    runningTotals[r.id] ?? r.balanceAfter ?? 0
  ])];
  _downloadCSV(rows,'partners-data'+(pk.slug?'_'+pk.slug:''));
  showToast(`📥 ${pk.rows.length}টি Transaction export হয়েছে (${pk.label})`,'success');
}

// ── CRM/Customer Export ───────────────────────────────────────
function exportCRMDataToCSV(){
  const data = window.liveSalesData || liveSalesData || [];
  if(!data.length){ showToast('কোনো Customer data নেই — আগে load করুন','error'); return; }
  // Unique customers from sales data
  const custMap = {};
  data.forEach(r=>{
    const k = r.phone||r.customer;
    if(!custMap[k]) custMap[k] = {name:r.customer,phone:r.phone,orders:0,total:0,due:0,lastDate:r.date};
    custMap[k].orders++;
    custMap[k].total += Number(r.total||0);
    custMap[k].due   += Number(r.due||0);
    custMap[k].lastDate = r.date;
  });
  const custs = Object.values(custMap);
  const header = ['Customer Name','Phone','Total Orders','Total Revenue','Due Amount','Last Order Date'];
  const rows = [header, ...custs.map(c=>[c.name,c.phone,c.orders,c.total,c.due,c.lastDate])];
