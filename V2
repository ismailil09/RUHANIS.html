function renderPartnerTxns(rows){
  // FIX 6: Calculate running total per partner (Investment adds, Drawings subtracts)
  const runningTotals = {};
  // Process rows in chronological order (oldest first = reversed from display order)
  const chronoRows = [...rows].reverse();
  const runMap = {};
  chronoRows.forEach(t=>{
    const k = t.partner;
    if(!runMap[k]) runMap[k] = 0;
    if(t.type==='Investment') runMap[k] += Number(t.amount||0);   // Profit Share ব্যালেন্সে যোগ হয় না
    else if(t.type==='Drawings') runMap[k] -= Number(t.amount||0);
    runningTotals[t.id] = runMap[k];
  });
  document.getElementById('partner-body').innerHTML = rows.map(t=>{
    const runTotal = runningTotals[t.id]||0;
    const runColor = runTotal>=0?'var(--green)':'var(--red)';
    return `<tr>
      <td class="mono muted">${t.id}</td>
      <td class="mono">${t.date}</td>
      <td><strong>${t.partner}</strong></td>
      <td><span class="status ${t.type==='Investment'?'delivered':t.type==='Drawings'?'cancelled':'pending'}">${t.type}</span></td>
      <td class="mono" style="font-weight:700;color:${t.type==='Investment'?'var(--green)':'var(--red)'};">৳${Number(t.amount||0).toLocaleString()}</td>
      <td><span class="pay-badge ${(t.method||'').toLowerCase().replace(/ /g,'')}">${t.method||'—'}</span></td>
      <td class="muted exp-dcell">${ptxClamp(t)}</td>
      <td class="mono" style="color:${runColor};font-weight:700;">৳${Math.abs(runTotal).toLocaleString()}${runTotal<0?' ↓':''}${t.type==='Profit Share'?'<div style="font-size:9.5px;font-weight:400;color:var(--text3);margin-top:2px;">লাভ — ব্যালেন্সে যোগ হয়নি</div>':''}</td>
      <td>
        <button class="btn" style="padding:4px 10px;font-size:11px;" onclick='openEditPartnerTxn(${JSON.stringify(t)})'>✏️ Edit</button>
        <button class="btn" style="padding:4px 8px;font-size:11px;background:var(--red);color:#fff;border-color:var(--red);" onclick='deletePartnerTxn(${JSON.stringify({id:t.id,partner:t.partner})})'>🗑️</button>
      </td>
    </tr>`;
  }).join('');
}

