  function analyze(kind, text) {
    const K = KINDS[kind], all = parseCSV(text);
    if (all.length < 2) return { error: 'CSV-এ কোনো ডেটা নেই' };
    const hd = all[0].map(h => norm(bn2en(String(h)).replace(/\(.*?\)|৳/g, '')));
    const col = {}, used = new Set();
    // প্রতিটি কলাম একটি ফিল্ডই পাবে: আগে হুবহু মিল, তারপর "ধারণ করে"
    [true, false].forEach(exact => K.order.forEach(f => {
      if (col[f] != null) return;
      const i = hd.findIndex((h, ix) => h && h !== 'id' && !used.has(ix) && K.hdr[f].some(v => exact ? h === norm(v) : h.includes(norm(v))));
      if (i >= 0) { col[f] = i; used.add(i); }
    }));
    if (col[K.required] == null) return { error: `Header পাওয়া যায়নি — প্রথম লাইনে "${KINDS[kind].cols.find(c => c[0] === K.required)[1]}" কলাম থাকতে হবে` };
    const rows = [];
    all.slice(1).forEach((r, i) => {
      const raw = {}; Object.keys(col).forEach(f => { raw[f] = String(r[col[f]] == null ? '' : r[col[f]]).trim(); });
      const { e, bad, warn } = K.norm(raw);
      K.dateKeys.forEach(dk => { const v = raw[dk]; if (v) { const iso = parseDateAny(v); if (!iso) warn.push(`তারিখ "${v.slice(0, 15)}" বোঝা যায়নি → ফাঁকা থাকবে`); e[dk] = iso || ''; } else e[dk] = ''; });
      Object.keys(e).forEach(f => { if (typeof e[f] === 'string') e[f] = e[f].replace(/^'(?=[=+\-@])/, ''); });
      rows.push({ line: i + 2, e, bad, warn: warn.join(' · ') });
    });
    return { rows };
  }

