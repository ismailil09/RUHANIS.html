  // Column map UI
  const mapWrap = document.getElementById('imp-col-map');
  const requiredFields = ['customer','phone','product','qty','price'];
  const missingRequired = requiredFields.filter(f=>impColMap[f]===undefined);

  mapWrap.innerHTML = Object.entries(IMP_FIELDS).map(([field, variants])=>{
