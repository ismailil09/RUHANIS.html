// Format ISO / serial date to Bangladesh readable: DD-MMM-YYYY HH:MM AM/PM
function formatBDDate(rawDT){
  if(!rawDT) return '';
  try {
    let dt;
    if(typeof rawDT === 'number'){
      // Google Sheets serial date (days since Dec 30 1899)
      dt = new Date((rawDT - 25569) * 86400 * 1000);
    } else {
      dt = new Date(rawDT);
    }
    if(isNaN(dt.getTime())) return String(rawDT);
    const opts = {timeZone:'Asia/Dhaka'};
    const day   = new Intl.DateTimeFormat('en-GB',{...opts,day:'2-digit'}).format(dt);
    const month = new Intl.DateTimeFormat('en-GB',{...opts,month:'short'}).format(dt);
    const year  = new Intl.DateTimeFormat('en-GB',{...opts,year:'numeric'}).format(dt);
    const time  = new Intl.DateTimeFormat('en-GB',{...opts,hour:'2-digit',minute:'2-digit',hour12:true}).format(dt);
    return `${day}-${month}-${year} ${time}`;
  } catch(e){ return String(rawDT); }
}
